# Maintainer: kcooperlawson
# DecKoOS Terminal, the DecKoOS terminal. Built from ../../apps/deckos-terminal in this repo.
pkgname=deckos-terminal
pkgver=$(tr -d '[:space:]' < "$startdir/../../VERSION" 2>/dev/null)
pkgver=${pkgver:-0.3.17}
pkgrel=1
pkgdesc="DecKoOS Terminal: the DecKoOS terminal, with project-aware tabs and splits (Qt 6, qtermwidget)"
arch=(x86_64)
license=(MIT)
depends=(qt6-base qt6-svg qtermwidget kconfig kcoreaddons kdbusaddons ttf-jetbrains-mono-nerd)
makedepends=(cmake extra-cmake-modules)

build() {
  cmake -S "$startdir/../../apps/deckos-terminal" -B build -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release -DDECKOS_VERSION="$pkgver"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
