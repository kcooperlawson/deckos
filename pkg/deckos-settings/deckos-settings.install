_setup() {
  /usr/lib/deckos/brand-os-release
  plymouth-set-default-theme deckos >/dev/null 2>&1 || true
  systemctl enable deckos-display.service deckos-gpu.service >/dev/null 2>&1 || true
  # Workload modes, for every user from their next login (`deckos mode off` turns it off for one)
  systemctl --global enable deckos-modes.service >/dev/null 2>&1 || true
  # Game Doctor's watcher: offers help when a game closes right after starting
  systemctl --global enable deckos-gamedoctor.service >/dev/null 2>&1 || true
  # DecKoOS Care: System Doctor's checks after a crash or an update, said once in a while
  systemctl --global enable deckos-care.service >/dev/null 2>&1 || true
  # Kid mode's time limits (does nothing until a child is set up: ConditionPathExistsGlob)
  systemctl enable deckos-kids-time.service >/dev/null 2>&1 || true
  # The gaming CPU scheduler (scx_lavd, Gaming mode), once: after that it's the Hub's switch.
  if [ ! -e /var/lib/deckos/scheduler-default ] && [ -e /usr/lib/systemd/system/scx_loader.service ]; then
    [ -e /etc/scx_loader.toml ] || printf '# DecKoOS default (DecKoOS Hub > Gaming > Performance)\ndefault_sched = "scx_lavd"\ndefault_mode = "Gaming"\n' \
      > /etc/scx_loader.toml
    systemctl enable scx_loader.service >/dev/null 2>&1 || true
    mkdir -p /var/lib/deckos && touch /var/lib/deckos/scheduler-default
  fi
  # DecKoOS updates: trust the DecKoOS signing key and add the [deckos] repo (the live USB already
  # has its own [deckos] section, pointing at the packages on the stick, and keeps it).
  pacman-key --populate deckos >/dev/null 2>&1 \
    || echo "DecKoOS: run 'sudo pacman-key --populate deckos' so DecKoOS updates are trusted"
  # Snapshot first in every interactive bash (bash.bashrc has no drop-in folder)
  if [ -f /etc/bash.bashrc ] && ! grep -q 'deckos/shell/snapshot-first.bash' /etc/bash.bashrc; then
    printf '\n# DecKoOS: offer a snapshot before big deletes (deckos snapshot-first off)\n[[ -r /usr/share/deckos/shell/snapshot-first.bash ]] && . /usr/share/deckos/shell/snapshot-first.bash\n' \
      >> /etc/bash.bashrc
  fi
  if ! grep -q '^\[deckos\]' /etc/pacman.conf; then
    printf '\n# DecKoOS updates (the Hub, deckos tool, themes): see /etc/pacman.d/deckos-repo\n[deckos]\nInclude = /etc/pacman.d/deckos-repo\n' \
      >> /etc/pacman.conf
  fi
}

post_install() {
  _setup
  # Remember the boot splash, so the upgrade hook (deckos-plymouth.hook) only rebuilds the boot
  # images when the splash really changes; the installer and the ISO build make the first ones.
  /usr/lib/deckos/plymouth-refresh --record
}

post_upgrade() {
  _setup  # not --record: the hook compares against the splash from before this upgrade
  # 0.15.1: the repo file is kept on upgrades (backup=), so its old SigLevel stays; a required database signature
  # made every update check run as the user fail (it can't read pacman's keyring). Packages stay required.
  if grep -q '^SigLevel = Required$' /etc/pacman.d/deckos-repo 2>/dev/null; then
    sed -i 's/^SigLevel = Required$/SigLevel = PackageRequired DatabaseOptional/' /etc/pacman.d/deckos-repo
  fi
  # 0.9.0 renamed DeckOS to DecKoOS: the boot menu's entries carry the old name until GRUB's config
  # is rewritten. Only the name the installer wrote is changed; the EFI folder (bootloader id) stays.
  if grep -q '^GRUB_DISTRIBUTOR="DeckOS"$' /etc/default/grub 2>/dev/null; then
    sed -i 's/^GRUB_DISTRIBUTOR="DeckOS"$/GRUB_DISTRIBUTOR="DecKoOS"/' /etc/default/grub
    grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 \
      || echo "DecKoOS: couldn't rewrite the boot menu; run 'sudo grub-mkconfig -o /boot/grub/grub.cfg'"
  fi
}
