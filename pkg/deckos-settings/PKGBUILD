# Maintainer: kcooperlawson
# Local package: everything it installs lives next to this file (rootfs/, kdeglobals.base).
pkgname=deckos-settings
# The DeckOS release (VERSION at the top of the repo), so a release is one number to bump.
pkgver=$(tr -d '[:space:]' < "$startdir/../../VERSION" 2>/dev/null)
pkgver=${pkgver:-0.3.1}
pkgrel=1
pkgdesc="DeckOS branding, theme, Hub, hardware fixes and the deckos tool"
arch=(any)
license=(MIT)
depends=(bash python pyside6 qt6-svg qt6-declarative jq util-linux sudo polkit kdialog konsole
         grub plymouth snapper btrfs-progs ntfs-3g pacman-contrib playerctl
         papirus-icon-theme inter-font ttf-jetbrains-mono-nerd deckos-files)
makedepends=(librsvg grub papirus-icon-theme)
optdepends=('gamescope-session-steam-git: Steam Gaming Mode session'
            'lact: GPU clock/fan control GUI')
backup=(etc/deckos/display.conf
        etc/deckos/gaming.conf
        etc/pacman.d/deckos-repo
        etc/udisks2/mount_options.conf
        etc/systemd/zram-generator.conf)
install=deckos-settings.install

package() {
  local src=$startdir
  cp -a "$src/rootfs/." "$pkgdir/"
  find "$pkgdir" -type d -exec chmod 755 {} +
  find "$pkgdir" -type f -exec chmod 644 {} +
  chmod 755 "$pkgdir"/usr/bin/deckos "$pkgdir"/usr/bin/deckos-hub "$pkgdir"/usr/bin/deckos-store \
            "$pkgdir"/usr/bin/deckos-welcome \
            "$pkgdir"/usr/lib/deckos/{session-switch,gaming-session,brand-os-release,plymouth-refresh} \
            "$pkgdir"/usr/lib/os-session-select
  chmod 750 "$pkgdir/etc/sudoers.d"
  chmod 440 "$pkgdir/etc/sudoers.d/deckos"

  local b=$pkgdir/usr/share/deckos/branding
  local fonts=$pkgdir/usr/share/fonts/deckos

  # The DeckOS release (VERSION at the top of the repo): os-release, the Hub, deckos doctor.
  tr -d '[:space:]' < "$src/../../VERSION" > "$pkgdir/usr/share/deckos/version" 2>/dev/null \
    || echo rolling > "$pkgdir/usr/share/deckos/version"

  # Wallpapers (desktop + login screen).
  local wp=$pkgdir/usr/share/wallpapers/DeckOS/contents/images
  install -d "$wp"
  for size in 3840x2160 2560x1440 1920x1080; do
    rsvg-convert -w "${size%x*}" -h "${size#*x}" "$b/wallpaper.svg" -o "$wp/$size.png"
  done
  rsvg-convert -w 960 -h 540 "$b/wallpaper.svg" -o "$pkgdir/usr/share/wallpapers/DeckOS/contents/screenshot.png"
  rsvg-convert -w 1920 -h 1080 "$b/wallpaper.svg" -o "$b/wallpaper-1920.png"

  # DeckOS icon theme: Papirus-Dark, with every places icon that uses Papirus' folder blue
  # (folders, home, desktop...) recoloured to the DeckOS blue, a violet-leaning back tab and
  # navy symbols. Everything else is inherited from Papirus-Dark.
  local it=$pkgdir/usr/share/icons/DeckOS dirs=() d f real sz
  for d in /usr/share/icons/Papirus-Dark/*/places; do
    sz=$(basename "$(dirname "$d")")
    [[ -d $d && $sz =~ ^[0-9]+x[0-9]+(@2x)?$ ]] || continue  # sized folders only, not symbolic/
    install -d "$it/$sz/places"
    for f in "$d"/*.svg; do
      real=$(readlink -f "$f")
      grep -qi '#5294e2' "$real" || continue
      sed 's/#5294e2/#4c8dff/gI; s/#4877b1/#4a5fe0/gI; s/#1d344f/#16234d/gI' "$real" > "$it/$sz/places/${f##*/}"
    done
    if compgen -G "$it/$sz/places/*.svg" >/dev/null; then dirs+=("$sz/places"); else rmdir "$it/$sz/places" "$it/$sz"; fi
  done
  [[ ${#dirs[@]} -gt 0 ]] || { echo "papirus-icon-theme is needed to build the DeckOS icons" >&2; return 1; }
  {
    printf '[Icon Theme]\nName=DeckOS\nComment=Papirus Dark with folders in the DeckOS blue\n'
    printf 'Inherits=Papirus-Dark,breeze-dark,hicolor\nDirectories=%s\n' "$(IFS=,; echo "${dirs[*]}")"
    for d in "${dirs[@]}"; do
      sz=${d%%/*}
      printf '\n[%s]\nContext=Places\nSize=%s\nScale=%s\nType=Fixed\n' "$d" "${sz%%x*}" "$([[ $sz == *@2x ]] && echo 2 || echo 1)"
    done
  } > "$it/index.theme"

  # App icon (controller tile): Kickoff button, Hub, os-release LOGO, fastfetch.
  install -Dm644 "$b/logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/deckos.svg"
  for s in 16 24 32 48 64 128 256; do
    install -d "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps"
    rsvg-convert -w "$s" -h "$s" "$b/logo.svg" -o "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/deckos.png"
  done
  rsvg-convert -w 256 -h 256 "$b/logo.svg" -o "$b/logo-256.png"
  install -Dm644 "$b/logo.svg" "$pkgdir/usr/share/pixmaps/deckos.svg"

  # DeckOS Store app icon.
  install -Dm644 "$b/store-logo.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/deckos-store.svg"
  for s in 16 24 32 48 64 128 256; do
    rsvg-convert -w "$s" -h "$s" "$b/store-logo.svg" -o "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/deckos-store.png"
  done

  # Boot splash: wordmark without its O + the thumbstick O, same scale, spun by the script.
  local ply=$pkgdir/usr/share/plymouth/themes/deckos
  rsvg-convert -z 0.75 "$b/wordmark-bare.svg" -o "$ply/wordmark-bare.png"
  rsvg-convert -z 0.75 "$b/stick.svg" -o "$ply/stick.png"

  # Installer art (used by the live USB's Calamares branding).
  rsvg-convert -w 900 "$b/installer-welcome.svg" -o "$b/installer-welcome.png"
  rsvg-convert -w 520 "$b/wordmark.svg" -o "$b/wordmark-520.png"
  for c in desktop gaming display; do
    rsvg-convert -w 640 -h 360 "$b/choice-$c.svg" -o "$b/choice-$c.png"
  done

  # GRUB theme: background, rounded highlight (9-slice), Inter Display fonts.
  local gt=$pkgdir/usr/share/grub/themes/deckos
  rsvg-convert -w 1920 -h 1080 "$b/grub-background.svg" -o "$gt/background.png"
  local piece
  for piece in "$b"/grub/select_*.svg; do
    rsvg-convert "$piece" -o "$gt/$(basename "${piece%.svg}").png"
  done
  for s in 16 22; do
    grub-mkfont -n "DeckOS Sans" -s "$s" -o "$gt/deckos-sans-$s.pf2" "$fonts/InterDisplay-Medium.otf"
  done
  grub-mkfont -n "DeckOS Sans Strong" -s 22 -o "$gt/deckos-sans-strong-22.pf2" "$fonts/InterDisplay-SemiBold.otf"

  # System-wide KDE defaults = base settings + the DeckOS color groups.
  {
    cat "$src/kdeglobals.base"
    echo
    grep -v '^Name=' "$src/rootfs/usr/share/color-schemes/DeckOS.colors"
  } > "$pkgdir/etc/xdg/kdeglobals"
  chmod 644 "$pkgdir/etc/xdg/kdeglobals"
}
