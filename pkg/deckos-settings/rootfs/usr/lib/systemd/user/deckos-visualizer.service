[Unit]
Description=DecKoOS Vibes: the music visualizer's audio (only listens while the Vibe wallpaper shows it)
After=pipewire-pulse.service graphical-session.target

[Service]
ExecStart=/usr/bin/python3 /usr/lib/deckos/vibes/visualizer.py serve
Restart=on-failure
RestartSec=3
Nice=10

[Install]
WantedBy=default.target
