#!/usr/bin/env bash
# Root helper (sudo, no password for wheel) that switches between Gaming Mode and Desktop
# SteamOS-style: arm a one-shot SDDM autologin into the target session, then restart SDDM.
# The next session clears the autologin again (--clear), so normal boots still ask for a password.
set -euo pipefail

CONF=/etc/sddm.conf.d/zz-deckos-session.conf
delay=1

case ${1:-} in
  --clear) rm -f "$CONF"; exit 0 ;;
  gaming) session=deckos-gaming.desktop ;;
  desktop) session=plasma.desktop ;;
  *) echo "usage: session-switch gaming|desktop [--delay N] | --clear" >&2; exit 2 ;;
esac
if [[ ${2:-} == --delay && ${3:-} =~ ^[0-9]{1,2}$ ]]; then delay=$3; fi

user=${SUDO_USER:-}
[[ -n $user && $user != root ]] || { echo "run via sudo from your user account" >&2; exit 1; }
id -nG "$user" | tr ' ' '\n' | grep -qx wheel || { echo "$user is not in wheel" >&2; exit 1; }

# A switch already on its way: a second click must not restart SDDM again, which would kill the
# session the first one just started.
if systemctl is-active --quiet deckos-session-switch.timer deckos-session-switch.service; then
  echo "Already switching." >&2
  exit 0
fi

mkdir -p /etc/sddm.conf.d
printf '# One-shot session switch written by DeckOS; removed on next login.\n[Autologin]\nUser=%s\nSession=%s\nRelogin=false\n' \
  "$user" "$session" > "$CONF"
# AccuracySec: timers default to 1 minute of slack, so "in 1 s" could take up to a minute, and people
# click again. A fixed unit name makes a second schedule fail instead of stacking a second restart.
systemd-run --quiet --collect --unit=deckos-session-switch --on-active="${delay}s" \
  --timer-property=AccuracySec=100ms /usr/bin/systemctl restart sddm.service
