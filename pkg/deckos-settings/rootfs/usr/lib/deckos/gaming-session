#!/usr/bin/env bash
# SDDM entry point. Keep the user manager clean when Gaming Mode exits or fails.
set -Eeuo pipefail

check() {
  local command missing=0
  for command in steam gamescope gamescope-session-plus steamos-session-select; do
    if ! command -v "$command" >/dev/null; then
      echo "Gaming Mode needs $command." >&2
      missing=1
    fi
  done
  if [[ ! -r /usr/share/gamescope-session-plus/sessions.d/steam ]]; then
    echo "Gaming Mode needs the Steam session profile (gamescope-session-steam-git)." >&2
    missing=1
  fi
  if (( missing )); then
    echo "Install the missing Gaming Mode components before switching sessions." >&2
    return 1
  fi
}

if [[ ${1:-} == --check ]]; then check; exit; fi
# This launcher takes over a login session; running it inside Plasma would stop that desktop.
if [[ ${DESKTOP_SESSION:-} != deckos-gaming && ${XDG_CURRENT_DESKTOP:-} != gamescope ]]; then
  echo "Start Gaming Mode from the login screen or deckos session gaming." >&2
  exit 2
fi

sudo -n /usr/lib/deckos/session-switch --clear 2>/dev/null || true
check

state=${XDG_STATE_HOME:-$HOME/.local/state}/deckos
mkdir -p "$state"
log=$state/gaming-session.log
# Keep the previous attempt without unbounded log growth.
[[ ! -f $log ]] || mv -f "$log" "$log.previous"
exec >>"$log" 2>&1
printf '\nDeckOS Gaming Mode: %s\n' "$(date --iso-8601=seconds)"
started=$(date '+%Y-%m-%d %H:%M:%S')

# Steam's startup movie carries on the logo the desktop's cover showed. A movie the user chose
# (a real file there) stays; only a missing one or our own link is (re)made.
movie=/usr/share/deckos/branding/deckos-startup.webm
movies=${XDG_DATA_HOME:-$HOME/.local/share}/Steam/config/uioverrides/movies
if [[ -r $movie && ( ! -e $movies/deck_startup.webm || -L $movies/deck_startup.webm ) ]]; then
  mkdir -p "$movies" && ln -sfn "$movie" "$movies/deck_startup.webm" ||
    echo "Could not set the DeckOS startup movie." >&2
fi

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  # The framework backgrounds Steam/gamescope in a user unit; logging out of SDDM alone
  # does not stop those processes or the graphical-session target in the persistent manager.
  systemctl --user stop gamescope-session-plus@steam.service || true
  systemctl --user stop graphical-session.target || true
  systemctl --user unset-environment DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_DESKTOP_PORTAL_DIR \
    GAMESCOPE_WAYLAND_DISPLAY GAMESCOPE_STATS || true
  systemctl --user reset-failed gamescope-session-plus@steam.service || true
  journalctl --user -u gamescope-session-plus@steam.service --since "$started" -n 100 --no-pager || true
  printf 'Gaming Mode ended (status %s). Session resources cleared.\n' "$status"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Do not exec: the EXIT trap must run after both a normal exit and a startup failure.
gamescope-session-plus steam &
wait "$!"
