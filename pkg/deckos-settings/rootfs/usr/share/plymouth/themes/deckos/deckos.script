// DecKoOS boot splash: the wordmark, its oO a pair of eyes that glance left, then right, then blink
// while the system boots. The pupils are separate images placed on the eye centres inside
// wordmark.svg, from assets/generate.py: o (625.5, 117.4), O (766.3, 97.0) in a 1008-wide image.
// The timing matches Splash.qml and assets/boot_movie.py.

Window.SetBackgroundTopColor(0.059, 0.067, 0.082);
Window.SetBackgroundBottomColor(0.043, 0.051, 0.067);

word.image = Image("wordmark-bare.png");
eye[0].image = Image("eye-stick.png");
eye[1].image = Image("eye-buttons.png");

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
scale = word.image.GetWidth() / 1008;

word.x = screen_w / 2 - word.image.GetWidth() / 2;
word.y = screen_h / 2 - word.image.GetHeight() / 2;
word.sprite = Sprite(word.image);
word.sprite.SetPosition(word.x, word.y, 1);

eye[0].cx = word.x + 625.5 * scale;
eye[0].cy = word.y + 117.4 * scale;
eye[1].cx = word.x + 766.3 * scale;
eye[1].cy = word.y + 97.0 * scale;
for (i = 0; i < 2; i++) {
    eye[i].sprite = Sprite(eye[i].image);
    eye[i].w = eye[i].image.GetWidth();
    eye[i].h = eye[i].image.GetHeight();
}

fun ease(a, b, x) {
    k = Math.Min(1, Math.Max(0, (x - a) / (b - a)));
    return k * k * (3 - 2 * k);
}

t = 0;
fun refresh_callback() {
    t = t + 0.02;  // Plymouth redraws about 50 times a second
    if (t >= 4) t = t - 4;
    look = 0 - ease(0.6, 0.9, t) + 2 * ease(1.5, 1.9, t) - ease(2.5, 2.8, t);
    lid = 1 - 0.92 * (ease(3.2, 3.32, t) - ease(3.32, 3.44, t));
    for (i = 0; i < 2; i++) {
        h = Math.Max(1, Math.Int(eye[i].h * lid));
        if (h < eye[i].h) eye[i].sprite.SetImage(eye[i].image.Scale(eye[i].w, h));
        else eye[i].sprite.SetImage(eye[i].image);
        eye[i].sprite.SetPosition(eye[i].cx + 5 * look * scale - eye[i].w / 2,
                                  eye[i].cy + 2 * Math.Abs(look) * scale - h / 2, 2);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// Status text (fsck, updates) under the wordmark.
msg.sprite = Sprite();
fun message_callback(text) {
    msg.image = Image.Text(text, 0.55, 0.58, 0.65, 1, "Inter Display 12");
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetPosition(screen_w / 2 - msg.image.GetWidth() / 2, word.y + word.image.GetHeight() + 40, 3);
}
Plymouth.SetMessageFunction(message_callback);
