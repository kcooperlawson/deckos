// DecKoOS: administrators (wheel) at the desktop can read the firewall's settings without a password,
// so DecKoOS Hub can show what's open. Arch's firewalld uses the server policy, where even reading the
// zone asks for one, every time. Changing anything still asks.
polkit.addRule(function (action, subject) {
  if ((action.id == "org.fedoraproject.FirewallD1.config.info" ||
       action.id == "org.fedoraproject.FirewallD1.policies.info" ||
       action.id == "org.fedoraproject.FirewallD1.direct.info") &&
      subject.local && subject.active && subject.isInGroup("wheel")) {
    return polkit.Result.YES;
  }
});
