#!/usr/bin/env bash
# deckos — DecKoOS system tool: display flicker fixes, NTFS drives, session switching, updates.
set -euo pipefail

VERSION=$(cat /usr/share/deckos/version 2>/dev/null || echo rolling)
# systemd services (the CI install test) start without HOME; set -u would stop at the first $HOME below.
HOME=${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}
CONF_DIR=/etc/deckos
DISPLAY_CONF=$CONF_DIR/display.conf
GRUB_DEFAULT=/etc/default/grub
FSTAB_BEGIN="# >>> DeckOS drives (managed by 'deckos drives rescan') >>>"
FSTAB_END="# <<< DeckOS drives <<<"
PREFIX_BEGIN="# >>> DecKoOS Proton prefixes (managed by 'deckos drives prefixes') >>>"
PREFIX_END="# <<< DecKoOS Proton prefixes <<<"
# RX 9070 / 9070 XT (Navi 48). Anything else falls back to the boot VGA AMD card.
DGPU_IDS="0x7550"

if [[ -t 1 ]]; then
  C_ACC=$'\e[38;2;76;141;255m' C_OK=$'\e[38;2;61;214;140m' C_WARN=$'\e[38;2;245;184;75m'
  C_ERR=$'\e[38;2;255;107;107m' C_SUB=$'\e[38;2;140;148;166m' C_B=$'\e[1m' C_0=$'\e[0m'
else
  C_ACC='' C_OK='' C_WARN='' C_ERR='' C_SUB='' C_B='' C_0=''
fi
say()  { printf '%s\n' "$*"; }
section() { printf '\n%s%s// %s%s\n' "$C_ACC" "$C_B" "$*" "$C_0"; }
ok()   { printf '  %s✔%s %s\n' "$C_OK" "$C_0" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$C_0" "$*"; }
err()  { printf '%serror:%s %s\n' "$C_ERR" "$C_0" "$*" >&2; }
sub()  { printf '  %s%s%s\n' "$C_SUB" "$*" "$C_0"; }
# DecKoOS Pulse: a line in the timeline (best effort: a timeline problem never stops the command itself)
pulse() { python3 "${DECKOS_PULSE_DIR:-/usr/lib/deckos/pulse}/pulse.py" emit "$@" >/dev/null 2>&1 || true; }

need_root() { [[ $EUID -eq 0 ]] || { err "this needs root: sudo deckos $*"; exit 1; }; }

# ---------------------------------------------------------------- GPU helpers

# Graphics vendors in this PC, one per line (amd, nvidia, intel), from PCI display devices so it
# works before any driver is loaded. The installer and the package lists' vendor column use it.
gpu_vendors() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [[ $(cat "$d/class" 2>/dev/null) == 0x03* ]] || continue
    case $(cat "$d/vendor" 2>/dev/null) in
      0x1002) echo amd ;; 0x10de) echo nvidia ;; 0x8086) echo intel ;;
    esac
  done | sort -u
}

# Prints the /sys/class/drm/cardN path of the AMD gaming GPU. The display ladder and deckos gpu are
# amdgpu-only; on other cards they say so and do nothing.
dgpu_card() {
  local c fallback=""
  for c in /sys/class/drm/card[0-9]*; do
    [[ $c =~ card[0-9]+$ ]] || continue
    [[ $(cat "$c/device/vendor" 2>/dev/null) == 0x1002 ]] || continue
    local dev; dev=$(cat "$c/device/device" 2>/dev/null)
    [[ " $DGPU_IDS " == *" $dev "* ]] && { echo "$c"; return 0; }
    [[ $(cat "$c/device/boot_vga" 2>/dev/null) == 1 ]] && fallback=$c
  done
  [[ -n $fallback ]] && { echo "$fallback"; return 0; }
  return 1
}

# Monitor name from an EDID blob (descriptor tag 0xFC).
edid_name() {
  python3 - "$1" <<'PY' 2>/dev/null
import sys
e = open(sys.argv[1], "rb").read()
for off in (54, 72, 90, 108):
    b = e[off:off + 18]
    if len(b) == 18 and b[:3] == b"\0\0\0" and b[3] == 0xFC:
        print(b[5:].split(b"\n")[0].decode("ascii", "replace").strip()); break
PY
}

# The card driving the screens: the AMD gaming GPU, else the boot display card.
display_card() {
  dgpu_card && return 0
  local c
  for c in /sys/class/drm/card[0-9]*; do
    [[ $c =~ card[0-9]+$ && $(cat "$c/device/boot_vga" 2>/dev/null) == 1 ]] && { echo "$c"; return 0; }
  done
  return 1
}

# "CONNECTOR<TAB>MONITOR" for every connected output on the main card.
monitors() {
  local card; card=$(display_card) || return 0
  local base; base=$(basename "$card")
  local o
  for o in /sys/class/drm/"$base"-*; do
    [[ $(cat "$o/status" 2>/dev/null) == connected ]] || continue
    printf '%s\t%s\n' "${o##*/$base-}" "$(edid_name "$o/edid")"
  done
}

# ------------------------------------------------------------- display ladder
#
# The G70B blacks out for a second or two when the 9070 XT changes its memory clock
# while driving a high-bandwidth 4K144 signal plus a second screen. Each level removes
# another source of those clock/power-state changes, at the cost of some idle power.

LEVEL_DESC=(
  "0  stock          — AMD defaults, no workarounds"
  "1  no-FAMS        — disable SubVP + firmware-assisted memory-clock switching"
  "2  pinned-mclk    — level 1 + lock VRAM clock to max at boot (~+15–30 W idle)"
  "3  no-mclk-switch — level 2 + no multi-monitor clock switching, no PSR/Panel Replay"
  "4  locked-high    — level 3 + force every GPU clock high (max idle power, last resort)"
)
# amdgpu.dcdebugmask bits (drivers/gpu/drm/amd/include/amd_shared.h):
#   0x10 DC_DISABLE_PSR, 0x400 DC_DISABLE_REPLAY, 0x20000 DC_DISABLE_SUBVP_FAMS
level_cmdline() {
  case $1 in
    0) echo "" ;;
    1|2) echo "amdgpu.dcdebugmask=0x20000" ;;
    # dcfeaturemask defaults to 0x2 (DC_MULTI_MON_PP_MCLK_SWITCH_MASK); 0x0 turns it off.
    3|4) echo "amdgpu.dcdebugmask=0x20410 amdgpu.dcfeaturemask=0x0" ;;
  esac
}

display_level() {
  local LEVEL=0
  # shellcheck source=/dev/null
  [[ -r $DISPLAY_CONF ]] && . "$DISPLAY_CONF"
  echo "${LEVEL:-0}"
}

# Starting level for this PC, as "LEVEL<TAB>reason"; the installer uses it. Level 1 only where
# the blackouts are known: an RX 9070-series card driving a Samsung Odyssey or more than one
# screen. Everything else starts at stock and can climb the ladder if it ever blacks out.
display_recommend() {
  local card n=0 odyssey=0 conn name
  if ! card=$(dgpu_card); then
    printf '0\tno AMD graphics card (the fix is for Radeon cards)\n'; return 0
  fi
  if [[ " $DGPU_IDS " != *" $(cat "$card/device/device" 2>/dev/null) "* ]]; then
    printf '0\tno RX 9070-series card\n'; return 0
  fi
  while IFS=$'\t' read -r conn name; do
    [[ -n $conn ]] || continue
    n=$((n + 1))
    [[ $name == *Odyssey* || $name == *G70B* ]] && odyssey=1
  done < <(monitors)
  if [[ $odyssey == 1 ]]; then printf '1\tRX 9070-series card + Samsung Odyssey\n'
  elif [[ $n -gt 1 ]]; then printf '1\tRX 9070-series card + %d monitors\n' "$n"
  elif [[ $n == 1 ]]; then printf '0\tRX 9070-series card, one monitor\n'
  else printf '0\tRX 9070-series card, no monitors detected\n'; fi
}

grub_set_amdgpu_args() {
  local args=$1
  [[ -f $GRUB_DEFAULT ]] || { err "$GRUB_DEFAULT not found"; return 1; }
  local cur; cur=$(sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"$/\1/p' "$GRUB_DEFAULT")
  local kept=() tok
  for tok in $cur; do
    [[ $tok == amdgpu.dcdebugmask=* || $tok == amdgpu.dcfeaturemask=* ]] || kept+=("$tok")
  done
  local new="${kept[*]} $args"; new=${new% }
  sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"${new}\"|" "$GRUB_DEFAULT"
  grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
}

# Runtime part of the ladder (sysfs); run at boot by deckos-display.service.
display_apply() {
  need_root display apply
  local level card; level=$(display_level)
  card=$(dgpu_card) || { sub "no AMD graphics card: nothing to apply"; return 0; }
  local dev=$card/device
  # Older or non-amdgpu cards (and other PCs booting the live USB) have no power controls.
  [[ -w $dev/power_dpm_force_performance_level ]] || { warn "$(basename "$card") has no amdgpu power controls"; return 0; }
  case $level in
    0|1)
      echo auto > "$dev/power_dpm_force_performance_level" ;;
    2|3)
      echo manual > "$dev/power_dpm_force_performance_level"
      local top; top=$(tail -n1 "$dev/pp_dpm_mclk" | cut -d: -f1)
      echo "$top" > "$dev/pp_dpm_mclk"
      say "VRAM clock pinned to state $top on $(basename "$card")" ;;
    4)
      echo high > "$dev/power_dpm_force_performance_level" ;;
  esac
}

display_status() {
  section "Display"
  local level; level=$(display_level)
  say "  Fix level: ${C_B}${level}${C_0}   ${C_SUB}(sudo deckos display set 0-4)${C_0}"
  sub "${LEVEL_DESC[$level]}"
  local cmd; cmd=$(cat /proc/cmdline)
  if [[ -n $(level_cmdline "$level") ]]; then
    local t missing=0
    for t in $(level_cmdline "$level"); do [[ " $cmd " == *" $t "* ]] || missing=1; done
    [[ $missing == 0 ]] && ok "kernel flags active" || warn "kernel flags change pending — reboot"
  fi
  local card; if card=$(dgpu_card); then
    ok "GPU: $(basename "$card") ($(cat "$card/device/device")) perf=$(cat "$card/device/power_dpm_force_performance_level")"
    sub "VRAM clock now: $(grep '\*' "$card/device/pp_dpm_mclk" 2>/dev/null | tr -s ' ' || echo '?')"
  else
    sub "No AMD graphics card: the fix levels are for Radeon cards and change nothing here"
  fi
  section "Monitors"
  while IFS=$'\t' read -r conn name; do
    [[ -n $conn ]] && say "  $conn  ${C_SUB}${name:-unknown}${C_0}"
  done < <(monitors)
}

# Logs kernel display events, hotplugs and VRAM clock changes side by side. Press Enter
# the moment the screen blacks out to drop a marker; the log shows what happened around it.
display_watch() {
  local log=${HOME}/deckos-display-watch.log card
  card=$(dgpu_card) || { err "this watches an AMD card's memory clock; there's no AMD graphics card here"; exit 1; }
  say "${C_B}Watching for blackouts.${C_0} Press ${C_B}Enter${C_0} the moment the screen goes black; Ctrl+C to stop."
  say "${C_SUB}Log: $log${C_0}"
  : > "$log"
  (
    journalctl -kf -n0 -o short-precise 2>/dev/null \
      | grep --line-buffered -iE 'amdgpu|drm|hpd|link|flip|dmub|dp_' \
      | sed -u 's/^/[kernel] /' &
    udevadm monitor -k -s drm 2>/dev/null | sed -u -n 's/^KERNEL\[[^]]*\] *//p' | sed -u 's/^/[hotplug] /' &
    last=""
    while sleep 0.25; do
      now=$(grep '\*' "$card/device/pp_dpm_mclk" 2>/dev/null | tr -s ' ')
      [[ $now != "$last" ]] && echo "[vram-clock] $now" && last=$now
    done &
    wait
  ) | while IFS= read -r l; do printf '%s %s\n' "$(date +%T.%3N)" "$l"; done | tee -a "$log" &
  local bg=$!
  trap 'kill $bg 2>/dev/null; pkill -P $bg 2>/dev/null; exit 0' INT TERM
  while read -r _; do printf '%s ===== BLACKOUT MARKED =====\n' "$(date +%T.%3N)" | tee -a "$log"; done
}

display_set() {
  need_root display set
  local n=${1:-}
  [[ $n =~ ^[0-4]$ ]] || { err "level must be 0-4"; printf '  %s\n' "${LEVEL_DESC[@]}"; exit 2; }
  # The levels are amdgpu kernel flags and clocks: without an AMD card only 0 (stock) applies.
  [[ $n == 0 ]] || dgpu_card >/dev/null || { err "the fix levels are for AMD Radeon cards; this PC has none"; exit 1; }
  mkdir -p "$CONF_DIR"
  printf '# Managed by deckos display set\nLEVEL=%s\n' "$n" > "$DISPLAY_CONF"
  grub_set_amdgpu_args "$(level_cmdline "$n")"
  display_apply || true
  ok "display fix level $n saved"
  sub "${LEVEL_DESC[$n]}"
  warn "reboot to load the new kernel flags"
}

display_cmd() {
  case ${1:-status} in
    status) display_status ;;
    set) shift; display_set "$@" ;;
    apply) display_apply ;;
    watch) display_watch ;;
    levels) printf '  %s\n' "${LEVEL_DESC[@]}" ;;
    monitors) monitors ;;
    recommend) display_recommend ;;
    flags) level_cmdline "${2:-}" ;;  # kernel flags for level N (used by the installer)
    vendors) gpu_vendors ;;  # amd/nvidia/intel, one per line (used by the installer)
    *) err "usage: deckos display [status|levels|set N|watch|monitors|recommend]"; exit 2 ;;
  esac
}

# --------------------------------------------------------------------- drives
#
# Existing NTFS drives are mounted in place with the in-kernel ntfs3 driver — nothing is
# reformatted. Internal drives mount at boot, USB drives mount when first opened.

ntfs_partitions() {
  # path, uuid, label, parttype, size, transport; separated by \x1f, since a tab IFS collapses empty labels
  # NAME keeps the disk → partition tree: without it lsblk (util-linux 2.42) prints a flat list
  lsblk -J -b -o NAME,PATH,FSTYPE,UUID,LABEL,PARTTYPE,SIZE,TRAN | jq -r '
    .blockdevices[] | . as $d | (.children // [])[]
    | select(.fstype == "ntfs" and .uuid != null)
    | select((.parttype // "") != "de94bba4-06d1-4d40-a16a-bfd50179d6ac")
    | select(.size > 4000000000)
    | [.path, .uuid, (.label // ""), (.parttype // ""), (.size|tostring), ($d.tran // "")] | join("\u001f")'
}

mount_name() {
  local dev=$1 label=$2 uuid=$3 probe
  if [[ -z $label && $EUID -eq 0 ]]; then
    probe=$(mktemp -d)
    if mount -t ntfs3 -o ro "$dev" "$probe" 2>/dev/null || mount -t ntfs-3g -o ro "$dev" "$probe" 2>/dev/null; then
      [[ -d $probe/Windows/System32 ]] && label=Windows
      umount "$probe"
    fi
    rmdir "$probe"
  fi
  label=${label//[^A-Za-z0-9_.-]/_}
  echo "${label:-Disk-${uuid:0:4}}"
}

drives_fstab() {
  local uid=1000 gid=1000
  while [[ $# -gt 0 ]]; do
    case $1 in --uid) uid=$2; shift 2 ;; --gid) gid=$2; shift 2 ;; *) shift ;; esac
  done
  local base="uid=$uid,gid=$gid,umask=022,windows_names,prealloc,noatime,nofail,x-systemd.device-timeout=5s,x-gvfs-show"
  local used="" path uuid label _parttype size tran name opts
  echo "$FSTAB_BEGIN"
  while IFS=$'\x1f' read -r path uuid label _parttype size tran; do
    name=$(mount_name "$path" "$label" "$uuid")
    while [[ " $used " == *" $name "* ]]; do name="$name-${uuid:0:4}"; done
    used+=" $name"
    opts=$base
    [[ $tran == usb ]] && opts+=",noauto,x-systemd.automount,x-systemd.idle-timeout=0"
    printf '# %s (%s GB%s)\nUUID=%s  /mnt/%s  ntfs3  %s  0 0\n' \
      "$path" "$((size / 1000000000))" "${tran:+, $tran}" "$uuid" "$name" "$opts"
  done < <(ntfs_partitions)
  echo "$FSTAB_END"
}

drives_rescan() {
  need_root drives rescan
  local user=${SUDO_USER:-}
  [[ -z $user && -n ${PKEXEC_UID:-} ]] && user=$(id -nu "$PKEXEC_UID")
  [[ -n $user ]] || user=$(id -nu 1000 2>/dev/null || echo root)
  local block kept
  block=$(drives_fstab --uid "$(id -u "$user")" --gid "$(id -g "$user")")
  # Drives added in DecKoOS Disks that aren't NTFS (ext4, exFAT...) stay, with their comment line
  kept=$(awk -v b="$FSTAB_BEGIN" -v e="$FSTAB_END" '$0==b{f=1;next} $0==e{f=0} f' /etc/fstab |
    awk '/^UUID=/ && $3 !~ /^ntfs/ {if (prev ~ /^#/) print prev; print} {prev=$0}')
  [[ -z $kept ]] || block=$(printf '%s\n' "$block" | sed '$d'; printf '%s\n%s\n' "$kept" "$FSTAB_END")
  cp /etc/fstab /etc/fstab.deckos-bak
  awk -v b="$FSTAB_BEGIN" -v e="$FSTAB_END" '$0==b{skip=1} !skip{print} $0==e{skip=0}' \
    /etc/fstab.deckos-bak > /etc/fstab
  printf '\n%s\n' "$block" >> /etc/fstab
  grep -oP '(?<=  /mnt/)\S+' <<<"$block" | while read -r m; do mkdir -p "/mnt/$m"; done
  systemctl daemon-reload
  mount -a 2>/dev/null || true
  ok "fstab updated (backup: /etc/fstab.deckos-bak)"
  pulse drives "Drives linked: $(grep -c '^UUID=' <<<"$block" || true)" --app Drives
  drives_list
}

drives_list() {
  section "Drives"
  awk -v b="$FSTAB_BEGIN" -v e="$FSTAB_END" '$0==b{f=1;next} $0==e{f=0} f && /^UUID=/ {print $2}' /etc/fstab |
  while read -r mp; do
    if findmnt -n "$mp" >/dev/null 2>&1; then
      local fo; fo=$(findmnt -no OPTIONS "$mp")
      if [[ ,$fo, == *,ro,* ]]; then warn "$mp mounted READ-ONLY (Windows Fast Startup?) — see: deckos drives doctor"
      else ok "$mp  ${C_SUB}$(df -h --output=used,size "$mp" | tail -1 | awk '{print $1" / "$2" used"}')${C_0}"; fi
    else
      sub "$mp  not mounted (unplugged, or mounts on first open)"
    fi
  done
}

drives_doctor() {
  section "NTFS health"
  local bad
  bad=$(drives_dirty)
  if [[ -z $bad ]]; then ok "no NTFS drive is held back as dirty or hibernated"; else
    warn "These NTFS drives weren't closed properly, so Linux won't mount them:"
    cut -f1,2 <<<"$bad" | sed 's/^/    /'
    say ""
    if grep -q '^hibernated' <<<"$bad"; then
      say "  ${C_B}Hibernated${C_0}: Windows saved its session on the drive (Fast Startup). Start Windows, open"
      say "  Terminal as Administrator, run ${C_B}powercfg /h off${C_0}, then Shut Down (not Restart)."
    fi
    if grep -q '^dirty' <<<"$bad"; then
      say "  ${C_B}Dirty${C_0}: the PC was switched off or froze while the drive was in use (Linux or Windows)."
      say "  ${C_B}sudo deckos drives repair${C_0} clears the mark and mounts them again; run chkdsk /f on them in"
      say "  Windows when you can, since clearing the mark doesn't check the files."
    fi
  fi
}

# This PC's fstab NTFS drives that aren't mounted because the kernel refused them this boot, one per line:
# dirty|hibernated <TAB> mount point <TAB> device <TAB> fstab options. Read only (System Doctor and repair use it).
drives_dirty() {
  local log uuid mp type opts dev kname
  log=$(journalctl -k -b --no-pager -o cat 2>/dev/null | grep -E '^ntfs3\(' || true)
  while read -r uuid mp type opts; do
    dev=${DECKOS_BY_UUID:-/dev/disk/by-uuid}/${uuid#UUID=}
    [[ -e $dev ]] || continue
    findmnt -n "$mp" >/dev/null 2>&1 && continue
    kname=$(basename "$(readlink -f "$dev")")
    if grep -qiE "^ntfs3\($kname\):.*hiber" <<<"$log"; then printf 'hibernated\t%s\t%s\t%s\n' "$mp" "$dev" "$opts"
    elif grep -qE "^ntfs3\($kname\): volume is dirty" <<<"$log"; then printf 'dirty\t%s\t%s\t%s\n' "$mp" "$dev" "$opts"; fi
  done < <(awk '$1 ~ /^UUID=/ && $3 ~ /^ntfs/ {print $1, $2, $3, $4}' "${DECKOS_FSTAB:-/etc/fstab}")
}

# A drive marked dirty (the PC was cut off while it was in use) won't mount with ntfs3, at every start, until the
# mark is cleared. Clears it on the drives drives_dirty finds, then mounts them. Never on a hibernated Windows
# volume: clearing that would throw away the session Windows saved there.
drives_repair() {
  need_root drives repair
  section "Repairing NTFS drives"
  local state mp dev opts unit n=0 any=0
  while IFS=$'\t' read -r state mp dev opts; do
    any=1
    if [[ $state == hibernated ]]; then
      warn "$mp: Windows is hibernated on it. Start Windows, run powercfg /h off as Administrator, then Shut Down"
      continue
    fi
    if ! command -v ntfsfix >/dev/null; then
      say "Installing ntfsprogs (it has ntfsfix)…"
      pacman -S --needed --noconfirm ntfsprogs >/dev/null || { err "couldn't install ntfsprogs"; exit 1; }
    fi
    if ! ntfsfix -d "$dev" >/dev/null 2>&1; then err "$mp: ntfsfix couldn't clear the mark: run chkdsk /f on it in Windows"; continue; fi
    unit=$(systemd-escape -p --suffix=mount "$mp")
    systemctl reset-failed "$unit" "${unit%.mount}.automount" 2>/dev/null || true
    if [[ ,$opts, == *,x-systemd.automount,* ]]; then systemctl restart "${unit%.mount}.automount"; else systemctl start "$unit"; fi
    if findmnt -n "$mp" >/dev/null 2>&1 || systemctl is-active -q "${unit%.mount}.automount"; then
      ok "$mp repaired and back"; n=$((n + 1))
      pulse drives "Repaired drive $mp" --detail "It was marked dirty after the PC was cut off" --app Drives
    else
      err "$mp: the mark is cleared but it still won't mount: journalctl -b -u $unit"
    fi
  done < <(drives_dirty)
  (( any )) || ok "no NTFS drive is waiting on a repair"
  (( n == 0 )) || say "Run chkdsk /f on them next time you're in Windows: clearing the mark doesn't check the files."
}

# A Steam library on a drive that can't hold a Proton prefix (an NTFS drive mounted with windows_names refuses the
# name c:, and some take no links at all) keeps its prefixes on the Linux drive instead: they move to
# ~/.local/share/deckos/proton-prefixes/LIBRARY and a bind mount shows them at the library's compatdata, so Steam and
# Proton find them where they always look. Game Doctor offers it; fstab keeps it (its own block, which rescan keeps).
prefix_lines() { awk -v b="$PREFIX_BEGIN" -v e="$PREFIX_END" '$0==b{f=1;next} $0==e{f=0} f' "${DECKOS_FSTAB:-/etc/fstab}"; }

prefix_fstab_write() {  # LINES: the block's new body (empty: the block goes)
  cp /etc/fstab /etc/fstab.deckos-bak
  awk -v b="$PREFIX_BEGIN" -v e="$PREFIX_END" '$0==b{skip=1} !skip{print} $0==e{skip=0}' /etc/fstab.deckos-bak > /etc/fstab
  [[ -z $1 ]] || printf '\n%s\n%s\n%s\n' "$PREFIX_BEGIN" "$1" "$PREFIX_END" >> /etc/fstab
  systemctl daemon-reload
}

drives_prefixes() {  # LIBRARY on|off
  local lib=${1:-} want=${2:-on}
  [[ -n $lib && ($want == on || $want == off) ]] || { err "usage: deckos drives prefixes LIBRARY on|off"; exit 2; }
  need_root drives prefixes "$lib" "$want"
  lib=$(realpath -m "$lib"); lib=${lib%/}
  [[ $lib == */steamapps ]] && lib=${lib%/steamapps}
  [[ -d $lib/steamapps ]] || { err "$lib isn't a Steam library (no steamapps folder)"; exit 1; }
  local user=${SUDO_USER:-}
  [[ -z $user && -n ${PKEXEC_UID:-} ]] && user=$(id -nu "$PKEXEC_UID")
  [[ -n $user && $user != root ]] || { err "run it as yourself through sudo or pkexec, so the files go to your home"; exit 1; }
  local home compat slug target lines kept item name left=0
  home=$(getent passwd "$user" | cut -d: -f6)
  compat=$lib/steamapps/compatdata
  slug=$(sed 's/[^A-Za-z0-9]\+/-/g; s/^-//; s/-$//' <<<"$lib")
  target=$home/.local/share/deckos/proton-prefixes/${slug:-library}
  lines=$(prefix_lines)
  kept=$(grep -vF "  $compat  " <<<"$lines" || true)
  if [[ $want == on ]]; then
    if findmnt -n "$compat" >/dev/null 2>&1; then ok "$lib already keeps its Proton files at $target"; return; fi
    [[ -L $compat ]] && { err "$compat is a link to another drive already"; exit 1; }
    install -d -o "$user" -g "$(id -g "$user")" "$target"
    mkdir -p "$compat"
    for item in "$compat"/* "$compat"/.[!.]*; do  # what's there moves home; a name already home keeps both
      [[ -e $item || -L $item ]] || continue
      name=${item##*/}
      [[ -e $target/$name ]] && name="$name.deckos-$(date +%Y%m%d-%H%M%S)"
      mv "$item" "$target/$name" || { err "couldn't move $item: nothing else changes"; exit 1; }
    done
    chown -R "$user:$(id -g "$user")" "$target"
    lines=$(printf '%s\n%s  %s  none  bind,nofail,x-systemd.requires-mounts-for=%s,x-systemd.requires-mounts-for=%s  0 0' \
      "$kept" "$target" "$compat" "$(findmnt -nT "$lib" -o TARGET | tail -1)" "$home" | sed '/^$/d')
    prefix_fstab_write "$lines"
    mount "$compat" || { err "the mount didn't start: journalctl -b | grep compatdata"; exit 1; }
    ok "$lib keeps its Proton files on your Linux drive now ($target)"
    pulse drives "Proton files for $lib moved to your Linux drive" --app Drives
  else
    findmnt -n "$compat" >/dev/null 2>&1 && umount "$compat"
    prefix_fstab_write "$kept"
    if [[ -d $target ]]; then
      for item in "$target"/* "$target"/.[!.]*; do
        [[ -e $item || -L $item ]] || continue
        mv "$item" "$compat/" 2>/dev/null || left=1
      done
      [[ $left == 1 ]] || rmdir "$target" 2>/dev/null || true
    fi
    if [[ $left == 1 ]]; then warn "this drive refused some of them: those stay in $target"; else ok "$lib keeps its Proton files on its own drive again"; fi
    pulse drives "Proton files for $lib back on its drive" --app Drives
  fi
}

drives_cmd() {
  case ${1:-list} in
    list) drives_list ;;
    rescan) drives_rescan ;;
    fstab) shift; drives_fstab "$@" ;;
    doctor) drives_doctor ;;
    repair) drives_repair ;;
    dirty) drives_dirty ;;
    prefixes) shift; drives_prefixes "$@" ;;
    *) err "usage: deckos drives [list|rescan|doctor|repair|fstab|prefixes LIBRARY on|off]"; exit 2 ;;
  esac
}

# -------------------------------------------------------------------- session

session_cmd() {
  local target=${1:-} ask=${2:-}
  case $target in
    gaming|desktop) ;;
    *) err "usage: deckos session gaming|desktop [--ask]"; exit 2 ;;
  esac
  if [[ $ask == --ask ]] && command -v kdialog >/dev/null; then
    local label=Desktop; [[ $target == gaming ]] && label="Gaming Mode"
    kdialog --title "DecKoOS" --yes-label "Switch" --no-label "Cancel" \
      --warningyesno "Switch to $label?"$'\n\n'"Open apps will close — save your work first." || exit 0
  fi
  local cover=""
  # The logo covers the closing desktop until SDDM ends the session; Steam's startup movie carries it on
  if [[ $target == gaming && -n ${WAYLAND_DISPLAY:-${DISPLAY:-}} ]] && command -v qml6 >/dev/null; then
    setsid qml6 /usr/lib/deckos/transition/Transition.qml -- "--text=Starting Gaming Mode" >/dev/null 2>&1 &
    cover=$!
  fi
  if ! sudo -n /usr/lib/deckos/session-switch "$target" --delay 1; then
    [[ -z $cover ]] || kill "$cover" 2>/dev/null || true
    exit 1
  fi
}

# Picks the output Gaming Mode should use: the Samsung Odyssey if present, else the first one.
gaming_detect() {
  local first="" conn name
  while IFS=$'\t' read -r conn name; do
    [[ -z $first ]] && first=$conn
    [[ $name == *Odyssey* || $name == *G70B* ]] && { echo "$conn"; return 0; }
  done < <(monitors)
  [[ -n $first ]] && echo "$first"
}

# ----------------------------------------------------------------- steam-ntfs
#
# Proton prefixes (compatdata) can't live on NTFS — Windows filenames like "C:" break them.
# Keep games on the NTFS drive, move just the prefixes to the Linux drive via symlink.

steam_ntfs() {
  local steam=$HOME/.local/share/Steam vdf
  vdf=$steam/steamapps/libraryfolders.vdf
  [[ -f $vdf ]] || { err "Steam library list not found — open Steam once and add your library folders first"; exit 1; }
  pgrep -x steam >/dev/null && { err "close Steam first"; exit 1; }
  section "Steam libraries on NTFS"
  local lib fs n=0
  while IFS= read -r lib; do
    [[ -d $lib/steamapps ]] || continue
    fs=$(findmnt -no FSTYPE -T "$lib" 2>/dev/null || true)
    [[ $fs == ntfs3 || $fs == ntfs || $fs == fuseblk ]] || { sub "$lib ($fs) — fine as is"; continue; }
    local key; key=$(printf '%s' "$lib" | md5sum | cut -c1-10)
    local dest=$HOME/.local/share/deckos/steam-ntfs/$key
    local d
    for d in compatdata shadercache; do
      local src=$lib/steamapps/$d
      mkdir -p "$dest/$d"
      if [[ -L $src ]]; then continue; fi
      if [[ -d $src ]]; then cp -a "$src/." "$dest/$d/" 2>/dev/null || true; rm -rf "$src"; fi
      ln -s "$dest/$d" "$src"
    done
    ok "$lib → prefixes in ~/.local/share/deckos/steam-ntfs/$key"; n=$((n + 1))
  done < <(grep -oP '"path"\s+"\K[^"]+' "$vdf")
  [[ $n -gt 0 ]] || sub "no NTFS libraries found"
}

# --------------------------------------------------------------------- update

update_cmd() {
  if [[ ${1:-} == --system ]]; then
    # DecKoOS Hub runs this through pkexec: no prompts, and no progress bars, so it can read
    # pacman's "(n/N)" lines for its own. AUR apps need the interactive form below.
    need_root update --system
    pacman -Syu --noconfirm --noprogressbar
    if command -v flatpak >/dev/null; then flatpak update -y --noninteractive || true; fi
    ok "done"
    return
  fi
  local before after
  before=$(pacman -Q deckos-settings 2>/dev/null || true)
  section "Updating DecKoOS"
  sub "snap-pac takes a btrfs snapshot before and after; 'deckos undo' goes back if it goes wrong."
  if command -v paru >/dev/null; then paru -Syu; else sudo pacman -Syu; fi
  command -v flatpak >/dev/null && flatpak update -y || true
  ok "done"
  after=$(pacman -Q deckos-settings 2>/dev/null || true)
  if [[ $after != "$before" ]]; then
    # The panel, Menu and Quick Settings keep the old version until plasmashell restarts.
    ok "DecKoOS ${after#deckos-settings } installed"
    sub "Restart the desktop to load it (open windows stay open): systemctl --user restart plasma-plasmashell"
  fi
}

# How many updates are waiting (DecKoOS Quick Settings shows it in the panel). Checking needs the
# network, so the answer is cached and reused while it's younger than --max-age seconds and pacman
# hasn't installed anything since.
UPDATES_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/deckos/updates

updates_stale() {  # updates_stale MAX_AGE
  [[ -s $UPDATES_CACHE ]] || return 0
  [[ /var/lib/pacman/local -nt $UPDATES_CACHE ]] && return 0
  (( $(date +%s) - $(stat -c %Y "$UPDATES_CACHE") >= $1 ))
}

updates_check() {
  local repo=0 aur=0 out rc=0 error="" old
  if ! command -v checkupdates >/dev/null; then
    error="checkupdates isn't installed (pacman-contrib)"
  else
    out=$(checkupdates 2>/dev/null) || rc=$?
    case $rc in
      0) repo=$(grep -c . <<<"$out" || true) ;;
      2) ;;  # nothing to update
      *) error="No connection to the package mirrors" ;;
    esac
  fi
  if [[ -z $error ]] && command -v paru >/dev/null; then
    aur=$( (paru -Qua 2>/dev/null || true) | grep -v '\[ignored\]' | grep -c . || true)
  fi
  if [[ -n $error && -r $UPDATES_CACHE ]]; then  # keep the last known counts
    old=$(cat "$UPDATES_CACHE")
    repo=$(sed -n 's/^repo=//p' <<<"$old"); aur=$(sed -n 's/^aur=//p' <<<"$old")
  fi
  {
    printf 'repo=%s\naur=%s\nchecked=%s\n' "${repo:-0}" "${aur:-0}" "$(date +%s)"
    if [[ -n $error ]]; then printf 'error=%s\n' "$error"; fi
  } > "$UPDATES_CACHE.new"
  mv "$UPDATES_CACHE.new" "$UPDATES_CACHE"
}

updates_cmd() {
  local max_age=3600
  case ${1:-} in
    "") ;;
    --cached) [[ -r $UPDATES_CACHE ]] && cat "$UPDATES_CACHE"; return 0 ;;
    --max-age) max_age=${2:-}; [[ $max_age =~ ^[0-9]+$ ]] || { err "--max-age takes seconds"; exit 2; } ;;
    *) err "usage: deckos updates [--cached|--max-age SECONDS]"; exit 2 ;;
  esac
  mkdir -p "${UPDATES_CACHE%/*}"
  exec 9>"$UPDATES_CACHE.lock"
  flock 9  # the panel and a terminal checking at once: the second one waits, then reuses the answer
  if updates_stale "$max_age"; then updates_check; fi
  cat "$UPDATES_CACHE"
}

# Everything DecKoOS Quick Settings shows from the deckos side, in one quick call: no network, no root.
quick_status() {
  printf 'display=%s\n' "$(display_level)"
  if /usr/lib/deckos/gaming-session --check >/dev/null 2>&1; then echo gaming=1; else echo gaming=0; fi
  if command -v firewall-cmd >/dev/null; then echo firewall=1; else echo firewall=0; fi
  mode_status
  # Context: what you're doing (activity=, label=, icon=, why=, pinned=) and its switches
  cat "${XDG_RUNTIME_DIR:-/run/user/$UID}/deckos-context" 2>/dev/null || true
  python3 "${DECKOS_CONTEXT_DIR:-/usr/lib/deckos/context}/context.py" status 2>/dev/null || true
  if [[ -r $UPDATES_CACHE ]]; then
    cat "$UPDATES_CACHE"
    if [[ /var/lib/pacman/local -nt $UPDATES_CACHE ]]; then echo stale=1; fi
  fi
}

# --------------------------------------------------------------------- software
#
# The installer's optional groups, added later (DecKoOS Hub > System > Software). Same lists the
# installer used; services, user groups and firewall rules match what it sets up.

PACKAGES=/usr/share/deckos/packages
SOFTWARE_GROUPS=(gaming ai dev)

# A second column names the graphics vendor a package is for (amd, nvidia, intel).
pkg_list() {
  grep -vE '^\s*(#|$)' "$PACKAGES/$1.txt" | awk -v gpus=" $(gpu_vendors | tr '\n' ' ') " \
    'NF == 1 || index(gpus, " " $2 " ") {print $1}'
}
aur_list() { grep -vE '^\s*(#|$)' "$PACKAGES/aur.txt" | awk -v g="$1" '$2 == g {print $1}'; }

software_list() {
  local g pkgs missing
  for g in "${SOFTWARE_GROUPS[@]}"; do
    mapfile -t pkgs < <(pkg_list "$g")
    missing=$(pacman -T "${pkgs[@]}" | wc -l)
    if [[ $missing == 0 ]]; then ok "$g"; else sub "$g: $missing of ${#pkgs[@]} packages missing (deckos software add $g)"; fi
  done
}

software_add() {
  local g=${1:-} pkgs aur
  [[ " ${SOFTWARE_GROUPS[*]} " == *" $g "* ]] || { err "usage: deckos software add gaming|ai|dev"; exit 2; }
  [[ $EUID -ne 0 ]] || { err "run this as your user: it uses sudo itself, and AUR apps build as you"; exit 1; }
  section "Adding $g"
  mapfile -t pkgs < <(pkg_list "$g")
  mapfile -t aur < <(aur_list "$g")
  sudo pacman -S --needed "${pkgs[@]}"
  if [[ ${#aur[@]} -gt 0 ]]; then paru -S --needed "${aur[@]}" || warn "some AUR apps failed: ${aur[*]}"; fi
  case $g in
    gaming)
      sudo systemctl enable --now lactd || warn "could not start lactd"
      if getent group gamemode >/dev/null; then sudo usermod -aG gamemode "$USER"; fi
      if systemctl is-active --quiet firewalld; then
        sudo firewall-cmd --permanent --add-service=steam-streaming >/dev/null && sudo firewall-cmd --reload >/dev/null \
          || warn "could not open Steam Remote Play in the firewall"
      fi ;;
    ai)
      sudo systemctl enable --now ollama || warn "could not start ollama" ;;
    dev)
      sudo systemctl enable --now docker.socket || warn "could not start docker"
      sudo usermod -aG docker "$USER"
      curl -fsSL https://claude.ai/install.sh | bash || warn "Claude Code install failed (DecKoOS Hub can retry)" ;;
  esac
  ok "$g added"
  sub "Log out and back in so new group memberships apply."
}

software_cmd() {
  case ${1:-list} in
    list) software_list ;;
    add) shift; software_add "$@" ;;
    *) err "usage: deckos software [list|add gaming|ai|dev]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ spotify
#
# The DecKoOS look for the official Spotify app, through Spicetify. Works with Arch's
# spotify-launcher, the AUR package and the Flathub app. Spotify updates undo it: run it again.

SPOTIFY_APPS=("$HOME/.local/share/spotify-launcher/install/usr/share/spotify" /opt/spotify /usr/share/spotify
              /var/lib/flatpak/app/com.spotify.Client/x86_64/stable/active/files/extra/share/spotify
              "$HOME/.local/share/flatpak/app/com.spotify.Client/x86_64/stable/active/files/extra/share/spotify")
SPOTIFY_PREFS=("$HOME/.config/spotify/prefs" "$HOME/.var/app/com.spotify.Client/config/spotify/prefs")

spotify_theme() {
  [[ $EUID -ne 0 ]] || { err "run this as your user: Spicetify's settings live in your home folder"; exit 1; }
  local app="" prefs="" c themes
  for c in "${SPOTIFY_APPS[@]}"; do [[ -d $c/Apps ]] && { app=$c; break; }; done
  [[ -n $app ]] || { err "Spotify isn't installed (get it from the DecKoOS Store), or hasn't been opened yet"; exit 1; }
  for c in "${SPOTIFY_PREFS[@]}"; do [[ -f $c ]] && { prefs=$c; break; }; done
  [[ -n $prefs ]] || { err "open Spotify once and log in, close it, then run this again"; exit 1; }
  section "DecKoOS theme for Spotify"
  sub "Spotify: $app"
  if ! command -v spicetify >/dev/null; then
    paru -S --needed spicetify-cli || { err "couldn't install Spicetify (spicetify-cli)"; exit 1; }
  fi
  # Spicetify patches Spotify's own files; the system-wide installs need to be writable for that.
  if [[ ! -w $app || ! -w $app/Apps ]]; then
    sudo chmod a+wr "$app" && sudo chmod -R a+wr "$app/Apps"
  fi
  themes=${XDG_CONFIG_HOME:-$HOME/.config}/spicetify/Themes/DeckOS
  mkdir -p "$themes"
  cp /usr/share/deckos/spicetify/DeckOS/* "$themes/"
  spicetify config spotify_path "$app" prefs_path "$prefs" current_theme DecKoOS color_scheme deckos \
    inject_css 1 replace_colors 1 >/dev/null
  if pgrep -x spotify >/dev/null; then warn "Spotify is open: it restarts to load the theme"; fi
  # First time: back up the stock files. After a Spotify update: refresh that backup first.
  spicetify backup apply >/dev/null 2>&1 || spicetify restore backup apply >/dev/null 2>&1 || spicetify apply \
    || { err "Spicetify couldn't apply the theme (see above)"; exit 1; }
  ok "Spotify now has the DecKoOS look"
  sub "After Spotify updates itself, run this again (or DecKoOS Hub > Appearance > Spotify)."
}

spotify_restore() {
  command -v spicetify >/dev/null || { ok "Spicetify isn't installed: Spotify is already stock"; return; }
  spicetify restore && ok "Spotify is back to its own look"
}

spotify_cmd() {
  case ${1:-theme} in
    theme) spotify_theme ;;
    restore) spotify_restore ;;
    *) err "usage: deckos spotify [theme|restore]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ dev-install
#
# Builds the DecKoOS packages from a checkout of the repo and installs them: the loop for working
# on DecKoOS from DecKoOS. A later release with a higher version replaces them as a normal update.

dev_install() {
  [[ $EUID -ne 0 ]] || { err "run this as your user (makepkg won't build as root)"; exit 1; }
  local root="" downgrade=0 c p new installed
  for c in "$@"; do
    if [[ $c == --downgrade ]]; then downgrade=1; else root=$c; fi
  done
  if [[ -z $root ]]; then
    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    for c in "$root" "$HOME/deckos" "$HOME/DeckOS" "$HOME/src/deckos" "$HOME/Projects/deckos"; do
      [[ -n $c && -f $c/VERSION && -d $c/pkg/deckos-settings ]] && { root=$c; break; }
    done
  fi
  [[ -f $root/VERSION && -d $root/pkg/deckos-settings ]] || { err "no DecKoOS checkout found: deckos dev-install PATH"; exit 2; }
  new=$(tr -d '[:space:]' < "$root/VERSION")
  # An old clone found by the search above once replaced a newer DecKoOS with a months-old one.
  installed=$(pacman -Q deckos-settings 2>/dev/null | awk '{print $2}' || true)
  if [[ -n $installed && $downgrade == 0 ]] && (( $(vercmp "$new-1" "$installed") < 0 )); then
    err "$root has DecKoOS $new, older than the installed ${installed%-*}: nothing changed."
    sub "Pick the right checkout (deckos dev-install PATH), or add --downgrade if you mean it."
    exit 1
  fi
  section "Installing DecKoOS $new from $root"
  for p in deckos-files deckos-terminal deckos-editor deckos-settings deckos-theme-tmpikes; do
    [[ -d $root/pkg/$p ]] || continue
    (cd "$root/pkg/$p" && makepkg -sif --noconfirm --clean) || { err "$p didn't build"; exit 1; }
    ok "$p"
  done
  sub "Restart DecKoOS Hub to see Hub changes."
}

# ------------------------------------------------------------------ home
#
# /home gets its own hourly snapshots (the system's only cover /). Caches and Steam games change
# all the time, so they become their own subvolumes, which snapshots skip.

HOME_SKIP=(.cache .local/share/Steam)

as_subvolume() {  # as_subvolume PATH OWNER - make a folder a nested subvolume, keeping its files
  local path=$1 owner=$2 parent
  parent=$(dirname "$path")
  runuser -u "$owner" -- mkdir -p "$parent"
  [[ $(stat -f -c %T "$parent") == btrfs ]] || return 0
  btrfs subvolume show "$path" >/dev/null 2>&1 && return 0
  if [[ -e $path ]]; then mv "$path" "$path.deckos-old"; fi
  btrfs subvolume create "$path" >/dev/null
  if [[ -e $path.deckos-old ]]; then
    cp -a --reflink=auto "$path.deckos-old/." "$path/" && rm -rf "$path.deckos-old"
  fi
  chown "$owner:$(id -gn "$owner")" "$path"
}

home_enable() {
  need_root home enable
  [[ $(findmnt -no FSTYPE /home) == btrfs ]] || { err "/home isn't on btrfs, so it can't have snapshots"; exit 1; }
  local cfg=/etc/snapper/configs/home d u home
  [[ -f $cfg ]] || snapper --no-dbus -c home create-config /home
  sed -i -E 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="yes"/; s/^TIMELINE_CLEANUP=.*/TIMELINE_CLEANUP="yes"/;
             s/^TIMELINE_LIMIT_HOURLY=.*/TIMELINE_LIMIT_HOURLY="12"/; s/^TIMELINE_LIMIT_DAILY=.*/TIMELINE_LIMIT_DAILY="7"/;
             s/^TIMELINE_LIMIT_WEEKLY=.*/TIMELINE_LIMIT_WEEKLY="2"/; s/^TIMELINE_LIMIT_MONTHLY=.*/TIMELINE_LIMIT_MONTHLY="0"/;
             s/^TIMELINE_LIMIT_YEARLY=.*/TIMELINE_LIMIT_YEARLY="0"/; s/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/;
             s/^ALLOW_GROUPS=.*/ALLOW_GROUPS="wheel"/; s/^SYNC_ACL=.*/SYNC_ACL="yes"/' "$cfg"
  for home in /home/*/; do
    home=${home%/}
    u=$(stat -c %U "$home")
    [[ $(id -u "$u" 2>/dev/null || echo 0) -ge 1000 ]] || continue
    for d in "${HOME_SKIP[@]}"; do
      if [[ $d == .local/share/Steam ]] && pgrep -u "$u" -x steam >/dev/null; then
        warn "$u: close Steam, then run this again to move ~/$d out of snapshots"; continue
      fi
      as_subvolume "$home/$d" "$u"
    done
    ok "$u: ~/.cache and Steam games are left out of snapshots"
  done
  systemctl enable snapper-timeline.timer snapper-cleanup.timer >/dev/null 2>&1 || true
  if [[ -d /run/systemd/system ]]; then systemctl start snapper-timeline.timer snapper-cleanup.timer || true; fi
  snapper --no-dbus -c home create -d "Home snapshots turned on" || true
  ok "/home snapshots: hourly, keeping 12 hourly, 7 daily and 2 weekly"
  sub "Browse them in /home/.snapshots/<number>/snapshot (DecKoOS Hub > System > Snapshots)."
}

# Snapshots saved in a snapper config, or nothing if snapper can't read it. wheel may list without
# sudo (ALLOW_GROUPS); #0 is snapper's "current" row, not a snapshot.
snapshot_count() {
  local nums
  nums=$(snapper --csvout --no-headers -c "$1" list --columns number 2>/dev/null) || return 1
  grep -cvx '0' <<<"$nums" || true
}

# ------------------------------------------------------------------ undo an update
#
# snap-pac snapshots / before ("pre") and after every pacman transaction. Undoing one puts a writable
# copy of its pre snapshot in place of @ and keeps the current @ as @.undone-DATE, so the undo can be
# undone too. /boot is inside @, so kernels, modules, GRUB's menu and pacman's database all go back
# together; /home, /var/log and the package cache are their own subvolumes and stay as they are.

UNDO_STATE=/var/lib/deckos/undo

undo_list() {  # the last updates that can be undone: PRE<TAB>DATE<TAB>WHAT (WHAT from the post snapshot)
  local json
  json=$(snapper --jsonout -c root list 2>/dev/null) || { err "couldn't read system snapshots (snapper -c root list)"; exit 1; }
  jq -r '(.root // []) as $s | [$s[] | select(.type == "pre")] | sort_by(-.number) | .[:20][] | . as $p
    | ([$s[] | select(.type == "post" and ."pre-number" == $p.number)][0].description // "") as $what
    | [($p.number | tostring), ($p.date // "" | .[:16]), (if $what != "" then $what else $p.description end)] | @tsv' <<<"$json"
}

# Puts a writable copy of snapshot N in place of @ for the next start, keeping the current @ as @.undone-DATE.
swap_in() {
  local n=$1 date=$2 what=$3 dev top kept stamp
  [[ $(findmnt -no FSTYPE /.snapshots) == btrfs && $(findmnt -no FSROOT /.snapshots) == /@snapshots ]] \
    || { err "/.snapshots isn't DecKoOS's @snapshots subvolume, so nothing can be swapped safely"; exit 1; }
  dev=$(findmnt -no SOURCE /.snapshots); dev=${dev%%\[*}
  top=$(mktemp -d)
  mount -o subvolid=5 "$dev" "$top"
  # shellcheck disable=SC2064  # expand now: $top is local
  trap "umount '$top' 2>/dev/null; rmdir '$top' 2>/dev/null" EXIT
  [[ -d $top/@ && -d $top/@snapshots/$n/snapshot ]] || { err "snapshot $n's files are missing ($top/@snapshots/$n/snapshot)"; exit 1; }
  stamp=$(date +%Y%m%d-%H%M%S) kept=@.undone-$stamp
  [[ ! -e $top/@.undo-new ]] || btrfs subvolume delete "$top/@.undo-new" >/dev/null
  btrfs subvolume snapshot "$top/@snapshots/$n/snapshot" "$top/@.undo-new" >/dev/null
  mkdir -p "$top/@.undo-new${UNDO_STATE%/*}"
  printf 'when=%s\nsnapshot=%s\ndate=%s\nwhat=%s\nkept=%s\n' "$(date +%s)" "$n" "$date" "$what" "$kept" \
    > "$top/@.undo-new$UNDO_STATE"
  # Two renames on one file system; if the second fails, put the first back so there's always an @.
  mv "$top/@" "$top/$kept"
  if ! mv "$top/@.undo-new" "$top/@"; then
    mv "$top/$kept" "$top/@"
    err "couldn't put the snapshot in place: nothing changed"; exit 1
  fi
  sync
  KEPT=$kept
}

# The snapshot GRUB's snapshots menu started (grub-btrfs boots it read-only under an overlay), or nothing.
booted_snapshot() {
  sed -nE 's/.*rootflags=([^ ]*,)?subvol="?\/?@snapshots\/([0-9]+)\/snapshot.*/\2/p' "${DECKOS_CMDLINE:-/proc/cmdline}"
}

# Started from a snapshot after an update broke start-up: make it the system for good.
undo_keep() {
  local n date what
  n=$(booted_snapshot)
  [[ -n $n ]] || { err "DecKoOS wasn't started from a snapshot (pick one in the boot menu's DecKoOS snapshots)"; exit 1; }
  need_root undo keep
  IFS=$'\t' read -r date what < <(snapper --jsonout -c root list 2>/dev/null | jq -r --argjson n "$n" \
    '.root[] | select(.number == $n) | [(.date // "" | .[:16]), (.description // "")] | @tsv' || true) || true
  swap_in "$n" "$date" "${what:-snapshot $n}"
  pulse undo "Kept snapshot $n as the system" --detail "$date"
  ok "DecKoOS keeps this snapshot ($date) as the system from the next start"
  sub "The system that didn't start is kept as $KEPT: 'sudo deckos undo clean' deletes it once you're happy."
}

undo_to() {
  local n=$1 row type date what
  need_root undo "$n"
  [[ $n =~ ^[1-9][0-9]*$ ]] || { err "usage: deckos undo NUMBER (see deckos undo list)"; exit 2; }
  [[ ! -e /var/lib/pacman/db.lck ]] || { err "an update is running right now: try again when it's done"; exit 1; }
  row=$(snapper --jsonout -c root list 2>/dev/null | jq -r --argjson n "$n" \
    '.root[] | select(.number == $n) | [.type, (.date // "" | .[:16]), (.description // "")] | @tsv') || true
  IFS=$'\t' read -r type date what <<<"$row"
  [[ $type == pre ]] || { err "snapshot $n isn't the 'before' snapshot of an update (deckos undo list shows those)"; exit 1; }
  # The packages it changed (from the post snapshot) say more than the pacman command line
  row=$(undo_list | awk -F'\t' -v n="$n" '$1 == n {print $3; exit}')
  what=${row:-$what}
  [[ $(findmnt -no FSTYPE /) == btrfs && $(findmnt -no FSROOT /) == /@ ]] \
    || { err "/ isn't DecKoOS's btrfs layout (@ and @snapshots), so it can't be swapped safely: use GRUB's snapshots menu"; exit 1; }
  swap_in "$n" "$date" "$what"
  ok "DecKoOS goes back to before \"$what\" ($date) when you restart"
  sub "Until then nothing changes. /home, your files and settings aren't touched."
  sub "The system as it is now is kept as $KEPT: 'sudo deckos undo clean' deletes it once you're happy."
}

undo_clean() {  # delete the systems kept by earlier undos (never the running one)
  local dev top s n=0
  need_root undo clean
  dev=$(findmnt -no SOURCE /); dev=${dev%%\[*}
  top=$(mktemp -d)
  mount -o subvolid=5 "$dev" "$top"
  # shellcheck disable=SC2064
  trap "umount '$top' 2>/dev/null; rmdir '$top' 2>/dev/null" EXIT
  for s in "$top"/@.undone-*; do
    [[ -d $s ]] || continue
    # --recursive: nested subvolumes (docker's, systemd-machined's) would block a plain delete.
    btrfs subvolume delete --recursive "$s" >/dev/null && n=$((n + 1))
  done
  # DecKoOS Hub stops offering to delete what's gone
  if (( n )) && [[ -f $UNDO_STATE ]] && ! grep -q '^cleaned=' "$UNDO_STATE"; then echo "cleaned=$(date +%s)" >> "$UNDO_STATE"; fi
  (( n )) && ok "deleted $n kept system(s)" || ok "nothing to clean"
}

undo_cmd() {
  case ${1:-list} in
    list)
      local rows
      rows=$(undo_list)
      if [[ -z $rows ]]; then say "No updates to undo yet: snapshots are taken from the next update on."; return; fi
      section "Updates you can undo (sudo deckos undo NUMBER)"
      while IFS=$'\t' read -r n when what; do printf '  %s%5s%s  %s  %s\n' "$C_B" "$n" "$C_0" "$when" "$what"; done <<<"$rows"
      if [[ -r $UNDO_STATE ]]; then
        sub "Last undo: back to snapshot $(sed -n 's/^snapshot=//p' "$UNDO_STATE") ($(sed -n 's/^what=//p' "$UNDO_STATE"))"
      fi ;;
    --tsv) undo_list ;;
    clean) undo_clean ;;
    keep) undo_keep ;;
    booted) booted_snapshot ;;
    *) undo_to "$1" ;;
  esac
}

# ------------------------------------------------------------------ snapshot first (the shell side)
#
# /usr/share/deckos/shell/snapshot-first.bash asks before rm -r of a big folder in /home and takes a
# pre/post pair in the home config; `deckos restore N` puts back what changed between them (snapper
# undochange, through snapperd: wheel may, ALLOW_GROUPS). No restart: it's only files.

SHELL_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/deckos/shell.conf

restore_cmd() {
  local n=${1:-} post what
  [[ $n =~ ^[1-9][0-9]*$ ]] || { err "usage: deckos restore NUMBER [PATH...] (the number DecKoOS printed)"; exit 2; }
  shift
  [[ -f /etc/snapper/configs/home ]] || { err "/home has no snapshots (sudo deckos home enable)"; exit 1; }
  read -r post what < <(snapper --jsonout -c home list 2>/dev/null | jq -r --argjson n "$n" \
    '.[keys[0]][] | select(.type == "post" and ."pre-number" == $n) | "\(.number) \(.description // "")"') || true
  [[ -n $post ]] || { err "home snapshot $n has no 'after' snapshot: give the number DecKoOS printed after the command"; exit 1; }
  if (( $# == 0 )); then
    # Only what was deleted comes back. Other programs write to /home while a command runs (Baloo's index,
    # app settings), and a plain undochange would roll those back too, under the running programs.
    local list
    list=$(mktemp)
    # shellcheck disable=SC2064
    trap "rm -f '$list'" EXIT
    snapper -c home status "$n..$post" | sed -n 's/^-[^ ]* //p' > "$list"
    [[ -s $list ]] || { ok "nothing was deleted between snapshots $n and $post"; return; }
    snapper -c home undochange --input "$list" "$n..$post" \
      || { err "couldn't put the files back (snapper -c home undochange $n..$post)"; exit 1; }
  else
    snapper -c home undochange "$n..$post" "$@" || { err "couldn't put the files back (snapper -c home undochange $n..$post)"; exit 1; }
  fi
  ok "back as before: $what"
}

snapshot_first_cmd() {
  case ${1:-status} in
    status) grep -qs '^SNAPSHOT_FIRST=0' "$SHELL_CONF" && echo "snapshot-first=off" || echo "snapshot-first=on" ;;
    on|off)
      mkdir -p "${SHELL_CONF%/*}"
      { grep -sv '^SNAPSHOT_FIRST=' "$SHELL_CONF" || true; echo "SNAPSHOT_FIRST=$([[ $1 == on ]] && echo 1 || echo 0)"; } > "$SHELL_CONF.new"
      mv "$SHELL_CONF.new" "$SHELL_CONF"
      ok "snapshot first $1 (new terminals and the next command in open ones)" ;;
    *) err "usage: deckos snapshot-first [status|on|off]"; exit 2 ;;
  esac
}

home_status() {
  section "Home"
  if [[ -f /etc/snapper/configs/home ]]; then
    local n
    if ! n=$(snapshot_count home); then warn "couldn't read /home snapshots (snapper -c home list)"
    elif (( n == 0 )); then warn "/home snapshots on, but none saved yet (systemctl status snapper-timeline.timer)"
    else ok "snapshots on: $n saved"; fi
  else
    warn "no /home snapshots (sudo deckos home enable)"
  fi
  local conf=$HOME/.config/deckos/backup.conf
  if [[ -r $conf ]]; then
    ok "backup: $(sed -n 's/^DEST=//p' "$conf"), last $(sed -n 's/^LAST=//p' "$conf")"
  else
    sub "no backup yet (deckos backup /mnt/YOURDRIVE)"
  fi
}

home_cmd() {
  case ${1:-status} in
    status) home_status ;;
    enable) home_enable ;;
    *) err "usage: deckos home [status|enable]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ backup
#
# Snapshots live on the same disk; a backup doesn't. Copies your home folder to another drive
# (an NTFS one is fine) without caches, Steam games or build output. Remembers the drive.

backup_cmd() {
  [[ $EUID -ne 0 ]] || { err "run this as your user: it backs up your own home folder"; exit 1; }
  local conf=$HOME/.config/deckos/backup.conf dest=${1:-} target rc=0
  [[ -z $dest && -r $conf ]] && dest=$(sed -n 's/^DEST=//p' "$conf")
  [[ -n $dest ]] || { err "usage: deckos backup /mnt/BIG   (remembered for next time)"; exit 2; }
  [[ -d $dest && -w $dest ]] || { err "$dest isn't a writable folder (is the drive mounted?)"; exit 1; }
  target="$dest/DeckOS backup/$USER@$(uname -n)"
  mkdir -p "$target" "$(dirname "$conf")"
  section "Backing up $HOME"
  sub "to $target"
  rsync -rlt --delete --delete-excluded --info=progress2 --exclude-from=- "$HOME/" "$target/" <<'EOF' || rc=$?
.cache/
.local/share/Steam/
.local/share/Trash/
.local/share/deckos/steam-ntfs/
.snapshots/
node_modules/
.venv/
__pycache__/
*.iso
EOF
  case $rc in
    0) ok "backed up" ;;
    23|24) warn "backed up, but some files were skipped (names Windows doesn't allow, or files that changed while copying)" ;;
    *) err "backup stopped (rsync exit $rc)"; exit "$rc" ;;
  esac
  printf 'DEST=%s\nLAST=%s\n' "$dest" "$(date '+%Y-%m-%d %H:%M')" > "$conf"
}

# ------------------------------------------------------------------ scheduler
#
# sched_ext CPU schedulers (scx-tools) through scx_loader: lavd keeps frame times steady when the
# game shares the CPU with Discord, OBS or a browser. DecKoOS starts on lavd in Gaming mode.

SCX_CONF=/etc/scx_loader.toml

scheduler_status() {  # key=value, no root: what's running now and what's configured
  local state ops sched mode
  state=$(cat /sys/kernel/sched_ext/state 2>/dev/null || echo unsupported)
  ops=$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true)
  sched=$(sed -n 's/^default_sched *= *"scx_\(.*\)"/\1/p' "$SCX_CONF" 2>/dev/null)
  mode=$(sed -n 's/^default_mode *= *"\(.*\)"/\1/p' "$SCX_CONF" 2>/dev/null)
  systemctl is-enabled --quiet scx_loader.service 2>/dev/null || sched=off
  printf 'state=%s\nrunning=%s\nsched=%s\nmode=%s\n' "$state" "${ops%%_*}" "${sched:-off}" "${mode:-Auto}"
}

scheduler_set() {  # scheduler_set lavd|bpfland|rusty|off [Gaming|PowerSave|LowLatency|Auto]
  need_root scheduler set
  local sched=$1 mode=${2:-Gaming}
  [[ $sched =~ ^(lavd|bpfland|rusty|off)$ ]] || { err "scheduler: lavd, bpfland, rusty or off"; exit 2; }
  [[ $mode =~ ^(Gaming|PowerSave|LowLatency|Auto)$ ]] || { err "mode: Gaming, PowerSave, LowLatency or Auto"; exit 2; }
  if [[ $sched == off ]]; then
    systemctl disable --now scx_loader.service >/dev/null 2>&1 || true
    ok "CPU scheduler: the kernel's own (BORE)"
    return
  fi
  systemctl cat scx_loader.service >/dev/null 2>&1 || { err "scx_loader isn't installed (pacman -S scx-tools)"; exit 1; }
  printf '# Written by deckos scheduler (DecKoOS Hub > Gaming > Performance)\ndefault_sched = "scx_%s"\ndefault_mode = "%s"\n' \
    "$sched" "$mode" > "$SCX_CONF"
  systemctl enable scx_loader.service >/dev/null 2>&1
  systemctl restart scx_loader.service
  ok "CPU scheduler: $sched ($mode)"
}

scheduler_cmd() {
  case ${1:-status} in
    status) scheduler_status ;;
    set) shift; scheduler_set "${1:-lavd}" "${2:-Gaming}" ;;
    *) err "usage: deckos scheduler [status|set lavd|bpfland|rusty|off [MODE]]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ gpu
#
# Graphics card tuning from /etc/deckos/gpu.conf, applied at boot by deckos-gpu.service: power limit,
# undervolt (voltage offset) and fan curve, straight through amdgpu's sysfs. The undervolt and fan
# curve need amdgpu overdrive (ppfeaturemask). Boot with deckos.gpu=stock to skip all of it. When LACT's
# daemon runs, it owns the card and DecKoOS stays out of its way.

GPU_CONF=$CONF_DIR/gpu.conf
OD_MASK=0xffffffff

gpu_conf() {
  POWER_PERCENT=100 VOLTAGE_OFFSET=0 FAN=stock
  # shellcheck source=/dev/null
  [[ -r $GPU_CONF ]] && . "$GPU_CONF"
}

gpu_hwmon() { local h; for h in "$1"/device/hwmon/hwmon*; do [[ -d $h ]] && { echo "$h"; return 0; }; done; return 1; }
gpu_od_on() { (( $(cat /sys/module/amdgpu/parameters/ppfeaturemask 2>/dev/null || echo 0) & 0x4000 )); }

gpu_status() {  # key=value, no root
  local card hw dev
  card=$(dgpu_card) || { echo "card="; return 0; }
  dev=$card/device; hw=$(gpu_hwmon "$card") || hw=""
  gpu_conf
  w() { local v; v=$(cat "$hw/$1" 2>/dev/null) && echo $((v / 1000000)) || echo 0; }
  printf 'card=%s\n' "$(basename "$card")"
  printf 'cap=%s\ncap_default=%s\ncap_min=%s\ncap_max=%s\n' "$(w power1_cap)" "$(w power1_cap_default)" "$(w power1_cap_min)" "$(w power1_cap_max)"
  printf 'od=%s\nfan_curve=%s\n' "$(gpu_od_on && echo 1 || echo 0)" "$([[ -e $dev/gpu_od/fan_ctrl/fan_curve ]] && echo 1 || echo 0)"
  printf 'power_percent=%s\nvoltage_offset=%s\nfan=%s\n' "$POWER_PERCENT" "$VOLTAGE_OFFSET" "$FAN"
  printf 'lact=%s\n' "$(systemctl is-active --quiet lactd 2>/dev/null && echo 1 || echo 0)"
}

gpu_fan_curve() {  # gpu_fan_curve DEV stock|quiet|cool
  local f=$1/gpu_od/fan_ctrl/fan_curve preset=$2 tmin=25 tmax=100 smin=15 smax=100 i t s
  [[ -w $f ]] || return 0
  if [[ $preset == stock ]]; then echo r > "$f" 2>/dev/null; echo c > "$f" 2>/dev/null || true; return 0; fi
  # Clamp to the card's own limits ("FAN_CURVE(hotspot temp): 25C 100C", "FAN_CURVE(fan speed): 15% 100%").
  read -r tmin tmax < <(sed -n 's/.*FAN_CURVE(hotspot temp): *\([0-9]*\)C *\([0-9]*\)C.*/\1 \2/p' "$f") || true
  read -r smin smax < <(sed -n 's/.*FAN_CURVE(fan speed): *\([0-9]*\)% *\([0-9]*\)%.*/\1 \2/p' "$f") || true
  local -a temps=(45 60 70 80 90) speeds
  case $preset in
    quiet) speeds=(15 25 40 60 85) ;;
    cool)  speeds=(30 45 60 80 100) ;;
    *) warn "unknown fan preset $preset"; return 0 ;;
  esac
  for i in 0 1 2 3 4; do
    t=$(( temps[i] < ${tmin:-25} ? ${tmin:-25} : temps[i] > ${tmax:-100} ? ${tmax:-100} : temps[i] ))
    s=$(( speeds[i] < ${smin:-15} ? ${smin:-15} : speeds[i] > ${smax:-100} ? ${smax:-100} : speeds[i] ))
    echo "$i $t $s" > "$f" 2>/dev/null || { warn "the card refused fan point $i ($t°C, $s%)"; return 0; }
  done
  echo c > "$f" 2>/dev/null || warn "the card refused the fan curve"
}

gpu_apply() {
  need_root gpu apply
  grep -qw 'deckos.gpu=stock' /proc/cmdline && { warn "deckos.gpu=stock: leaving the card at stock"; return 0; }
  systemctl is-active --quiet lactd 2>/dev/null && { sub "LACT manages the graphics card; DecKoOS tuning skipped"; return 0; }
  local card dev hw def min max cap
  card=$(dgpu_card) || { sub "no AMD graphics card: DecKoOS tuning is for Radeon cards (LACT handles others)"; return 0; }
  dev=$card/device
  gpu_conf
  if hw=$(gpu_hwmon "$card") && [[ -w $hw/power1_cap ]]; then
    def=$(cat "$hw/power1_cap_default"); min=$(cat "$hw/power1_cap_min" 2>/dev/null || echo 0); max=$(cat "$hw/power1_cap_max")
    cap=$(( def / 100 * POWER_PERCENT ))
    (( cap < min )) && cap=$min; (( cap > max )) && cap=$max
    echo "$cap" > "$hw/power1_cap" && ok "power limit $((cap / 1000000)) W"
  fi
  if [[ $VOLTAGE_OFFSET != 0 ]] || [[ -w $dev/pp_od_clk_voltage ]]; then
    if gpu_od_on && [[ -w $dev/pp_od_clk_voltage ]]; then
      { echo "vo $VOLTAGE_OFFSET" > "$dev/pp_od_clk_voltage" && echo c > "$dev/pp_od_clk_voltage"; } 2>/dev/null \
        && ok "voltage offset ${VOLTAGE_OFFSET} mV" || warn "the card refused a ${VOLTAGE_OFFSET} mV offset"
    elif [[ $VOLTAGE_OFFSET != 0 ]]; then
      warn "undervolting needs overdrive: deckos gpu overdrive on, then restart"
    fi
  fi
  gpu_od_on && gpu_fan_curve "$dev" "$FAN"
  [[ $FAN != stock ]] && ! gpu_od_on && warn "fan curves need overdrive: deckos gpu overdrive on, then restart"
  return 0
}

gpu_set() {  # gpu_set KEY=VALUE... (POWER_PERCENT, VOLTAGE_OFFSET, FAN)
  need_root gpu set
  gpu_conf
  local kv
  for kv in "$@"; do
    case $kv in
      POWER_PERCENT=*) POWER_PERCENT=${kv#*=}; [[ $POWER_PERCENT =~ ^[0-9]+$ ]] && (( POWER_PERCENT >= 50 && POWER_PERCENT <= 130 )) \
                         || { err "POWER_PERCENT is 50-130"; exit 2; } ;;
      VOLTAGE_OFFSET=*) VOLTAGE_OFFSET=${kv#*=}; [[ $VOLTAGE_OFFSET =~ ^-?[0-9]+$ ]] && (( VOLTAGE_OFFSET >= -150 && VOLTAGE_OFFSET <= 0 )) \
                         || { err "VOLTAGE_OFFSET is -150 to 0 (mV)"; exit 2; } ;;
      FAN=*) FAN=${kv#*=}; [[ $FAN =~ ^(stock|quiet|cool)$ ]] || { err "FAN is stock, quiet or cool"; exit 2; } ;;
      *) err "unknown setting $kv"; exit 2 ;;
    esac
  done
  mkdir -p "$CONF_DIR"
  cat > "$GPU_CONF" <<EOF
# DecKoOS graphics card tuning (DecKoOS Hub > Gaming > Graphics card). Applied at boot by
# deckos-gpu.service. Boot with deckos.gpu=stock (press e in GRUB) to skip it once.
POWER_PERCENT=$POWER_PERCENT
VOLTAGE_OFFSET=$VOLTAGE_OFFSET
FAN=$FAN
EOF
  gpu_apply
}

gpu_overdrive() {  # on|off: amdgpu.ppfeaturemask on the kernel command line (needs a restart)
  need_root gpu overdrive
  [[ $1 == off ]] || dgpu_card >/dev/null || { err "overdrive is an AMD setting; this PC has no AMD graphics card"; exit 1; }
  [[ -f $GRUB_DEFAULT ]] || { err "$GRUB_DEFAULT not found"; exit 1; }
  local cur kept=() tok
  cur=$(sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"$/\1/p' "$GRUB_DEFAULT")
  for tok in $cur; do [[ $tok == amdgpu.ppfeaturemask=* ]] || kept+=("$tok"); done
  [[ $1 == on ]] && kept+=("amdgpu.ppfeaturemask=$OD_MASK")
  sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"${kept[*]}\"|" "$GRUB_DEFAULT"
  grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
  ok "overdrive $1 from the next start"
}

gpu_cmd() {
  case ${1:-status} in
    status) gpu_status ;;
    apply) gpu_apply ;;
    set) shift; gpu_set "$@" ;;
    reset) gpu_set POWER_PERCENT=100 VOLTAGE_OFFSET=0 FAN=stock ;;
    overdrive) [[ ${2:-} =~ ^(on|off)$ ]] || { err "usage: deckos gpu overdrive on|off"; exit 2; }; gpu_overdrive "$2" ;;
    *) err "usage: deckos gpu [status|apply|set KEY=VALUE...|reset|overdrive on|off]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ controllers

controllers_pair() {  # put every Xbox wireless dongle (xone) into pairing mode for 30 seconds
  need_root controllers pair
  local p n=0
  for p in /sys/bus/usb/drivers/xone-dongle/*/pairing; do
    [[ -w $p ]] || continue
    echo 1 > "$p" && n=$((n + 1))
  done
  (( n )) && ok "pairing: press the pair button on the controller now" || { err "no Xbox wireless dongle found"; exit 1; }
}

# ------------------------------------------------------------------ auto-update
#
# Overnight updates (deckos-auto-update.timer, 04:00): skipped while a game runs. Snapshots before and
# after, like any update. The result goes to /var/lib/deckos/auto-update for DecKoOS Hub.

AUTO_STATE=/var/lib/deckos/auto-update

auto_update_run() {
  need_root auto-update run
  mkdir -p "${AUTO_STATE%/*}"
  if pgrep -f '/steamapps/common/|SteamLaunch|gamescope-session' >/dev/null; then
    printf 'when=%s\nresult=skipped\nwhy=a game or Gaming Mode was running\n' "$(date +%s)" > "$AUTO_STATE"
    return 0
  fi
  local n rc=0
  n=$( (checkupdates 2>/dev/null || true) | grep -c . || true)
  pacman -Syu --noconfirm --noprogressbar >> /var/log/deckos-auto-update.log 2>&1 || rc=$?
  if command -v flatpak >/dev/null; then flatpak update -y --noninteractive >> /var/log/deckos-auto-update.log 2>&1 || true; fi
  printf 'when=%s\nresult=%s\ncount=%s\nwhy=%s\n' "$(date +%s)" "$([[ $rc == 0 ]] && echo ok || echo failed)" "$n" \
    "$([[ $rc == 0 ]] || echo "pacman stopped (see /var/log/deckos-auto-update.log)")" > "$AUTO_STATE"
  return "$rc"
}

auto_update_cmd() {
  case ${1:-status} in
    status)
      printf 'enabled=%s\n' "$(systemctl is-enabled --quiet deckos-auto-update.timer 2>/dev/null && echo 1 || echo 0)"
      cat "$AUTO_STATE" 2>/dev/null || true ;;
    on) need_root auto-update on; systemctl enable --now deckos-auto-update.timer >/dev/null 2>&1; ok "overnight updates on (04:00)" ;;
    off) need_root auto-update off; systemctl disable --now deckos-auto-update.timer >/dev/null 2>&1; ok "overnight updates off" ;;
    run) auto_update_run ;;
    *) err "usage: deckos auto-update [status|on|off|run]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ update channel
#
# Every DecKoOS release goes to the "repo-testing" release first; "repo" (stable) only changes when a
# tried release is promoted. A PC's channel is just the last part of the Server line in its
# deckos-repo file (a backup= file, so updates keep it), which keeps forks' owner/repo as they are.

REPO_CONF=/etc/pacman.d/deckos-repo

channel_now() {
  local release
  release=$(sed -n 's|^Server *= *.*/releases/download/\([^/[:space:]]*\)[[:space:]]*$|\1|p' "$REPO_CONF" 2>/dev/null | head -n1)
  case $release in
    repo) echo stable ;;
    repo-testing) echo testing ;;
    '') echo none ;;
    *) echo "custom ($release)" ;;
  esac
}

channel_cmd() {
  local want=${1:-status} now release url
  now=$(channel_now)
  case $want in
    status) printf 'channel=%s\n' "$now"; return 0 ;;
    stable) release=repo ;;
    testing) release="repo-testing" ;;
    *) err "usage: deckos channel [status|stable|testing]"; exit 2 ;;
  esac
  need_root channel "$want"
  [[ $now == stable || $now == testing ]] \
    || { err "$REPO_CONF doesn't point at a DecKoOS release ($now): fix its Server line by hand"; exit 1; }
  [[ $now != "$want" ]] || { ok "already on the $want channel"; return 0; }
  url=$(sed -n 's|^Server *= *\(.*/releases/download/\)[^/[:space:]]*[[:space:]]*$|\1|p' "$REPO_CONF" | head -n1)$release
  # Don't point pacman at a repo that isn't there: every update would fail on it.
  curl -fsIL --max-time 20 -o /dev/null "$url/deckos.db" \
    || { err "the $want channel isn't reachable ($url/deckos.db): nothing changed"; exit 1; }
  sed -i "s|^\(Server *= *.*/releases/download/\)[^/[:space:]]*[[:space:]]*$|\1$release|" "$REPO_CONF"
  ok "DecKoOS updates now come from the $want channel"
  if [[ $want == testing ]]; then
    sub "New releases arrive here first. Run 'deckos update' to get the latest."
  else
    sub "Packages already newer than stable stay until stable catches up."
  fi
}

# ------------------------------------------------------------------ workload modes
#
# A PC that games, builds and runs local AI has them fight over the same graphics memory and CPU.
# deckos-modes.service (a user service) watches for a game and, while one runs, unloads Ollama's
# models from graphics memory, pauses Docker containers and suspends file indexing; it puts back what
# it paused when the game ends. Settings in ~/.config/deckos/modes.conf; the state in
# $XDG_RUNTIME_DIR/deckos-mode is what Quick Settings shows.

MODES_CONF=$HOME/.config/deckos/modes.conf
MODE_STATE=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/deckos-mode

mode_conf() {  # mode_conf KEY DEFAULT
  local v
  v=$(sed -n "s/^$1=//p" "$MODES_CONF" 2>/dev/null | tail -n1)
  echo "${v:-$2}"
}

mode_conf_set() {  # mode_conf_set KEY VALUE
  mkdir -p "${MODES_CONF%/*}"
  touch "$MODES_CONF"
  sed -i "/^$1=/d" "$MODES_CONF"
  echo "$1=$2" >> "$MODES_CONF"
}

steam_game_name() {  # steam_game_name APPID: the name from its app manifest, in any Steam library
  local steam=$HOME/.local/share/Steam lib m
  while IFS= read -r lib; do
    m=$lib/steamapps/appmanifest_$1.acf
    [[ -r $m ]] && { sed -n 's/^\s*"name"\s*"\(.*\)"/\1/p' "$m" | head -n1; return; }
  done < <(sed -n 's/^\s*"path"\s*"\(.*\)"/\1/p' "$steam/steamapps/libraryfolders.vdf" 2>/dev/null || true; echo "$steam")
}

mode_game() {  # the game running now as ID<TAB>NAME, or nothing: Steam games (reaper: the App ID), Lutris, Gaming Mode
  local line id name
  # Anchored on the program itself, so a shell or editor whose command line mentions one doesn't count
  line=$(pgrep -a -u "$(id -u)" -f \
    '^[^ ]*reaper SteamLaunch AppId=[0-9]+|^[^ ]*lutris-wrapper |^([^ ]*sh )?[^ ]*gamescope-session' | head -n1 || true)
  [[ -n $line ]] || return 0
  case $line in
    *"SteamLaunch AppId="*)
      id=${line#*AppId=}; id=${id%% *}
      name=$(steam_game_name "$id")
      [[ -n $name ]] || { [[ $line == */steamapps/common/* ]] && name=${line#*/steamapps/common/} && name=${name%%/*}; }
      printf '%s\t%s\n' "$id" "${name:-a Steam game}" ;;
    *lutris-wrapper*) name=${line#*lutris-wrapper }; name=${name%% /*}; printf '%s\t%s\n' "$name" "$name" ;;
    *) printf 'gamescope\tGaming Mode\n' ;;
  esac
}

# Tells DecKoOS apps the mode changed (DecKoOS Terminal, ...): org.deckos.Mode.Changed(mode, game) on the
# session bus. The details stay in $MODE_STATE; a signal needs no service, so nobody has to be listening.
mode_announce() {
  busctl --user emit /org/deckos/Mode org.deckos.Mode Changed ss "$1" "${2:-}" >/dev/null 2>&1 || true
}

ollama_url() {
  local h=${OLLAMA_HOST:-127.0.0.1:11434}
  [[ $h == http* ]] || h=http://$h
  echo "$h"
}

profile() { python3 "${DECKOS_PROFILES_DIR:-/usr/lib/deckos/profiles}/profiles.py" "$@" 2>/dev/null || true; }

mode_enter() {  # mode_enter GAME [ID]: free what the game needs, remember what to put back
  local game=$1 gid=${2:-} url ps names="" vram=0 ids="" keep did=() ollama docker
  # The game's own profile decides first (DecKoOS Hub > Games > Profile), then the workload-mode settings
  ollama=$( [[ -n $gid ]] && profile get "$gid" ollama ); ollama=${ollama:-$(mode_conf OLLAMA unload)}
  docker=$( [[ -n $gid ]] && profile get "$gid" docker ); docker=${docker:-$(mode_conf DOCKER pause)}
  url=$(ollama_url)
  if [[ $ollama == unload ]] && ps=$(curl -fsS -m 3 "$url/api/ps" 2>/dev/null); then
    local name size
    while IFS=$'\t' read -r name size; do
      [[ -n $name ]] || continue
      curl -fsS -m 15 "$url/api/generate" -d "$(jq -cn --arg m "$name" '{model: $m, keep_alive: 0}')" >/dev/null 2>&1 \
        && { names+="${names:+ }$name"; vram=$((vram + size)); }
    done < <(jq -r '.models[]? | [.name, (.size_vram // 0)] | @tsv' <<<"$ps" 2>/dev/null || true)
    [[ -n $names ]] && did+=("unloaded $names from graphics memory ($(awk -v b="$vram" 'BEGIN { printf "%.1f GB", b / 1e9 }'))")
  fi
  # Containers labelled deckos.keep=true (a game server, say) keep running.
  if [[ $docker == pause ]] && command -v docker >/dev/null \
     && ids=$(timeout 5 docker ps -q --filter status=running 2>/dev/null); then
    keep=$(timeout 5 docker ps -q --filter label=deckos.keep=true 2>/dev/null || true)
    ids=$(grep -vxF -f <(echo "$keep") <<<"$ids" | grep . | tr '\n' ' ' || true)
    ids=${ids% }
    if [[ -n $ids ]]; then
      # shellcheck disable=SC2086  # one id per word
      if timeout 20 docker pause $ids >/dev/null 2>&1; then did+=("paused $(wc -w <<<"$ids") Docker container(s)"); else ids=""; fi
    fi
  fi
  local baloo=0
  if [[ $(mode_conf BALOO suspend) == suspend ]] && command -v balooctl6 >/dev/null \
     && balooctl6 status 2>/dev/null | grep -qi 'is running'; then
    balooctl6 suspend >/dev/null 2>&1 && baloo=1 && did+=("paused file indexing")
  fi
  printf 'mode=gaming\ngame=%s\ngameid=%s\nsince=%s\nollama=%s\nvram=%s\ndocker=%s\nbaloo=%s\n' \
    "$game" "$gid" "$(date +%s)" "$names" "$vram" "$ids" "$baloo" > "$MODE_STATE.tmp"
  mv "$MODE_STATE.tmp" "$MODE_STATE"
  mode_announce gaming "$game"
  if [[ -n $gid ]]; then
    local p; p=$(profile apply "$gid" "$game")
    [[ -n $p ]] && did+=("$p")
  fi
  if (( ${#did[@]} )) && command -v notify-send >/dev/null; then
    timeout 5 notify-send -a "DecKoOS" -i deckos-hub "Ready for $game" "$(printf '%s\n' "${did[@]^}")" >/dev/null 2>&1 || true
  fi
}

mode_leave() {  # put back what mode_enter paused (Ollama loads models again on its own, when asked)
  [[ $(sed -n 's/^mode=//p' "$MODE_STATE" 2>/dev/null) == gaming ]] || return 0
  local ids baloo
  ids=$(sed -n 's/^docker=//p' "$MODE_STATE")
  baloo=$(sed -n 's/^baloo=//p' "$MODE_STATE")
  # shellcheck disable=SC2086
  [[ -n $ids ]] && { timeout 20 docker unpause $ids >/dev/null 2>&1 || true; }
  [[ $baloo == 1 ]] && { balooctl6 resume >/dev/null 2>&1 || true; }
  printf 'mode=normal\n' > "$MODE_STATE"
  profile restore >/dev/null
  mode_announce normal
}

# While a game runs, the desktop wears its colours (from its Steam art: vibes/gamecolours.py): the widgets and the
# taskbar, on whatever screen the game isn't on. Only when DecKoOS reacts (style.conf react=on); a taskbar with
# colours the person picked keeps them. Off puts the Vibe's colours back (or DecKoOS's own), and the taskbar's mode.
GAME_COLOURS=${XDG_RUNTIME_DIR:-/tmp}/deckos-game-colours
game_colours() {  # APPID on | "" off
  local a b mode
  if [[ $2 == on ]]; then
    grep -qs '^react=on' "${XDG_CONFIG_HOME:-$HOME/.config}/deckos/style.conf" || return 0
    [[ $1 =~ ^[0-9]+$ ]] || return 0
    read -r a b < <(QT_QPA_PLATFORM=offscreen python3 "${DECKOS_VIBES_DIR:-/usr/lib/deckos/vibes}/gamecolours.py" "$1" 2>/dev/null || true)
    [[ $a =~ ^#[0-9A-F]{6}$ && $b =~ ^#[0-9A-F]{6}$ ]] || return 0
    mode=$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
      var m = 'accent'; panels().forEach(function (p) { p.widgets('org.deckos.taskbar').forEach(function (w) {
        w.currentConfigGroup = ['General']; m = w.readConfig('colorMode', 'accent'); }); }); print(m);" 2>/dev/null || true)
    echo "${mode:-accent}" > "$GAME_COLOURS"
    vibe_widgets_style "$(cat "$VIBE_STATE" 2>/dev/null || echo deckos)" "$a" "$b"
    [[ $mode == custom ]] || taskbar_script "w.writeConfig('colorA', '$a'); w.writeConfig('colorB', '$b'); w.writeConfig('colorMode', 'vibe')" 2>/dev/null || true
  elif [[ -f $GAME_COLOURS ]]; then
    mode=$(cat "$GAME_COLOURS"); rm -f "$GAME_COLOURS"
    a=$(python3 "$VIBES" get "$(cat "$VIBE_STATE" 2>/dev/null)" 2>/dev/null | sed -n 's/^colorA=//p' || true)
    b=$(python3 "$VIBES" get "$(cat "$VIBE_STATE" 2>/dev/null)" 2>/dev/null | sed -n 's/^colorB=//p' || true)
    vibe_widgets_style "$(cat "$VIBE_STATE" 2>/dev/null || echo deckos)" "${a:-#4C8DFF}" "${b:-#7A5CFF}"
    [[ $mode == custom ]] || taskbar_script "w.writeConfig('colorA', '${a:-#4C8DFF}'); w.writeConfig('colorB', '${b:-#7A5CFF}');
      w.writeConfig('colorMode', '$mode')" 2>/dev/null || true
  fi
}

game_time() {  # SECONDS as "1 h 12 min", "25 min" or "under a minute"
  local s=$(( $1 > 0 ? $1 : 0 )) h m
  h=$(( s / 3600 )) m=$(( s % 3600 / 60 ))
  if (( h )); then echo "$h h $m min"; elif (( m )); then echo "$m min"; else echo "under a minute"; fi
}

mode_watch() {  # deckos-modes.service: a game check every few seconds (pgrep, no polling of anything else)
  [[ $(mode_conf AUTO 1) == 1 ]] || exit 0
  local game gid line misses=0 gaming=0 started=0 played=""
  [[ $(sed -n 's/^mode=//p' "$MODE_STATE" 2>/dev/null) == gaming ]] && gaming=1  # a watcher that didn't get to finish
  trap 'mode_leave; exit 0' TERM INT
  while :; do
    line=$(mode_game)
    gid=${line%%$'\t'*} game=${line#*$'\t'}
    if [[ -n $line ]]; then
      misses=0
      if (( ! gaming )); then
        mode_enter "$game" "$gid"; gaming=1; started=$(date +%s); played=$game
        pulse game-start "Playing $game" --app "Workload modes"
        game_colours "$gid" on
      fi
    elif (( gaming )) && (( ++misses >= 2 )); then  # a launcher that restarts the game isn't the end of it
      mode_leave; gaming=0; misses=0
      game_colours "" off
      # The session's card for the timeline: what, and for how long (the watcher's 10 s of noticing taken off)
      if (( started )); then
        pulse game-stop "Played ${played:-a game} for $(game_time $(( $(date +%s) - started - 10 )))" --app "Workload modes"
      else
        pulse game-stop "Stopped playing" --app "Workload modes"
      fi
      started=0
    fi
    sleep 5 & wait $!
  done
}

mode_status() {  # key=value, no root: for Quick Settings and the Hub
  printf 'auto=%s\n' "$(mode_conf AUTO 1)"
  if [[ -r $MODE_STATE ]]; then cat "$MODE_STATE"; else echo mode=normal; fi
}

mode_cmd() {
  case ${1:-} in
    "")
      section "Workload modes"
      local s; s=$(mode_status)
      if [[ $(sed -n 's/^auto=//p' <<<"$s") != 1 ]]; then warn "off (deckos mode on)"
      elif [[ $(sed -n 's/^mode=//p' <<<"$s") == gaming ]]; then ok "gaming: $(sed -n 's/^game=//p' <<<"$s")"
      else ok "on: waiting for a game"; fi
      sub "Settings: $MODES_CONF (OLLAMA=unload|keep, DOCKER=pause|leave, BALOO=suspend|leave)" ;;
    status) mode_status ;;
    on) mode_conf_set AUTO 1; systemctl --user start deckos-modes.service 2>/dev/null || true; ok "workload modes on" ;;
    off) mode_conf_set AUTO 0; systemctl --user stop deckos-modes.service 2>/dev/null || true; ok "workload modes off" ;;
    watch) mode_watch ;;
    *) err "usage: deckos mode [status|on|off]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ local AI
#
# DecKoOS Assistant (`deckos ask`) and deckos-local (the local model as a Claude Code MCP server) run on
# Ollama. The model comes from ~/.config/deckos/ai.conf, then /etc/deckos/ai.conf, then the first of
# gpt-oss:20b and gemma4:12b that's downloaded (tested on a 16 GB card: gpt-oss:20b follows the tools
# best). Models are many GB, so /var/lib/ollama becomes a subvolume: system snapshots skip it.

AI_DIR=${DECKOS_AI_DIR:-/usr/lib/deckos/assistant}  # a checkout's, for testing
AI_CONF=$CONF_DIR/ai.conf
AI_DEFAULT=gpt-oss:20b

ai_model() { python3 -c "import sys; sys.path.insert(0, '$AI_DIR'); from assistant import pick_model; print(pick_model() or '')"; }

ai_status() {
  section "Local AI"
  if ! systemctl is-active --quiet ollama; then warn "Ollama isn't running (systemctl start ollama, or deckos software add ai)"; return; fi
  local model; model=$(ai_model)
  if [[ -n $model ]]; then ok "model: $model"; else warn "no model downloaded (sudo deckos ai setup)"; fi
  sub "downloaded: $(ollama list 2>/dev/null | awk 'NR > 1 {printf "%s%s", sep, $1; sep=", "}')"
  local loaded; loaded=$(ollama ps 2>/dev/null | awk 'NR > 1 {print $1}' | paste -sd, -)
  sub "loaded now: ${loaded:-nothing}"
  if [[ -d /var/lib/ollama ]] && [[ $(stat -f -c %T /var/lib/ollama) == btrfs ]]; then
    if [[ $(stat -c %i /var/lib/ollama) == 256 ]]; then ok "models are left out of system snapshots"
    else warn "models are in system snapshots (sudo deckos ai setup makes them a subvolume)"; fi
  fi
  local claude; claude=$(command -v claude || echo "$HOME/.local/bin/claude")
  if [[ -x $claude ]]; then
    if "$claude" mcp get deckos-local >/dev/null 2>&1; then ok "Claude Code can use it (deckos-local)"
    else sub "Claude Code isn't linked (deckos ai claude-link)"; fi
  fi
}

ai_setup() {  # sudo deckos ai setup [MODEL]: models out of snapshots, the model for this PC downloaded
  need_root ai setup
  local model=${1:-}
  # No model named: the one this PC's graphics card runs best (deckos ai models shows them all)
  [[ -n $model ]] || model=$(python3 "$AI_DIR/models.py" recommend 2>/dev/null || true)
  model=${model:-$AI_DEFAULT}
  [[ $model =~ ^[A-Za-z0-9._/-]+(:[A-Za-z0-9._-]+)?$ ]] || { err "not a model name: $model"; exit 2; }
  systemctl is-active --quiet ollama || { err "Ollama isn't running (deckos software add ai)"; exit 1; }
  if [[ $(stat -f -c %T /var/lib/ollama 2>/dev/null) == btrfs ]] && [[ $(stat -c %i /var/lib/ollama) != 256 ]]; then
    systemctl stop ollama
    as_subvolume /var/lib/ollama ollama
    systemctl start ollama
    ok "models are left out of system snapshots now"
  fi
  local i  # a restarted Ollama takes a moment before it answers
  for i in $(seq 30); do ollama list >/dev/null 2>&1 && break; sleep 1; done
  [[ -f $AI_CONF ]] || printf '# DecKoOS Assistant and deckos-local (deckos ai model NAME sets yours)\nMODEL=%s\n' "$model" > "$AI_CONF"
  ollama pull "$model"
  ok "$model is ready: deckos ask \"…\""
}

ai_cmd() {
  case ${1:-status} in
    status) ai_status ;;
    setup) shift; ai_setup "$@" ;;
    models) shift; exec python3 "$AI_DIR/models.py" list "$@" ;;
    model)
      [[ -n ${2:-} ]] || { ai_model; return; }
      mkdir -p "$HOME/.config/deckos"
      touch "$HOME/.config/deckos/ai.conf"
      sed -i '/^MODEL=/d' "$HOME/.config/deckos/ai.conf"
      echo "MODEL=$2" >> "$HOME/.config/deckos/ai.conf"
      ok "DecKoOS Assistant uses $2" ;;
    set)  # deckos ai set web on|off / personality friendly|calm|direct|gamer: the Assistant's own settings
      local key value=${3:-}
      case ${2:-} in
        web) key=WEB_SEARCH; [[ $value == on || $value == off ]] || { err "usage: deckos ai set web on|off"; exit 2; } ;;
        personality) key=PERSONALITY
          [[ $value =~ ^(friendly|calm|direct|gamer)$ ]] || { err "usage: deckos ai set personality friendly|calm|direct|gamer"; exit 2; } ;;
        *) err "usage: deckos ai set web on|off | personality friendly|calm|direct|gamer"; exit 2 ;;
      esac
      [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
      mkdir -p "$HOME/.config/deckos" && touch "$HOME/.config/deckos/ai.conf"
      sed -i "/^$key=/d" "$HOME/.config/deckos/ai.conf"
      echo "$key=$value" >> "$HOME/.config/deckos/ai.conf"
      ok "DecKoOS Assistant: ${2} $value" ;;
    claude-link)
      [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
      local claude; claude=$(command -v claude || echo "$HOME/.local/bin/claude")
      [[ -x $claude ]] || { err "Claude Code isn't installed"; exit 1; }
      "$claude" mcp remove --scope user deckos-local >/dev/null 2>&1 || true
      "$claude" mcp add --scope user deckos-local -- python3 "$AI_DIR/deckos_local_mcp.py"
      ok "Claude Code can hand long logs and files to the local model (deckos-local)" ;;
    claude-unlink)
      "$(command -v claude || echo "$HOME/.local/bin/claude")" mcp remove --scope user deckos-local
      ok "deckos-local removed from Claude Code" ;;
    *) err "usage: deckos ai [status|models|setup [MODEL]|model [NAME]|claude-link|claude-unlink]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ desktop layouts
#
# The panel layouts in /usr/share/plasma/layout-templates/org.deckos.layout.* (assets/themes.py):
# the current panels go and the template's take their place. Desktop icons and widgets stay.

LAYOUTS_DIR=/usr/share/plasma/layout-templates

layout_cmd() {
  case ${1:-list} in
    list)
      local d
      for d in "$LAYOUTS_DIR"/org.deckos.layout.*/; do
        [[ -d $d && $d != *.kids/ ]] || continue  # Kid mode's panel isn't one to offer
        printf '  %-10s %s\n' "$(basename "$d" | sed 's/^org.deckos.layout.//')" \
          "$(jq -r '.KPlugin.Description // ""' "$d/metadata.json" 2>/dev/null)"
      done ;;
    set)
      local name=${2:-}
      [[ $name =~ ^[a-z]+$ && -d $LAYOUTS_DIR/org.deckos.layout.$name ]] || { err "no layout called '$name' (deckos layout list)"; exit 2; }
      [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
      # Pinned apps outlive the switch (not into Kid mode: a child's taskbar starts with only their tiles). They're
      # saved to a file first, so a switch that fails halfway, or a first panel without a taskbar, loses nothing.
      local pins_file=${XDG_CONFIG_HOME:-$HOME/.config}/deckos/pins pins
      pins=$(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        var all = [];
        panels().forEach(function (p) { p.widgets('org.deckos.taskbar').forEach(function (w) {
          w.currentConfigGroup = ['General'];
          String(w.readConfig('launchers', '')).split(',').forEach(function (l) {
            if (l && all.indexOf(l) < 0) all.push(l); }); }); });
        print(all.join(','));" 2>/dev/null || true)
      if [[ -n $pins ]]; then mkdir -p "${pins_file%/*}" && printf '%s\n' "$pins" > "$pins_file"
      else pins=$(cat "$pins_file" 2>/dev/null || true); fi
      [[ $name != kids ]] || pins=""
      [[ $pins =~ ^[A-Za-z0-9:/._@%+,-]*$ ]] || pins=""  # app ids only: it goes into a script
      qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        panels().forEach(function (p) { p.remove(); });
        loadTemplate('org.deckos.layout.$name');
        var pins = '$pins';
        if (pins !== '') panels().forEach(function (p) { p.widgets('org.deckos.taskbar').forEach(function (w) {
          w.currentConfigGroup = ['General']; w.writeConfig('launchers', pins.split(',')); w.reloadConfig(); }); });" >/dev/null
      [[ $name == kids || $(cat "$TASKBAR_SCREENS" 2>/dev/null) != all ]] || taskbar_screens all
      ok "desktop layout: $name" ;;
    graphs)
      # DecKoOS Performance on the first screen's desktop, top right (once: a second one isn't added)
      [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
      qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript '
        var d = desktops()[0], g = screenGeometry(d.screen);
        if (d.widgets("org.deckos.perfgraphs").length == 0)
            d.addWidget("org.deckos.perfgraphs", g.width - 444, 40, 404, 300);' >/dev/null
      ok "performance graphs are on your desktop" ;;
    *) err "usage: deckos layout [list|set NAME|graphs]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ taskbar
#
# The DecKoOS taskbar's own settings, on every panel that has one: its height, its colours (the desktop accent,
# the Vibe's, or the person's own, which a Vibe never overrides) and its gentle motion.

taskbar_script() {  # JS run for each DecKoOS taskbar `w` (and its panel `p`)
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    panels().forEach(function (p) { p.widgets('org.deckos.taskbar').forEach(function (w) {
      w.currentConfigGroup = ['General']; $1; w.reloadConfig(); }); });" >/dev/null
}

taskbar_cmd() {
  [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
  case ${1:-} in
    height)
      local px
      case ${2:-} in small) px=40 ;; medium) px=48 ;; large) px=60 ;;
        *) [[ ${2:-} =~ ^[0-9]{2,3}$ ]] && (( $2 >= 28 && $2 <= 120 )) && px=$2 || { err "usage: deckos taskbar height small|medium|large|PIXELS"; exit 2; } ;;
      esac
      taskbar_script "p.height = $px"
      ok "taskbar height: $px px" ;;
    position)  # which edge: the DecKoOS taskbar turns vertical on the sides by itself
      [[ ${2:-} =~ ^(bottom|top|left|right)$ ]] || { err "usage: deckos taskbar position bottom|top|left|right"; exit 2; }
      taskbar_script "p.location = '$2'"
      mkdir -p "${TASKBAR_SCREENS%/*}" && echo "$2" > "${TASKBAR_SCREENS%/*}/taskbar-position"
      ok "taskbar: $2 of the screen" ;;
    colors)
      local mode=${2:-} a=${3:-} b=${4:-}
      case $mode in
        accent|vibe) taskbar_script "w.writeConfig('colorMode', '$mode')" ;;
        custom) [[ $a =~ ^#[0-9A-Fa-f]{6}$ && ( -z $b || $b =~ ^#[0-9A-Fa-f]{6}$ ) ]] || { err "usage: deckos taskbar colors custom '#RRGGBB' ['#RRGGBB']"; exit 2; }
                taskbar_script "w.writeConfig('colorMode', 'custom'); w.writeConfig('colorA', '$a'); w.writeConfig('colorB', '${b:-$a}')" ;;
        *) err "usage: deckos taskbar colors accent|vibe|custom '#RRGGBB' ['#RRGGBB']"; exit 2 ;;
      esac
      ok "taskbar colours: $mode" ;;
    motion)
      [[ ${2:-} == on || ${2:-} == off ]] || { err "usage: deckos taskbar motion on|off"; exit 2; }
      taskbar_script "w.writeConfig('motion', '$([[ $2 == on ]] && echo true || echo false)')"
      ok "taskbar motion: $2" ;;
    screens)
      case ${2:-} in
        all|one) mkdir -p "${TASKBAR_SCREENS%/*}" && printf '%s\n' "$2" > "$TASKBAR_SCREENS"; taskbar_screens "$2"
          # Screens plugged in later get theirs too: deckos-screens follows the kernel's display events
          systemctl --user "$([[ $2 == all ]] && echo enable || echo disable)" --now deckos-screens.service \
            >/dev/null 2>&1 || true
          ok "taskbar: $([[ $2 == all ]] && echo "on every screen (the others show only their windows' icons)" || echo "on the main screen only")" ;;
        "") cat "$TASKBAR_SCREENS" 2>/dev/null || echo one ;;
        follow) taskbar_follow ;;
        *) err "usage: deckos taskbar screens all|one"; exit 2 ;;
      esac ;;
    *) err "usage: deckos taskbar height SIZE | colors accent|vibe|custom COLOR [COLOR] | motion on|off | screens all|one | position EDGE"
       exit 2 ;;
  esac
}

# A taskbar on every screen: the main panel stays as it is; each other screen gets a slim one with only the taskbar
# (that screen's windows and the same pinned apps: no menu, tray or clock), marked so `one` takes only those away.
# Remembered in $TASKBAR_SCREENS, so `deckos layout set` puts them back after replacing the panels.
TASKBAR_SCREENS=${XDG_CONFIG_HOME:-$HOME/.config}/deckos/taskbar-screens

taskbar_follow() {  # deckos-screens.service: a screen came or went, so each screen gets its taskbar again
  [[ $(cat "$TASKBAR_SCREENS" 2>/dev/null) == all ]] || exit 0
  local line
  while read -r line; do
    [[ $line == *change* || $line == *add* || $line == *remove* ]] || continue
    # A plug sends a burst of events and Plasma needs a moment to set the screen up: act once, after it settles
    while read -r -t 4 _; do :; done
    taskbar_screens all
  done < <(udevadm monitor --kernel --subsystem-match=drm 2>/dev/null)
}

taskbar_screens() {
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    var all = '$1' === 'all';
    function tasks(p) { return p.widgets('org.deckos.taskbar'); }
    function extra(p) { return tasks(p).some(function (w) { w.currentConfigGroup = ['General'];
      return String(w.readConfig('deckosExtraScreen', '')) === 'true'; }); }
    panels().forEach(function (p) { if (extra(p)) p.remove(); });
    var main = panels().filter(function (p) { return tasks(p).length > 0; })[0];
    if (main) {
      var mt = tasks(main)[0];
      mt.currentConfigGroup = ['General'];
      // With a taskbar per screen, each shows its own screen's windows
      mt.writeConfig('onlyThisScreen', all ? 'true' : 'false');
      mt.reloadConfig();
      if (all) {
        var pins = mt.readConfig('launchers', ''), used = {};
        panels().forEach(function (p) { used[p.screen] = true; });
        for (var s = 0; s < screenCount; s++) {
          if (used[s]) continue;
          var p = new Panel;
          p.screen = s;
          p.location = main.location;
          p.height = main.height;
          p.floating = main.floating;
          p.lengthMode = main.lengthMode;  // the same dock on every screen
          var t = p.addWidget('org.deckos.taskbar');
          t.currentConfigGroup = ['General'];
          ['colorMode', 'colorA', 'colorB', 'motion', 'lockedPins'].forEach(function (k) {
            var v = mt.readConfig(k, ''); if (String(v) !== '') t.writeConfig(k, v); });
          if (String(pins) !== '') t.writeConfig('launchers', String(pins).split(','));  // a list, read as one string
          t.writeConfig('showLabels', 'false');  // icons only, whatever the main one shows
          t.writeConfig('onlyThisScreen', 'true');
          t.writeConfig('deckosExtraScreen', 'true');
          t.reloadConfig();
        }
      }
    }" >/dev/null
}

# ------------------------------------------------------------------ vibes
#
# A Vibe (vibes.py) is a DecKoOS theme, an accent, the DecKoOS Vibe wallpaper (an animated scene with the music
# visualizer) and DecKoOS apps' corners, applied together as the user. `deckos vibe off` goes back to DecKoOS.

VIBES=${DECKOS_VIBES_LIB:-/usr/lib/deckos/vibes}/vibes.py
VIBE_STATE=${XDG_CONFIG_HOME:-$HOME/.config}/deckos/vibe

vibe_wallpaper() {  # SCENE VISUALIZER COLOR_A COLOR_B [PHOTO LIGHTS GRAIN VIGNETTE CLOCK]: on every screen
  # Every value was checked by vibes.py (colours, a known scene, a photo path without quotes, lights as numbers)
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    desktops().forEach(function (d) {
      d.wallpaperPlugin = 'org.deckos.vibe';
      d.currentConfigGroup = ['Wallpaper', 'org.deckos.vibe', 'General'];
      d.writeConfig('Scene', '$1');
      d.writeConfig('Visualizer', '$2');
      d.writeConfig('ColorA', '$3');
      d.writeConfig('ColorB', '$4');
      d.writeConfig('Photo', '${5:-}');
      d.writeConfig('Lights', '${6:-[]}');
      d.writeConfig('Grain', ${7:-0.05});
      d.writeConfig('Vignette', ${8:-0.5});
      d.writeConfig('Clock', ${9:-true});
    });" >/dev/null
}

vibe_visualizer_remember() {  # what DecKoOS Hub shows as picked
  mkdir -p "${VIBE_STATE%/*}" && echo "$1" > "${VIBE_STATE%/*}/visualizer"
}

vibe_visualizer_service() {  # on|off: the audio side only runs while a visualizer is wanted
  if [[ $1 == on ]]; then systemctl --user enable --now deckos-visualizer.service >/dev/null 2>&1 || true
  else systemctl --user disable --now deckos-visualizer.service >/dev/null 2>&1 || true; fi
}

# The system reacting to music: the dock's islands pulse on the beat and DecKoOS's apps' lit edges and meters breathe
# with it. Each part listens to deckos-visualizer only while something plays; games stop it (the service's own rule).
vibe_react() {  # on|off
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    panels().forEach(function (p) { p.widgets().forEach(function (w) {
      if (['org.deckos.taskbar', 'org.deckos.menu', 'org.deckos.quicksettings'].indexOf(w.type) === -1) return;
      w.currentConfigGroup = ['General']; w.writeConfig('react', '$1' === 'on'); w.reloadConfig(); }); });" \
    >/dev/null 2>&1 || true
  local f=${XDG_CONFIG_HOME:-$HOME/.config}/deckos/style.conf  # the apps read it (hub_style)
  mkdir -p "${f%/*}"
  { grep -sv '^react=' "$f" || true; echo "react=$1"; } > "$f.new" && mv "$f.new" "$f"
  [[ $1 == off ]] || systemctl --user enable --now deckos-visualizer.service >/dev/null 2>&1 || true
}

vibe_style_corners() {  # DecKoOS apps' corners (hub_style's style.conf), keeping the other style keys
  local f=${XDG_CONFIG_HOME:-$HOME/.config}/deckos/style.conf
  mkdir -p "${f%/*}"
  { grep -sv '^corners=' "$f" || true; echo "corners=$1"; } > "$f.new" && mv "$f.new" "$f"
}

VIBE_WIDGETS="org.deckos.bigclock org.deckos.nowplaying org.deckos.weather org.deckos.focus org.deckos.note"
VIBE_WIDGETS+=" org.deckos.calendar org.deckos.countdown org.deckos.photos org.deckos.shelf"

vibe_widgets_style() {  # STYLE COLOR_A COLOR_B: every DecKoOS desktop widget takes the look
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    desktops().forEach(function (d) { d.widgets().forEach(function (w) {
      if (w.type.indexOf('org.deckos.') !== 0) return;
      w.currentConfigGroup = ['General']; w.writeConfig('style', '$1'); w.writeConfig('colorA', '$2');
      w.writeConfig('colorB', '$3'); w.reloadConfig(); }); });" >/dev/null 2>&1 || true
}

# Where the widgets go: one column down the right edge, so the left (where Plasma puts desktop icons) stays free.
# JS for an object {id: [x, y, width, height]} on screen g.
widget_spots() {
  printf '%s' "(function () { var x = g.width - 500, y = 40, out = {};
    [['org.deckos.bigclock', 460, 220], ['org.deckos.weather', 300, 130], ['org.deckos.nowplaying', 440, 140],
     ['org.deckos.focus', 220, 240], ['org.deckos.note', 300, 170], ['org.deckos.calendar', 300, 280],
     ['org.deckos.countdown', 260, 170], ['org.deckos.photos', 360, 240]].forEach(function (w) {
      out[w[0]] = [g.width - 40 - w[1], y, w[1], w[2]]; y += w[2] + 24; });
    out['org.deckos.shelf'] = [40, 40, 420, Math.min(760, g.height - 190)];  // the left: where desktop icons were
    return out; })()"
}

vibe_widgets_arrange() {  # [right|left]: widgets already on the desktop stack down that edge (the desktop reloads)
  python3 "${DECKOS_VIBES_DIR:-/usr/lib/deckos/vibes}/arrange.py" "${1:-right}"
}

# Each Vibe's own sound set (sounds/deckos-SCENE, made by assets/sounds.py), only while the person is on DecKoOS's
# sounds: Plasma's own, another theme or sounds off stay as they are.
vibe_sounds() {  # SCENE (deckos for the plain set; a scene without its own set gets it too)
  local now set=deckos
  now=$(kreadconfig6 --file kdeglobals --group Sounds --key Theme 2>/dev/null || true)
  [[ -z $now || $now == deckos || $now == deckos-* ]] || return 0
  [[ -d /usr/share/sounds/deckos-$1 ]] && set=deckos-$1
  kwriteconfig6 --file kdeglobals --group Sounds --key Theme "$set"
}

# The boot splash in a Vibe's colours: a second Plymouth theme (deckos-vibe) that is DecKoOS's own script with the
# background tinted, its pictures read from the deckos theme. Root, and it rebuilds the initramfs, so it is asked
# for (deckos vibe boot), never done by every vibe apply.
boot_look() {  # vibe COLOR_A COLOR_B | off
  need_root boot-look
  local themes=/usr/share/plymouth/themes top bottom
  local dir=$themes/deckos-vibe
  case ${1:-} in
    vibe)
      [[ ${2:-} =~ ^#[0-9A-Fa-f]{6}$ && ${3:-} =~ ^#[0-9A-Fa-f]{6}$ ]] || { err "usage: deckos boot-look vibe #RRGGBB #RRGGBB | off"; exit 2; }
      top=$(boot_tint "$2" 0.22) bottom=$(boot_tint "$3" 0.12)
      mkdir -p "$dir"
      sed -e "s/^Window.SetBackgroundTopColor(.*/Window.SetBackgroundTopColor($top);/" \
          -e "s/^Window.SetBackgroundBottomColor(.*/Window.SetBackgroundBottomColor($bottom);/" \
          "$themes/deckos/deckos.script" > "$dir/deckos-vibe.script"
      printf '%s\n' "[Plymouth Theme]" "Name=DecKoOS (Vibe)" "Description=DecKoOS's boot splash in your Vibe's colours" \
        "ModuleName=script" "" "[script]" "ImageDir=$themes/deckos" "ScriptFile=$dir/deckos-vibe.script" > "$dir/deckos-vibe.plymouth"
      plymouth-set-default-theme -R deckos-vibe
      ok "the boot screen takes your Vibe's colours from the next start" ;;
    off)
      plymouth-set-default-theme -R deckos
      rm -rf "$dir"
      ok "the boot screen is DecKoOS's own again" ;;
    *) err "usage: deckos boot-look vibe #RRGGBB #RRGGBB | off"; exit 2 ;;
  esac
}

boot_tint() {  # #RRGGBB SHARE: the colour mixed into DecKoOS's slate, as Plymouth's "r, g, b" (0..1)
  local hex=${1#\#} share=$2
  awk -v r=$((16#${hex:0:2})) -v g=$((16#${hex:2:2})) -v b=$((16#${hex:4:2})) -v k="$share" \
    'BEGIN { printf "%.3f, %.3f, %.3f", (r*k + 15*(1-k))/255, (g*k + 17*(1-k))/255, (b*k + 21*(1-k))/255 }'
}

vibe_widget_toggle() {  # ID on|off: add it to the first screen's desktop in its usual spot, or take it away
  local id=$1 on=$2
  [[ " $VIBE_WIDGETS " == *" $id "* ]] || { err "unknown widget: $id ($VIBE_WIDGETS)"; exit 2; }
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    var d = desktops()[0], g = screenGeometry(d.screen), have = d.widgets('$id');
    var spot = $(widget_spots)['$id'];
    if ('$on' === 'on' && have.length === 0) d.addWidget('$id', spot[0], spot[1], spot[2], spot[3]);
    if ('$on' === 'off') have.forEach(function (w) { w.remove(); });" >/dev/null
  [[ $id != org.deckos.shelf ]] || desktop_icons "$([[ $on == on ]] && echo off || echo on)"
}

# Plasma's own icon grid on the desktop: off while the Desktop shelf shows the folder instead. Hidden by a filter
# nothing matches, so the desktop stays a folder view: dropping on the wallpaper or "Create New" still saves to the
# Desktop folder, and the shelf shows it.
desktop_icons() {  # on|off
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    desktops().forEach(function (d) { if (d.type !== 'org.kde.plasma.folder') return;
      d.currentConfigGroup = ['General'];
      d.writeConfig('filterMode', '$1' === 'on' ? 0 : 1); d.writeConfig('filterPattern', 'deckos-shelf-shows-these');
      d.reloadConfig(); });" >/dev/null 2>&1 || true
}

# A download that survives a flaky connection (browsers give up on big files): wget resumes where it stopped and
# retries forever. It arrives in Downloads as NAME.part (the Desktop shelf shows it coming), becomes NAME when done,
# and says so in a notification. Runs on in the background; running it again with the same link resumes it.
download_cmd() {
  local url=${1:-} dir name
  [[ $url =~ ^(https?|ftp)://[^[:space:]]+$ ]] || { err "usage: deckos download URL (http, https or ftp)"; exit 2; }
  dir=$(xdg-user-dir DOWNLOAD 2>/dev/null || echo "$HOME/Downloads"); mkdir -p "$dir"
  name=$(python3 -c 'import sys, urllib.parse as u; p = u.urlparse(sys.argv[1]); n = u.unquote(p.path.rsplit("/", 1)[-1]); print("".join(c for c in n if c not in "/\\\0") or "download")' "$url")
  [[ $name == .* ]] && name="download$name"
  ok "downloading $name into $dir (resumes and retries until it's done)"
  setsid bash -c '
    url=$1 part=$2/$3.part final=$2/$3
    if wget -q -c --tries=0 --retry-connrefused --retry-on-http-error=429,500,502,503,504 --waitretry=10 \
         --timeout=30 --read-timeout=60 -O "$part" -- "$url" && [[ -s $part ]]; then
      mv -n -- "$part" "$final"
      notify-send -a DecKoOS -i download "Downloaded" "$3" 2>/dev/null
    else
      notify-send -a DecKoOS -i dialog-warning "Download stopped" "$3: run the same deckos download again to resume" 2>/dev/null
    fi' _ "$url" "$dir" "$name" </dev/null >/dev/null 2>&1 &
}

vibe_cmd() {
  [[ $EUID -ne 0 || ${1:-} == list ]] || { err "run this as your user"; exit 1; }
  case ${1:-current} in
    list) python3 "$VIBES" list ;;
    current) if [[ -s $VIBE_STATE ]]; then cat "$VIBE_STATE"; else echo "none (DecKoOS)"; fi ;;
    apply)
      local key=${2:-} scene="" visualizer="" colorA="" colorB="" accent="" theme="" corners="" name="" k v was
      local photo="" lights="[]" grain=0.05 vignette=0.5 clock=true
      [[ $key =~ ^[a-z][a-z0-9-]{0,30}$ ]] || { err "usage: deckos vibe apply NAME (deckos vibe list)"; exit 2; }
      while IFS='=' read -r k v; do
        case $k in scene|visualizer|colorA|colorB|accent|theme|corners|name|photo|lights|grain|vignette|clock)
          printf -v "$k" '%s' "$v" ;; esac
      done < <(python3 "$VIBES" get "$key" || true)
      [[ $grain =~ ^[0-9.]+$ && $vignette =~ ^[0-9.]+$ && $clock =~ ^(true|false)$ ]] || { grain=0.05; vignette=0.5; clock=true; }
      [[ -n $scene ]] || { err "no Vibe called '$key' (deckos vibe list)"; exit 2; }
      was=$(cat "$VIBE_STATE" 2>/dev/null || true)
      theme_cmd apply "$theme" >/dev/null
      accent_apply "$accent"
      vibe_wallpaper "$scene" "$visualizer" "$colorA" "$colorB" "$photo" "$lights" "$grain" "$vignette" "$clock"
      # The lock screen shows the Vibe's picture too: your photo, or the scene's own
      local still=${photo:-/usr/share/plasma/wallpapers/org.deckos.vibe/contents/images/$scene.jpg}
      [[ -f $still ]] && lock_wallpaper "$still"
      vibe_sounds "$scene"
      vibe_style_corners "$corners"
      vibe_widgets_style "$key" "$colorA" "$colorB"
      # The taskbar takes the Vibe's colours, unless the person picked their own (theirs always wins)
      taskbar_script "w.writeConfig('colorA', '$colorA'); w.writeConfig('colorB', '$colorB');
        if (w.readConfig('colorMode', 'accent') !== 'custom') w.writeConfig('colorMode', 'vibe')" 2>/dev/null || true
      # The scenes react to the music themselves, so the sound analysis runs whenever a Vibe is on (bars or not)
      vibe_visualizer_service on
      vibe_visualizer_remember "$visualizer"
      mkdir -p "${VIBE_STATE%/*}" && echo "$key" > "$VIBE_STATE"
      pulse vibe "Vibe: $name" --app Appearance --undo deckos vibe "$([[ -n $was ]] && echo "apply $was" || echo off)"
      ok "Vibe: $name" ;;
    visualizer)
      local style=${2:-}
      [[ $style =~ ^(bars|wave|ring|none)$ ]] || { err "usage: deckos vibe visualizer bars|wave|ring|none"; exit 2; }
      qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        desktops().forEach(function (d) { if (d.wallpaperPlugin !== 'org.deckos.vibe') return;
          d.currentConfigGroup = ['Wallpaper', 'org.deckos.vibe', 'General']; d.writeConfig('Visualizer', '$style'); });" >/dev/null
      vibe_visualizer_remember "$style"
      ok "music visualizer: $style" ;;
    moments) python3 "${VIBES%/*}/moments.py" "${@:2}" ;;  # Vibes that change with what you're doing
    export) python3 "$VIBES" export "${2:-}" "${3:-}" >/dev/null && ok "saved: $3 (share it; deckos vibe import opens it)" ;;
    import) key=$(python3 "$VIBES" import "${2:-}") && ok "added your Vibe: $key (deckos vibe apply $key)" ;;
    delete) python3 "$VIBES" delete "${2:-}" && ok "deleted: $2" ;;
    widgets)  # deckos vibe widgets arrange [right|left] | move
      case ${2:-}:${3:-right} in
        arrange:right|arrange:left)
          vibe_widgets_arrange "${3:-right}"
          ok "widgets lined up along the ${3:-right} edge" ;;
        move:*)  # Plasma's own edit mode: drag them anywhere, resize from their edges
          qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.editMode true >/dev/null
          ok "drag widgets where you like; click Done at the top when finished" ;;
        *) err "usage: deckos vibe widgets arrange [right|left] | move"; exit 2 ;;
      esac ;;
    boot)  # deckos vibe boot on|off: the boot screen in this Vibe's colours (asks for the password)
      case ${2:-} in
        on)
          local a b
          a=$(python3 "$VIBES" get "$(cat "$VIBE_STATE" 2>/dev/null)" 2>/dev/null | sed -n 's/^colorA=//p' || true)
          b=$(python3 "$VIBES" get "$(cat "$VIBE_STATE" 2>/dev/null)" 2>/dev/null | sed -n 's/^colorB=//p' || true)
          [[ -n $a && -n $b ]] || { err "turn a Vibe on first"; exit 1; }
          pkexec /usr/bin/deckos boot-look vibe "$a" "$b" ;;
        off) pkexec /usr/bin/deckos boot-look off ;;
        *) err "usage: deckos vibe boot on|off"; exit 2 ;;
      esac ;;
    react)  # deckos vibe react on|off
      [[ ${2:-} == on || ${2:-} == off ]] || { err "usage: deckos vibe react on|off"; exit 2; }
      vibe_react "$2"
      ok "DecKoOS reacting to music: $2 (apps pick it up when they next open)" ;;
    widget)  # deckos vibe widget ID on|off
      [[ ${3:-} == on || ${3:-} == off ]] || { err "usage: deckos vibe widget ID on|off"; exit 2; }
      vibe_widget_toggle "${2:-}" "$3"
      [[ $3 == off ]] || vibe_widgets_style "$(cat "$VIBE_STATE" 2>/dev/null || echo deckos)" \
        "$(python3 "$VIBES" get "$(cat "$VIBE_STATE" 2>/dev/null)" 2>/dev/null | sed -n 's/^colorA=//p' || true)" \
        "$(python3 "$VIBES" get "$(cat "$VIBE_STATE" 2>/dev/null)" 2>/dev/null | sed -n 's/^colorB=//p' || true)"
      ok "desktop widget $2: $3" ;;
    weather)  # deckos vibe weather TOWN: where the Weather widget looks (Open-Meteo's town search)
      local town=${2:-} hit lat lon place
      [[ -n $town && ${#town} -lt 80 ]] || { err "usage: deckos vibe weather TOWN"; exit 2; }
      hit=$(curl -fsS -G "https://geocoding-api.open-meteo.com/v1/search" --data-urlencode "name=$town" \
        --data-urlencode "count=1" | jq -r '.results[0] | "\(.latitude)\t\(.longitude)\t\(.name), \(.country_code)"' 2>/dev/null || true)
      IFS=$'\t' read -r lat lon place <<<"$hit"
      [[ $lat =~ ^-?[0-9.]+$ && $lon =~ ^-?[0-9.]+$ ]] || { err "couldn't find '$town' (offline, or try a bigger town nearby)"; exit 1; }
      place=${place//[\'\"\\]/}
      qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
        desktops().forEach(function (d) { d.widgets('org.deckos.weather').forEach(function (w) {
          w.currentConfigGroup = ['General']; w.writeConfig('latitude', $lat); w.writeConfig('longitude', $lon);
          w.writeConfig('place', '$place'); w.reloadConfig(); }); });" >/dev/null
      mkdir -p "${VIBE_STATE%/*}" && echo "$place" > "${VIBE_STATE%/*}/weather-place"
      ok "weather: $place" ;;
    off)
      theme_cmd apply org.deckos.desktop >/dev/null  # its still wallpaper takes over from the Vibe one
      vibe_style_corners default
      vibe_widgets_style deckos "#4C8DFF" "#7A5CFF"
      vibe_sounds deckos
      taskbar_script "if (w.readConfig('colorMode', 'accent') === 'vibe') w.writeConfig('colorMode', 'accent')" 2>/dev/null || true
      vibe_visualizer_service off
      vibe_visualizer_remember none
      rm -f "$VIBE_STATE"
      pulse vibe "Vibe off: back to DecKoOS" --app Appearance
      ok "back to DecKoOS" ;;
    *) err "usage: deckos vibe [list|current|apply NAME|export NAME FILE|import FILE|delete NAME|visualizer bars|wave|ring|none|widget ID on|off|widgets arrange [right|left]|widgets move|boot on|off|weather TOWN|off]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ kid mode
#
# One account per child: no password, not in wheel (no admin), in deckos-kids. Their settings are root-owned in
# /etc/deckos/kids/NAME.conf (kids.py), so a child can't lift their own limits. Kid mode locks the parent's session
# and shows the login screen, where a child's account needs no password.

KIDS=${DECKOS_KIDS_LIB:-/usr/lib/deckos/kids}/kids.py

kids_conf_set() {  # NAME KEY VALUE: one setting, through kids.py so the file keeps its shape
  python3 - "$KIDS" "$1" "$2" "$3" <<'PY'
import importlib.util, sys
spec = importlib.util.spec_from_file_location("kids", sys.argv[1]); k = importlib.util.module_from_spec(spec)
spec.loader.exec_module(k)
conf = k.read_conf(sys.argv[2]) or dict(k.DEFAULTS)
conf[sys.argv[3]] = sys.argv[4]
k.write_conf(sys.argv[2], conf)
PY
}

kids_add() {
  local name=${1:-} display=${2:-} home
  need_root kids add "$name"
  [[ $name =~ ^[a-z][a-z0-9_-]{1,31}$ ]] || { err "usage: deckos kids add NAME [\"Display name\"]  (lowercase, like mia)"; exit 2; }
  ! id "$name" &>/dev/null || { err "there's already an account called $name"; exit 1; }
  groupadd -f deckos-kids
  useradd -m -c "${display:-$name} (Kid mode)" -G deckos-kids -s /bin/bash "$name"
  passwd -d "$name" >/dev/null  # no password: the login screen lets them straight in
  home=$(getent passwd "$name" | cut -d: -f6)
  kids_conf_set "$name" display "${display:-${name^}}"
  kids_conf_set "$name" apps "$(python3 "$KIDS" suggested)"
  python3 "$KIDS" seed "$name" "$home"
  chown -R "$name:$name" "$home"
  systemctl enable --now deckos-kids-time.service 2>/dev/null || warn "the time limit service didn't start (systemctl status deckos-kids-time)"
  pulse kids "Kid mode: added ${display:-$name}" --app Kids
  ok "${display:-$name} can use Kid mode: their picture is on the login screen, no password"
  sub "Pick their apps and limits in DecKoOS Hub > System > Kids (or: sudo deckos kids apps $name ID,ID...)"
}

kids_remove() {
  local name=${1:-} keep=${2:-}
  need_root kids remove "$name"
  [[ -f /etc/deckos/kids/$name.conf ]] || { err "$name isn't set up for Kid mode (deckos kids list)"; exit 1; }
  id -nG "$name" 2>/dev/null | grep -qw deckos-kids || { err "$name isn't a Kid mode account: not removing it"; exit 1; }
  loginctl terminate-user "$name" 2>/dev/null || true
  if [[ $keep == --keep-files ]]; then userdel "$name"; else userdel -r "$name" 2>/dev/null || userdel "$name"; fi
  rm -f "/etc/deckos/kids/$name.conf"
  ok "$name's account is removed${keep:+ (their files are kept)}"
}

kids_cmd() {
  case ${1:-list} in
    list) python3 "$KIDS" list "${@:2}" ;;
    add) kids_add "${2:-}" "${3:-}" ;;
    remove) kids_remove "${2:-}" "${3:-}" ;;
    apps|limit|bedtime|web|volume|theme|builtin)
      local what=$1 name=${2:-} value=${3:-}
      need_root kids "$what" "$name"
      [[ -f /etc/deckos/kids/$name.conf ]] || { err "$name isn't set up for Kid mode (deckos kids list)"; exit 1; }
      case $what in
        apps) [[ $value =~ ^[A-Za-z0-9._,-]*$ ]] || { err "usage: deckos kids apps NAME ID,ID,..."; exit 2; }
              kids_conf_set "$name" apps "$value" ;;
        limit) [[ $value =~ ^[0-9]{1,4}$ ]] || { err "usage: deckos kids limit NAME MINUTES  (0: no limit)"; exit 2; }
               kids_conf_set "$name" minutes "$value" ;;
        bedtime) [[ -z $value || $value =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]] || { err "usage: deckos kids bedtime NAME HH:MM  (empty: none)"; exit 2; }
                 kids_conf_set "$name" bedtime "$value" ;;
        volume) [[ $value =~ ^[0-9]{1,3}$ ]] && (( value >= 10 && value <= 100 )) || { err "usage: deckos kids volume NAME PERCENT  (10-100)"; exit 2; }
                kids_conf_set "$name" volume "$value" ;;
        theme) [[ $value =~ ^(space|ocean|dinos|castle|rainbow)$ ]] || { err "usage: deckos kids theme NAME space|ocean|dinos|castle|rainbow"; exit 2; }
               kids_conf_set "$name" theme "$value" ;;
        builtin) [[ $value == on || $value == off ]] || { err "usage: deckos kids builtin NAME on|off  (DecKoOS's own games)"; exit 2; }
                 kids_conf_set "$name" builtin "$value" ;;
        web) [[ $value == filtered || $value == open || $value == off ]] || { err "usage: deckos kids web NAME filtered|open|off"; exit 2; }
             kids_conf_set "$name" web "$value"
             python3 "$KIDS" seed "$name" "$(getent passwd "$name" | cut -d: -f6)"
             chown -R "$name:$name" "$(getent passwd "$name" | cut -d: -f6)/.mozilla" ;;
      esac
      ok "$name: $what updated" ;;
    games)  # share these retro games (paths in your Retro library) with every child; none: stop sharing
      need_root kids games
      local f
      for f in "${@:2}"; do [[ -f $f && $f == /home/* ]] || { err "not a game in a home folder: $f"; exit 2; }; done
      python3 "$KIDS" sync-games "${@:2}"
      mkdir -p /srv/deckos-kids && chgrp -R deckos-kids /srv/deckos-kids && chmod -R g+rX,o-rwx /srv/deckos-kids
      ok "shared with Kid mode: $(( $# - 1 )) game(s)" ;;
    refresh)  # rewrite a child's Kid mode settings in their home (after a DecKoOS update changed them)
      local name=${2:-} home
      need_root kids refresh "$name"
      [[ -f /etc/deckos/kids/$name.conf ]] || { err "$name isn't set up for Kid mode (deckos kids list)"; exit 1; }
      home=$(getent passwd "$name" | cut -d: -f6)
      python3 "$KIDS" seed "$name" "$home"
      chown -R "$name:$name" "$home/.config" "$home/.mozilla"
      ok "$name's Kid mode settings are up to date (from their next login)" ;;
    start)  # Kid mode now: lock this session, show the login screen (the parent's password brings this back)
      [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
      loginctl lock-session 2>/dev/null || true
      busctl call org.freedesktop.DisplayManager /org/freedesktop/DisplayManager/Seat0 \
        org.freedesktop.DisplayManager.Seat SwitchToGreeter >/dev/null
      ok "Kid mode: your session is locked; pick a child on the login screen" ;;
    *) err "usage: deckos kids [list|add NAME [DISPLAY]|remove NAME [--keep-files]|apps NAME IDS|limit NAME MIN|bedtime NAME HH:MM|web NAME filtered|open|off|volume NAME PCT|refresh NAME|games [PATH...]|start]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ retro games
#
# DecKoOS Retro's installs: emulators only (RetroArch and libretro cores from the repos, standalone ones from
# Flathub). It never downloads games or BIOS files.

retro_cmd() {
  case ${1:-} in
    install)
      shift
      local pac=() flat=() p
      for p in "$@"; do
        if [[ $p =~ ^(retroarch|libretro-[a-z0-9-]+)$ ]]; then pac+=("$p")
        elif [[ $p =~ ^(net\.pcsx2\.PCSX2|org\.DolphinEmu\.dolphin-emu|org\.ppsspp\.PPSSPP|org\.duckstation\.DuckStation)$ ]]; then flat+=("$p")
        else err "not an emulator DecKoOS Retro installs: $p"; exit 2; fi
      done
      [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
      if ((${#pac[@]})); then pkexec pacman -S --needed --noconfirm "${pac[@]}" || { err "the emulators didn't install"; exit 1; }; fi
      if ((${#flat[@]})); then
        flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
        flatpak install --user -y --noninteractive flathub "${flat[@]}" || { err "the Flathub emulators didn't install"; exit 1; }
      fi
      ok "emulators installed: ${pac[*]} ${flat[*]}" ;;
    *) exec deckos-retro "$@" ;;
  esac
}

# ------------------------------------------------------------------ global themes
#
# Plasma 6's plasma-apply-lookandfeel --apply leaves the colours and wallpaper alone unless it also
# resets the panels, so apply the theme's colour scheme, accent and wallpaper from its defaults file.

theme_default() {  # defaults file, [group][...] header, key
  awk -v g="$2" -v k="$3" '/^\[/ {in_g = ($0 == g); next} in_g && index($0, k "=") == 1 {print substr($0, length(k) + 2); exit}' "$1"
}

# The accent colour: Plasma's (widgets, selections, the DecKoOS panel widgets) and the icons'. The DecKoOS
# folder and app icons are rewritten in the accent as a user icon theme (/usr/lib/deckos/accent-icons),
# applied only while a DecKoOS icon theme is in use: a user's own icon theme is left alone.
accent_apply() {
  local color=$1 icons light="" style
  plasma-apply-colorscheme --accent-color "$color" >/dev/null
  # That bakes the accent into the colours but leaves AccentColor at /etc/xdg's blue: the Hub, Welcome
  # and Quick Settings read it, so save it like Plasma's Colours settings do
  kwriteconfig6 --file kdeglobals --group General --key AccentColor \
    "$((16#${color:1:2})),$((16#${color:3:2})),$((16#${color:5:2}))"
  icons=$(kreadconfig6 --file kdeglobals --group Icons --key Theme)
  if [[ -z $icons || $icons == DeckOS || $icons == DeckOS-* ]]; then
    local bg; bg=$(kreadconfig6 --file kdeglobals --group Colors:Window --key BackgroundNormal)
    if [[ $bg =~ ^([0-9]+),([0-9]+),([0-9]+)$ ]] && ((BASH_REMATCH[1] + BASH_REMATCH[2] + BASH_REMATCH[3] > 382)); then
      light=--light
    fi
    if icons=$(/usr/lib/deckos/accent-icons "$color" $light); then
      /usr/lib/plasma-changeicons "$icons" >/dev/null 2>&1 || true
    else
      warn "the icons couldn't be recoloured"
    fi
  fi
  # Never restart Plasma for this: its service allows 3 starts a minute, and a theme change plus an
  # accent change used them up and left the screens black. Instead, Plasma's widgets take the accent
  # when their style is applied again (via another one), and the DecKoOS taskbar remakes its tiles
  # (with the new icons) when its iconEpoch changes.
  style=$(plasma-apply-desktoptheme --list-themes 2>/dev/null | sed -n 's/^ \* \(.*\) (current theme.*/\1/p')
  if [[ -n $style ]]; then
    plasma-apply-desktoptheme "$([[ $style == breeze-dark ]] && echo default || echo breeze-dark)" >/dev/null 2>&1
    plasma-apply-desktoptheme "$style" >/dev/null 2>&1 || true
  fi
  qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    panels().forEach(function (p) { p.widgets('org.deckos.taskbar').forEach(function (w) {
      w.currentConfigGroup = ['General']; w.writeConfig('iconEpoch', $(date +%s) % 1000000000); }); });" >/dev/null 2>&1 || true
}

accent_cmd() {
  case ${1:-} in
    apply)
      [[ ${2:-} =~ ^#[0-9A-Fa-f]{6}$ ]] || { err "usage: deckos accent apply '#RRGGBB'"; exit 2; }
      [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
      local was
      was=$(kreadconfig6 --file kdeglobals --group General --key AccentColor 2>/dev/null || true)
      accent_apply "$2"
      if [[ $was =~ ^([0-9]+),([0-9]+),([0-9]+)$ ]]; then
        pulse accent "Accent colour changed" --app Appearance --undo deckos accent apply \
          "$(printf '#%02X%02X%02X' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")"
      else
        pulse accent "Accent colour changed" --app Appearance
      fi
      ok "accent: $2" ;;
    *) err "usage: deckos accent apply '#RRGGBB'"; exit 2 ;;
  esac
}

# The desktop and the lock screen show the same picture: Plasma 6 keeps the lock screen's in kscreenlockerrc,
# and without one it shows Plasma's stock wallpaper rather than DecKoOS's.
lock_wallpaper() {
  local uri=$1
  [[ $uri == /* ]] && uri="file://$uri"
  kwriteconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin org.kde.image
  kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General \
    --key Image "$uri"
  kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General \
    --key PreviewImage "$uri"
}

wallpaper_apply() {
  [[ -e $1 ]] || { err "no such wallpaper: $1"; exit 1; }
  plasma-apply-wallpaperimage "$1" >/dev/null
  lock_wallpaper "$(realpath "$1")"
}

wallpaper_cmd() {
  case ${1:-} in
    "") err "usage: deckos wallpaper IMAGE|FOLDER   (the desktop and the lock screen)"; exit 2 ;;
    --lock-only) [[ -e ${2:-} ]] || { err "usage: deckos wallpaper --lock-only IMAGE"; exit 2; }
                 lock_wallpaper "$(realpath "$2")"; ok "lock screen: $(basename "$2")" ;;
    *) wallpaper_apply "$1"; ok "wallpaper: $(basename "$1") (desktop and lock screen)" ;;
  esac
}

theme_cmd() {
  case ${1:-} in
    apply)
      local id=${2:-} d=""
      [[ $id =~ ^[A-Za-z0-9._-]+$ ]] || { err "usage: deckos theme apply ID"; exit 2; }
      [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
      for d in "${XDG_DATA_HOME:-$HOME/.local/share}/plasma/look-and-feel/$id" "/usr/share/plasma/look-and-feel/$id"; do
        [[ -f $d/contents/defaults ]] && break
      done
      [[ -f $d/contents/defaults ]] || { err "no global theme called '$id'"; exit 2; }
      local defaults=$d/contents/defaults scheme accent wall cursor was name
      was=$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null || true)
      name=$(jq -r '.KPlugin.Name // empty' "$d/metadata.json" 2>/dev/null || true)
      plasma-apply-lookandfeel --apply "$id" >/dev/null
      scheme=$(theme_default "$defaults" "[kdeglobals][General]" ColorScheme)
      accent=$(theme_default "$defaults" "[kdeglobals][General]" AccentColor)
      wall=$(theme_default "$defaults" "[Wallpaper]" Image)
      if [[ -n $scheme ]]; then
        # Switch away and back so Plasma reloads the scheme even when its name didn't change
        [[ $(kreadconfig6 --file kdeglobals --group General --key ColorScheme) != "$scheme" ]] ||
          plasma-apply-colorscheme BreezeDark >/dev/null 2>&1 || true
        plasma-apply-colorscheme "$scheme" >/dev/null
      fi
      if [[ $accent =~ ^([0-9]+),([0-9]+),([0-9]+)$ ]]; then
        accent_apply "$(printf '#%02X%02X%02X' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}")"
      fi
      [[ -z $wall || ! -d /usr/share/wallpapers/$wall ]] || wallpaper_apply "/usr/share/wallpapers/$wall" >/dev/null
      cursor=$(theme_default "$defaults" "[kcminputrc][Mouse]" cursorTheme)
      [[ -z $cursor || ! -d /usr/share/icons/$cursor ]] || plasma-apply-cursortheme "$cursor" >/dev/null 2>&1 || true
      if [[ -n $was && $was != "$id" && $was =~ ^[A-Za-z0-9._-]+$ ]]; then
        pulse theme "Theme: ${name:-$id}" --app Appearance --undo deckos theme apply "$was"
      fi
      ok "theme: $id" ;;
    *) err "usage: deckos theme apply ID"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ streaming and Decky

streaming_setup() {  # Sunshine: stream games to a TV, phone or Steam Deck with Moonlight
  [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
  section "Game streaming (Sunshine)"
  if ! command -v sunshine >/dev/null; then
    if command -v paru >/dev/null; then paru -S --needed --noconfirm sunshine; else sudo pacman -S --needed sunshine; fi
  fi
  # Capturing the screen on Wayland/KMS needs this capability on the binary.
  sudo setcap cap_sys_admin+p "$(readlink -f "$(command -v sunshine)")"
  if command -v firewall-cmd >/dev/null && sudo firewall-cmd --state >/dev/null 2>&1; then
    sudo firewall-cmd --permanent --add-port=47984-47990/tcp --add-port=48010/tcp --add-port=47998-48000/udp >/dev/null
    sudo firewall-cmd --reload >/dev/null && ok "firewall: Sunshine's ports open"
  fi
  systemctl --user enable --now sunshine >/dev/null 2>&1 || systemctl --user enable --now app-dev.lizardbyte.app.Sunshine >/dev/null 2>&1 || true
  ok "Sunshine running"
  sub "Pair a device: open https://localhost:47990, then add this PC in Moonlight."
}

decky_install() {  # Decky Loader: Steam Deck plugins inside Gaming Mode
  [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
  section "Decky Loader"
  sub "The official installer from github.com/SteamDeckHomebrew; it asks for your password."
  curl -fsSL https://github.com/SteamDeckHomebrew/decky-installer/releases/latest/download/install_release.sh | sh
  ok "done: open Gaming Mode and press the ... button for the Decky menu"
}

decky_plugin() {  # DecKoOS's own Decky plugin (Gaming Mode's quick access menu), from deckos-settings
  [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
  local src=/usr/share/deckos/decky/DecKoOS dest=$HOME/homebrew/plugins/DecKoOS
  [[ -d $HOME/homebrew/plugins ]] || { err "Decky Loader isn't installed: deckos decky install"; exit 1; }
  section "DecKoOS for Decky"
  sub "Decky's plugin folder belongs to root: it asks for your password."
  sudo rm -rf "$dest"
  sudo cp -r "$src" "$dest"
  sudo systemctl restart plugin_loader.service
  ok "done: in Gaming Mode, press ... and pick the DecKoOS plate"
}

doctor_cmd() {
  section "DecKoOS $VERSION"
  say "  Kernel  $(uname -r)"
  say "  Mesa    $(pacman -Q mesa 2>/dev/null | cut -d' ' -f2)"
  say "  GPUs    $(gpu_vendors | tr '\n' ' ')"
  say "  Boot    $(tr ' ' '\n' < /proc/cmdline | grep -E 'amdgpu|nvidia|zswap|splash' | tr '\n' ' ')"
  if [[ -d /sys/firmware/efi ]]; then
    local sb; sb=$(od -An -t u1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | tr -d ' ')
    [[ $sb == 1 ]] && warn "Secure Boot is ON" || ok "Secure Boot off"
  fi
  display_status
  drives_list
  drives_doctor
  section "Snapshots"
  local snaps
  if [[ ! -f /etc/snapper/configs/root ]]; then warn "system snapshots aren't set up: a bad update can't be rolled back"
  elif ! snaps=$(snapshot_count root); then warn "couldn't read system snapshots (snapper -c root list)"
  elif (( snaps == 0 )); then warn "no system snapshots yet: the next update takes the first ones (snap-pac)"
  else ok "$snaps system snapshots ${C_SUB}(snapper -c root list)${C_0}"; fi
  home_status
  section "Updates"
  if grep -q '^Include = /etc/pacman.d/deckos-repo' /etc/pacman.conf; then ok "DecKoOS update channel on: $(channel_now)"
  else warn "DecKoOS update channel not set up (reinstall deckos-settings, or deckos dev-install)"; fi
  section "Gaming"
  local sch; sch=$(scheduler_status)
  [[ $sch == *state=enabled* ]] && ok "CPU scheduler: $(sed -n 's/^running=//p' <<<"$sch")" || sub "CPU scheduler: the kernel's own (deckos scheduler set lavd)"
  [[ -e /dev/ntsync ]] && ok "NTSYNC available" || warn "NTSYNC missing (/dev/ntsync): Proton falls back to fsync"
  if dgpu_card >/dev/null; then
    gpu_od_on && ok "GPU overdrive on" || sub "GPU overdrive off (deckos gpu overdrive on, for undervolting)"
  fi
  if [[ $(mode_conf AUTO 1) != 1 ]]; then sub "workload modes off (deckos mode on)"
  elif systemctl --user is-active --quiet deckos-modes.service 2>/dev/null; then ok "workload modes on: games get the GPU to themselves"
  else warn "workload modes on, but its service isn't running (systemctl --user start deckos-modes)"; fi
  section "AI"
  systemctl is-active --quiet ollama && ok "ollama running" || sub "ollama stopped (systemctl start ollama)"
  command -v claude >/dev/null || [[ -x $HOME/.local/bin/claude ]] && ok "Claude Code installed" || sub "Claude Code not installed (curl -fsSL https://claude.ai/install.sh | bash)"
}

usage() {
  cat <<EOF
${C_ACC}${C_B}deckos${C_0} $VERSION — DecKoOS system tool

  deckos display [status|levels|set N|watch|monitors|recommend]
                                                        display blackout fix ladder
  deckos drives  [list|rescan|doctor|repair]            your NTFS drives (no reformatting)
  deckos session gaming|desktop                         switch Gaming Mode <-> Desktop
  deckos gaming detect                                  which output Gaming Mode uses
  deckos steam-ntfs                                     make Steam libraries on NTFS work with Proton
  deckos update [--system]                              update everything (with snapshots)
  deckos undo    [list|NUMBER|clean]                   go back to before an update (restart to finish)
  deckos restore NUMBER [PATH...]                       put back files from before a command (snapshot first)
  deckos snapshot-first [status|on|off]                 the terminal offers a snapshot before big deletes
  deckos updates [--cached|--max-age S]                 how many updates are waiting (cached)
  deckos software [list|add GROUP]                      add gaming, ai or dev after install
  deckos home    [status|enable]                        /home snapshots (hourly) and backup status
  deckos backup  [FOLDER]                               copy your home folder to another drive
  deckos dev-install [CHECKOUT] [--downgrade]           build and install DecKoOS from a repo checkout
  deckos spotify [theme|restore]                        the DecKoOS look for Spotify (Spicetify)
  deckos scheduler [status|set lavd|bpfland|off [MODE]] gaming CPU scheduler (sched_ext)
  deckos gpu     [status|set K=V..|reset|overdrive on|off]  power limit, undervolt, fan curve
  deckos controllers pair                               Xbox wireless dongle pairing mode
  deckos auto-update [status|on|off]                    overnight updates (04:00, not mid-game)
  deckos channel [status|stable|testing]                where DecKoOS updates come from (testing: new releases first)
  deckos wallpaper IMAGE|FOLDER                         the desktop and the lock screen together
  deckos heal list|plan ID|apply ID [KEY=VALUE...]     DecKoOS's vetted fixes (root ones: through sudo or pkexec)
  deckos disks [list|verify|startup add|remove UUID|repair UUID|health|format|create|resize|delete]  disks, partitions, start-up
  deckos vibe [list|apply NAME|visualizer STYLE|off]  Vibes: a whole mood in one go, music visualizer included
  deckos vibe react on|off                            the dock and DecKoOS apps pulse with the music playing
  deckos taskbar height|colors|motion ...               the taskbar's size, colours (yours win over a Vibe), motion
  deckos kids [list|add NAME|remove NAME|start|...]     Kid mode: an account per child, approved apps, limits
  deckos download URL                                  a big file that won't give up: resumes and retries until done
  deckos report [--out FILE|--print]                    one file of hardware, drivers and errors for whoever helps
  deckos mode    [status|on|off]                        workload modes: free the GPU and CPU while a game runs
  deckos context [now|set ACTIVITY [MIN]|auto|on|off]  what you're doing now, and DecKoOS adapting to it
  deckos backup make|verify|restore …  your whole home folder in one archive, for a reinstall
  deckos ask     ["what you want"]                      DecKoOS Assistant: install and set things up, locally
  deckos ai      [status|setup|model NAME|claude-link]  the local model, and Claude Code's link to it
  deckos layout  [list|set NAME|graphs]                 desktop layout: dock, classic, topbar, minimal, big;
                                                        graphs adds DecKoOS Performance to the desktop
  deckos do [ID]                                        one of DecKoOS's actions (no ID: the list)
  deckos timeline [list|undo ID]                        what happened on this PC, and undo
  deckos retro [install PKG...]                         DecKoOS Retro (install: its emulators)
  deckos sound [status|buffer NAME|eq PRESET|off|dropouts]  sound: apps by kind, the anti-crackle buffer, equalizer
  deckos selftest [show]                                try what DecKoOS relies on (daily on its own)
  deckos play FOLDER                                    start a game from a folder (Hub > Games > My drives)
  deckos theme apply ID                                 global theme with its colours, accent and wallpaper
  deckos accent apply '#RRGGBB'                         accent colour for Plasma, the DecKoOS widgets and icons
  deckos whatsnew                                       what the latest DecKoOS release brought
  deckos game doctor [last|APPID]                       why a game closed right after starting, and fixes
  deckos work                                          local code, documents and image workspace
  deckos movein                                        bring folders, browser, games and apps over from Windows
  deckos bench   [system|games|run KEYS|compare A B]    DecKoOS Bench: benchmarks with confidence ranges
  deckos streaming setup                                Sunshine game streaming (Moonlight)
  deckos decky install                                  Decky Loader for Gaming Mode
  deckos decky plugin                                   DecKoOS's own panel in Gaming Mode's quick access menu
  deckos doctor                                         health check (the full report)
  deckos sysdoctor                                     Hub > Health: what's wrong, in plain words, with fixes
  deckos hub                                            open DecKoOS Hub
EOF
}

case ${1:-} in
  display) shift; display_cmd "$@" ;;
  drives) shift; drives_cmd "$@" ;;
  session) shift; session_cmd "$@" ;;
  gaming) shift; [[ ${1:-detect} == detect ]] && gaming_detect ;;
  steam-ntfs) steam_ntfs ;;
  update) shift; update_cmd "$@" ;;
  updates) shift; updates_cmd "$@" ;;
  quick-status) quick_status ;;  # for DecKoOS Quick Settings
  software) shift; software_cmd "$@" ;;
  home) shift; home_cmd "$@" ;;
  backup) shift
    # make/verify/restore: the whole-home archive for a reinstall (backup.py); otherwise the everyday mirror
    case ${1:-} in
      plan|make|verify|restore|list) exec python3 "${DECKOS_BACKUP_DIR:-/usr/lib/deckos/backup}/backup.py" "$@" ;;
      *) backup_cmd "$@" ;;
    esac ;;
  dev-install) shift; dev_install "$@" ;;
  spotify) shift; spotify_cmd "$@" ;;
  scheduler) shift; scheduler_cmd "$@" ;;
  gpu) shift; gpu_cmd "$@" ;;
  controllers) shift; if [[ ${1:-} == pair ]]; then controllers_pair; else err "usage: deckos controllers pair"; exit 2; fi ;;
  auto-update) shift; auto_update_cmd "$@" ;;
  channel) shift; channel_cmd "$@" ;;
  wallpaper) shift; wallpaper_cmd "$@" ;;
  heal) shift; exec python3 "${DECKOS_HEAL_DIR:-/usr/lib/deckos/heal}/heal.py" "$@" ;;  # vetted fixes only
  disks) shift; exec python3 "${DECKOS_DISKS_DIR:-/usr/lib/deckos/disks}/disks.py" "$@" ;;
  vibe) shift; vibe_cmd "$@" ;;
  taskbar) shift; taskbar_cmd "$@" ;;
  kids) shift; kids_cmd "$@" ;;
  download) shift; download_cmd "$@" ;;
  report) shift; exec python3 "${DECKOS_REPORT_DIR:-/usr/lib/deckos/report}/deckos_report.py" "$@" ;;  # for whoever helps
  undo) shift; undo_cmd "$@" ;;
  restore) shift; restore_cmd "$@" ;;
  snapshot-first) shift; snapshot_first_cmd "$@" ;;
  mode) shift; mode_cmd "$@" ;;
  context) shift; exec python3 "${DECKOS_CONTEXT_DIR:-/usr/lib/deckos/context}/context.py" "${@:-now}" ;;
  layout) shift; layout_cmd "$@" ;;
  theme) shift; theme_cmd "$@" ;;
  accent) shift; accent_cmd "$@" ;;
  retro) shift; retro_cmd "$@" ;;
  setup)  # take this PC's setup with you: deckos setup export|import FILE, undo STAMP
    shift
    [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
    exec python3 "${DECKOS_SETUP_DIR:-/usr/lib/deckos/setup}/setup.py" "$@" ;;
  profile) shift; exec python3 "${DECKOS_PROFILES_DIR:-/usr/lib/deckos/profiles}/profiles.py" "$@" ;;
  do)  # one of DecKoOS's actions (usr/share/deckos/actions.toml); no ID lists them
    shift
    if [[ -z ${1:-} ]]; then exec python3 "${DECKOS_ACTIONS_DIR:-/usr/lib/deckos/actions}/actions.py" list; fi
    exec python3 "${DECKOS_ACTIONS_DIR:-/usr/lib/deckos/actions}/actions.py" run "$1" ;;
  timeline)  # DecKoOS Pulse: what happened, and undo
    shift
    case ${1:-list} in
      list) exec python3 "${DECKOS_PULSE_DIR:-/usr/lib/deckos/pulse}/pulse.py" list "${@:2}" ;;
      undo) exec python3 "${DECKOS_PULSE_DIR:-/usr/lib/deckos/pulse}/pulse.py" undo "${2:-}" ;;
      *) err "usage: deckos timeline [list|undo ID]"; exit 2 ;;
    esac ;;
  whatsnew) shift; exec deckos-whatsnew "$@" ;;
  gamedoctor)  # the timeline's undo for a fix: deckos gamedoctor undo APPID FIX
    shift
    [[ ${1:-} == undo && ${2:-} =~ ^[0-9]+$ && ${3:-} =~ ^[a-z0-9-]+$ ]] || { err "usage: deckos gamedoctor undo APPID FIX"; exit 2; }
    exec python3 /usr/lib/deckos/gamedoctor/gamedoctor.py undo "$2" "$3" ;;
  game)
    shift
    case ${1:-} in
      doctor) shift; if [[ ${1:-last} == last ]]; then exec deckos-gamedoctor; else exec deckos-gamedoctor --appid "$1"; fi ;;
      *) err "usage: deckos game doctor [last|APPID]"; exit 2 ;;
    esac ;;
  ask) shift; exec python3 "$AI_DIR/deckos_ask.py" "$@" ;;
  work) shift; exec python3 "${DECKOS_WORK_DIR:-/usr/lib/deckos/work}/work_app.py" "$@" ;;
  movein) shift; exec deckos-movein "$@" ;;
  sysdoctor) shift; exec deckos-sysdoctor "$@" ;;
  bench) shift; exec python3 "${DECKOS_BENCH_DIR:-/usr/lib/deckos/bench}/deckos_bench.py" "$@" ;;
  selftest) shift; exec python3 "${DECKOS_SELFTEST_DIR:-/usr/lib/deckos/selftest}/selftest.py" "${@:-run}" ;;
  sound) shift; exec python3 "${DECKOS_SOUND_DIR:-/usr/lib/deckos/sound}/sound.py" "$@" ;;
  play) shift; exec /usr/bin/deckos-play "$@" ;;
  ai) shift; ai_cmd "$@" ;;
  streaming) shift; [[ ${1:-setup} == setup ]] && streaming_setup ;;
  decky) shift
    case ${1:-install} in
      install) decky_install ;;
      plugin) decky_plugin ;;
      *) err "usage: deckos decky [install|plugin]"; exit 2 ;;
    esac ;;
  doctor) doctor_cmd ;;
  boot-look) shift; boot_look "$@" ;;
  hub) exec /usr/bin/deckos-hub ;;
  version|--version) echo "$VERSION" ;;
  ""|help|-h|--help) usage ;;
  *) err "unknown command: $1"; usage; exit 2 ;;
esac
