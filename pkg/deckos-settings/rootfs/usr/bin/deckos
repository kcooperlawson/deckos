#!/usr/bin/env bash
# deckos — DeckOS system tool: display flicker fixes, NTFS drives, session switching, updates.
set -euo pipefail

VERSION=$(cat /usr/share/deckos/version 2>/dev/null || echo rolling)
# systemd services (the CI install test) start without HOME; set -u would stop at the first $HOME below.
HOME=${HOME:-$(getent passwd "$(id -u)" | cut -d: -f6)}
CONF_DIR=/etc/deckos
DISPLAY_CONF=$CONF_DIR/display.conf
GRUB_DEFAULT=/etc/default/grub
FSTAB_BEGIN="# >>> DeckOS drives (managed by 'deckos drives rescan') >>>"
FSTAB_END="# <<< DeckOS drives <<<"
# RX 9070 / 9070 XT (Navi 48). Anything else falls back to the boot VGA AMD card.
DGPU_IDS="0x7550"

if [[ -t 1 ]]; then
  C_ACC=$'\e[38;2;76;141;255m' C_OK=$'\e[38;2;61;214;140m' C_WARN=$'\e[38;2;245;184;75m'
  C_ERR=$'\e[38;2;255;107;107m' C_SUB=$'\e[38;2;140;148;166m' C_B=$'\e[1m' C_0=$'\e[0m'
else
  C_ACC='' C_OK='' C_WARN='' C_ERR='' C_SUB='' C_B='' C_0=''
fi
say()  { printf '%s\n' "$*"; }
section() { printf '\n%s%s// %s%s\n' "$C_ACC" "$C_B" "$*" "$C_0"; }
ok()   { printf '  %s✔%s %s\n' "$C_OK" "$C_0" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$C_0" "$*"; }
err()  { printf '%serror:%s %s\n' "$C_ERR" "$C_0" "$*" >&2; }
sub()  { printf '  %s%s%s\n' "$C_SUB" "$*" "$C_0"; }
need_root() { [[ $EUID -eq 0 ]] || { err "this needs root: sudo deckos $*"; exit 1; }; }

# ---------------------------------------------------------------- GPU helpers

# Graphics vendors in this PC, one per line (amd, nvidia, intel), from PCI display devices so it
# works before any driver is loaded. The installer and the package lists' vendor column use it.
gpu_vendors() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [[ $(cat "$d/class" 2>/dev/null) == 0x03* ]] || continue
    case $(cat "$d/vendor" 2>/dev/null) in
      0x1002) echo amd ;; 0x10de) echo nvidia ;; 0x8086) echo intel ;;
    esac
  done | sort -u
}

# Prints the /sys/class/drm/cardN path of the AMD gaming GPU. The display ladder and deckos gpu are
# amdgpu-only; on other cards they say so and do nothing.
dgpu_card() {
  local c fallback=""
  for c in /sys/class/drm/card[0-9]*; do
    [[ $c =~ card[0-9]+$ ]] || continue
    [[ $(cat "$c/device/vendor" 2>/dev/null) == 0x1002 ]] || continue
    local dev; dev=$(cat "$c/device/device" 2>/dev/null)
    [[ " $DGPU_IDS " == *" $dev "* ]] && { echo "$c"; return 0; }
    [[ $(cat "$c/device/boot_vga" 2>/dev/null) == 1 ]] && fallback=$c
  done
  [[ -n $fallback ]] && { echo "$fallback"; return 0; }
  return 1
}

# Monitor name from an EDID blob (descriptor tag 0xFC).
edid_name() {
  python3 - "$1" <<'PY' 2>/dev/null
import sys
e = open(sys.argv[1], "rb").read()
for off in (54, 72, 90, 108):
    b = e[off:off + 18]
    if len(b) == 18 and b[:3] == b"\0\0\0" and b[3] == 0xFC:
        print(b[5:].split(b"\n")[0].decode("ascii", "replace").strip()); break
PY
}

# The card driving the screens: the AMD gaming GPU, else the boot display card.
display_card() {
  dgpu_card && return 0
  local c
  for c in /sys/class/drm/card[0-9]*; do
    [[ $c =~ card[0-9]+$ && $(cat "$c/device/boot_vga" 2>/dev/null) == 1 ]] && { echo "$c"; return 0; }
  done
  return 1
}

# "CONNECTOR<TAB>MONITOR" for every connected output on the main card.
monitors() {
  local card; card=$(display_card) || return 0
  local base; base=$(basename "$card")
  local o
  for o in /sys/class/drm/"$base"-*; do
    [[ $(cat "$o/status" 2>/dev/null) == connected ]] || continue
    printf '%s\t%s\n' "${o##*/$base-}" "$(edid_name "$o/edid")"
  done
}

# ------------------------------------------------------------- display ladder
#
# The G70B blacks out for a second or two when the 9070 XT changes its memory clock
# while driving a high-bandwidth 4K144 signal plus a second screen. Each level removes
# another source of those clock/power-state changes, at the cost of some idle power.

LEVEL_DESC=(
  "0  stock          — AMD defaults, no workarounds"
  "1  no-FAMS        — disable SubVP + firmware-assisted memory-clock switching"
  "2  pinned-mclk    — level 1 + lock VRAM clock to max at boot (~+15–30 W idle)"
  "3  no-mclk-switch — level 2 + no multi-monitor clock switching, no PSR/Panel Replay"
  "4  locked-high    — level 3 + force every GPU clock high (max idle power, last resort)"
)
# amdgpu.dcdebugmask bits (drivers/gpu/drm/amd/include/amd_shared.h):
#   0x10 DC_DISABLE_PSR, 0x400 DC_DISABLE_REPLAY, 0x20000 DC_DISABLE_SUBVP_FAMS
level_cmdline() {
  case $1 in
    0) echo "" ;;
    1|2) echo "amdgpu.dcdebugmask=0x20000" ;;
    # dcfeaturemask defaults to 0x2 (DC_MULTI_MON_PP_MCLK_SWITCH_MASK); 0x0 turns it off.
    3|4) echo "amdgpu.dcdebugmask=0x20410 amdgpu.dcfeaturemask=0x0" ;;
  esac
}

display_level() {
  local LEVEL=0
  # shellcheck source=/dev/null
  [[ -r $DISPLAY_CONF ]] && . "$DISPLAY_CONF"
  echo "${LEVEL:-0}"
}

# Starting level for this PC, as "LEVEL<TAB>reason"; the installer uses it. Level 1 only where
# the blackouts are known: an RX 9070-series card driving a Samsung Odyssey or more than one
# screen. Everything else starts at stock and can climb the ladder if it ever blacks out.
display_recommend() {
  local card n=0 odyssey=0 conn name
  if ! card=$(dgpu_card); then
    printf '0\tno AMD graphics card (the fix is for Radeon cards)\n'; return 0
  fi
  if [[ " $DGPU_IDS " != *" $(cat "$card/device/device" 2>/dev/null) "* ]]; then
    printf '0\tno RX 9070-series card\n'; return 0
  fi
  while IFS=$'\t' read -r conn name; do
    [[ -n $conn ]] || continue
    n=$((n + 1))
    [[ $name == *Odyssey* || $name == *G70B* ]] && odyssey=1
  done < <(monitors)
  if [[ $odyssey == 1 ]]; then printf '1\tRX 9070-series card + Samsung Odyssey\n'
  elif [[ $n -gt 1 ]]; then printf '1\tRX 9070-series card + %d monitors\n' "$n"
  elif [[ $n == 1 ]]; then printf '0\tRX 9070-series card, one monitor\n'
  else printf '0\tRX 9070-series card, no monitors detected\n'; fi
}

grub_set_amdgpu_args() {
  local args=$1
  [[ -f $GRUB_DEFAULT ]] || { err "$GRUB_DEFAULT not found"; return 1; }
  local cur; cur=$(sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"$/\1/p' "$GRUB_DEFAULT")
  local kept=() tok
  for tok in $cur; do
    [[ $tok == amdgpu.dcdebugmask=* || $tok == amdgpu.dcfeaturemask=* ]] || kept+=("$tok")
  done
  local new="${kept[*]} $args"; new=${new% }
  sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"${new}\"|" "$GRUB_DEFAULT"
  grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
}

# Runtime part of the ladder (sysfs); run at boot by deckos-display.service.
display_apply() {
  need_root display apply
  local level card; level=$(display_level)
  card=$(dgpu_card) || { sub "no AMD graphics card: nothing to apply"; return 0; }
  local dev=$card/device
  # Older or non-amdgpu cards (and other PCs booting the live USB) have no power controls.
  [[ -w $dev/power_dpm_force_performance_level ]] || { warn "$(basename "$card") has no amdgpu power controls"; return 0; }
  case $level in
    0|1)
      echo auto > "$dev/power_dpm_force_performance_level" ;;
    2|3)
      echo manual > "$dev/power_dpm_force_performance_level"
      local top; top=$(tail -n1 "$dev/pp_dpm_mclk" | cut -d: -f1)
      echo "$top" > "$dev/pp_dpm_mclk"
      say "VRAM clock pinned to state $top on $(basename "$card")" ;;
    4)
      echo high > "$dev/power_dpm_force_performance_level" ;;
  esac
}

display_status() {
  section "Display"
  local level; level=$(display_level)
  say "  Fix level: ${C_B}${level}${C_0}   ${C_SUB}(sudo deckos display set 0-4)${C_0}"
  sub "${LEVEL_DESC[$level]}"
  local cmd; cmd=$(cat /proc/cmdline)
  if [[ -n $(level_cmdline "$level") ]]; then
    local t missing=0
    for t in $(level_cmdline "$level"); do [[ " $cmd " == *" $t "* ]] || missing=1; done
    [[ $missing == 0 ]] && ok "kernel flags active" || warn "kernel flags change pending — reboot"
  fi
  local card; if card=$(dgpu_card); then
    ok "GPU: $(basename "$card") ($(cat "$card/device/device")) perf=$(cat "$card/device/power_dpm_force_performance_level")"
    sub "VRAM clock now: $(grep '\*' "$card/device/pp_dpm_mclk" 2>/dev/null | tr -s ' ' || echo '?')"
  else
    sub "No AMD graphics card: the fix levels are for Radeon cards and change nothing here"
  fi
  section "Monitors"
  while IFS=$'\t' read -r conn name; do
    [[ -n $conn ]] && say "  $conn  ${C_SUB}${name:-unknown}${C_0}"
  done < <(monitors)
}

# Logs kernel display events, hotplugs and VRAM clock changes side by side. Press Enter
# the moment the screen blacks out to drop a marker; the log shows what happened around it.
display_watch() {
  local log=${HOME}/deckos-display-watch.log card
  card=$(dgpu_card) || { err "this watches an AMD card's memory clock; there's no AMD graphics card here"; exit 1; }
  say "${C_B}Watching for blackouts.${C_0} Press ${C_B}Enter${C_0} the moment the screen goes black; Ctrl+C to stop."
  say "${C_SUB}Log: $log${C_0}"
  : > "$log"
  (
    journalctl -kf -n0 -o short-precise 2>/dev/null \
      | grep --line-buffered -iE 'amdgpu|drm|hpd|link|flip|dmub|dp_' \
      | sed -u 's/^/[kernel] /' &
    udevadm monitor -k -s drm 2>/dev/null | sed -u -n 's/^KERNEL\[[^]]*\] *//p' | sed -u 's/^/[hotplug] /' &
    last=""
    while sleep 0.25; do
      now=$(grep '\*' "$card/device/pp_dpm_mclk" 2>/dev/null | tr -s ' ')
      [[ $now != "$last" ]] && echo "[vram-clock] $now" && last=$now
    done &
    wait
  ) | while IFS= read -r l; do printf '%s %s\n' "$(date +%T.%3N)" "$l"; done | tee -a "$log" &
  local bg=$!
  trap 'kill $bg 2>/dev/null; pkill -P $bg 2>/dev/null; exit 0' INT TERM
  while read -r _; do printf '%s ===== BLACKOUT MARKED =====\n' "$(date +%T.%3N)" | tee -a "$log"; done
}

display_set() {
  need_root display set
  local n=${1:-}
  [[ $n =~ ^[0-4]$ ]] || { err "level must be 0-4"; printf '  %s\n' "${LEVEL_DESC[@]}"; exit 2; }
  # The levels are amdgpu kernel flags and clocks: without an AMD card only 0 (stock) applies.
  [[ $n == 0 ]] || dgpu_card >/dev/null || { err "the fix levels are for AMD Radeon cards; this PC has none"; exit 1; }
  mkdir -p "$CONF_DIR"
  printf '# Managed by deckos display set\nLEVEL=%s\n' "$n" > "$DISPLAY_CONF"
  grub_set_amdgpu_args "$(level_cmdline "$n")"
  display_apply || true
  ok "display fix level $n saved"
  sub "${LEVEL_DESC[$n]}"
  warn "reboot to load the new kernel flags"
}

display_cmd() {
  case ${1:-status} in
    status) display_status ;;
    set) shift; display_set "$@" ;;
    apply) display_apply ;;
    watch) display_watch ;;
    levels) printf '  %s\n' "${LEVEL_DESC[@]}" ;;
    monitors) monitors ;;
    recommend) display_recommend ;;
    flags) level_cmdline "${2:-}" ;;  # kernel flags for level N (used by the installer)
    vendors) gpu_vendors ;;  # amd/nvidia/intel, one per line (used by the installer)
    *) err "usage: deckos display [status|levels|set N|watch|monitors|recommend]"; exit 2 ;;
  esac
}

# --------------------------------------------------------------------- drives
#
# Existing NTFS drives are mounted in place with the in-kernel ntfs3 driver — nothing is
# reformatted. Internal drives mount at boot, USB drives mount when first opened.

ntfs_partitions() {
  # path<TAB>uuid<TAB>label<TAB>parttype<TAB>size<TAB>transport
  lsblk -J -b -o PATH,FSTYPE,UUID,LABEL,PARTTYPE,SIZE,TRAN | jq -r '
    .blockdevices[] | . as $d | (.children // [])[]
    | select(.fstype == "ntfs" and .uuid != null)
    | select((.parttype // "") != "de94bba4-06d1-4d40-a16a-bfd50179d6ac")
    | select(.size > 4000000000)
    | [.path, .uuid, (.label // ""), (.parttype // ""), (.size|tostring), ($d.tran // "")] | @tsv'
}

mount_name() {
  local dev=$1 label=$2 uuid=$3 probe
  if [[ -z $label && $EUID -eq 0 ]]; then
    probe=$(mktemp -d)
    if mount -t ntfs3 -o ro "$dev" "$probe" 2>/dev/null || mount -t ntfs-3g -o ro "$dev" "$probe" 2>/dev/null; then
      [[ -d $probe/Windows/System32 ]] && label=Windows
      umount "$probe"
    fi
    rmdir "$probe"
  fi
  label=${label//[^A-Za-z0-9_.-]/_}
  echo "${label:-Disk-${uuid:0:4}}"
}

drives_fstab() {
  local uid=1000 gid=1000
  while [[ $# -gt 0 ]]; do
    case $1 in --uid) uid=$2; shift 2 ;; --gid) gid=$2; shift 2 ;; *) shift ;; esac
  done
  local base="uid=$uid,gid=$gid,umask=022,windows_names,prealloc,noatime,nofail,x-systemd.device-timeout=5s,x-gvfs-show"
  local used="" path uuid label _parttype size tran name opts
  echo "$FSTAB_BEGIN"
  while IFS=$'\t' read -r path uuid label _parttype size tran; do
    name=$(mount_name "$path" "$label" "$uuid")
    while [[ " $used " == *" $name "* ]]; do name="$name-${uuid:0:4}"; done
    used+=" $name"
    opts=$base
    [[ $tran == usb ]] && opts+=",noauto,x-systemd.automount,x-systemd.idle-timeout=0"
    printf '# %s (%s GB%s)\nUUID=%s  /mnt/%s  ntfs3  %s  0 0\n' \
      "$path" "$((size / 1000000000))" "${tran:+, $tran}" "$uuid" "$name" "$opts"
  done < <(ntfs_partitions)
  echo "$FSTAB_END"
}

drives_rescan() {
  need_root drives rescan
  local user=${SUDO_USER:-}
  [[ -z $user && -n ${PKEXEC_UID:-} ]] && user=$(id -nu "$PKEXEC_UID")
  [[ -n $user ]] || user=$(id -nu 1000 2>/dev/null || echo root)
  local block; block=$(drives_fstab --uid "$(id -u "$user")" --gid "$(id -g "$user")")
  cp /etc/fstab /etc/fstab.deckos-bak
  awk -v b="$FSTAB_BEGIN" -v e="$FSTAB_END" '$0==b{skip=1} !skip{print} $0==e{skip=0}' \
    /etc/fstab.deckos-bak > /etc/fstab
  printf '\n%s\n' "$block" >> /etc/fstab
  grep -oP '(?<=  /mnt/)\S+' <<<"$block" | while read -r m; do mkdir -p "/mnt/$m"; done
  systemctl daemon-reload
  mount -a 2>/dev/null || true
  ok "fstab updated (backup: /etc/fstab.deckos-bak)"
  drives_list
}

drives_list() {
  section "Drives"
  awk -v b="$FSTAB_BEGIN" -v e="$FSTAB_END" '$0==b{f=1;next} $0==e{f=0} f && /^UUID=/ {print $2}' /etc/fstab |
  while read -r mp; do
    if findmnt -n "$mp" >/dev/null 2>&1; then
      local fo; fo=$(findmnt -no OPTIONS "$mp")
      if [[ ,$fo, == *,ro,* ]]; then warn "$mp mounted READ-ONLY (Windows Fast Startup?) — see: deckos drives doctor"
      else ok "$mp  ${C_SUB}$(df -h --output=used,size "$mp" | tail -1 | awk '{print $1" / "$2" used"}')${C_0}"; fi
    else
      sub "$mp  not mounted (unplugged, or mounts on first open)"
    fi
  done
}

drives_doctor() {
  section "NTFS health"
  local bad
  bad=$(journalctl -k -b --no-pager 2>/dev/null | grep -iE 'ntfs3.*(dirty|hiber|force)' | tail -5 || true)
  if [[ -z $bad ]]; then ok "no dirty/hibernated NTFS volumes reported this boot"; else
    warn "Windows left these volumes 'dirty' or hibernated, so Linux won't write to them:"
    sed 's/^/    /' <<<"$bad"
    say ""
    say "  Fix it from Windows (once): open Terminal as Administrator and run"
    say "    ${C_B}powercfg /h off${C_0}     (turns off Fast Startup + hibernation)"
    say "  then Shut Down Windows normally and boot DeckOS."
    say "  If Windows is NOT hibernated and a drive is just marked dirty: sudo ntfsfix -d /dev/sdXN"
  fi
}

drives_cmd() {
  case ${1:-list} in
    list) drives_list ;;
    rescan) drives_rescan ;;
    fstab) shift; drives_fstab "$@" ;;
    doctor) drives_doctor ;;
    *) err "usage: deckos drives [list|rescan|doctor|fstab]"; exit 2 ;;
  esac
}

# -------------------------------------------------------------------- session

session_cmd() {
  local target=${1:-} ask=${2:-}
  case $target in
    gaming|desktop) ;;
    *) err "usage: deckos session gaming|desktop [--ask]"; exit 2 ;;
  esac
  if [[ $ask == --ask ]] && command -v kdialog >/dev/null; then
    local label=Desktop; [[ $target == gaming ]] && label="Gaming Mode"
    kdialog --title "DeckOS" --yes-label "Switch" --no-label "Cancel" \
      --warningyesno "Switch to $label?"$'\n\n'"Open apps will close — save your work first." || exit 0
  fi
  sudo -n /usr/lib/deckos/session-switch "$target" --delay 1
}

# Picks the output Gaming Mode should use: the Samsung Odyssey if present, else the first one.
gaming_detect() {
  local first="" conn name
  while IFS=$'\t' read -r conn name; do
    [[ -z $first ]] && first=$conn
    [[ $name == *Odyssey* || $name == *G70B* ]] && { echo "$conn"; return 0; }
  done < <(monitors)
  [[ -n $first ]] && echo "$first"
}

# ----------------------------------------------------------------- steam-ntfs
#
# Proton prefixes (compatdata) can't live on NTFS — Windows filenames like "C:" break them.
# Keep games on the NTFS drive, move just the prefixes to the Linux drive via symlink.

steam_ntfs() {
  local steam=$HOME/.local/share/Steam vdf
  vdf=$steam/steamapps/libraryfolders.vdf
  [[ -f $vdf ]] || { err "Steam library list not found — open Steam once and add your library folders first"; exit 1; }
  pgrep -x steam >/dev/null && { err "close Steam first"; exit 1; }
  section "Steam libraries on NTFS"
  local lib fs n=0
  while IFS= read -r lib; do
    [[ -d $lib/steamapps ]] || continue
    fs=$(findmnt -no FSTYPE -T "$lib" 2>/dev/null || true)
    [[ $fs == ntfs3 || $fs == ntfs || $fs == fuseblk ]] || { sub "$lib ($fs) — fine as is"; continue; }
    local key; key=$(printf '%s' "$lib" | md5sum | cut -c1-10)
    local dest=$HOME/.local/share/deckos/steam-ntfs/$key
    local d
    for d in compatdata shadercache; do
      local src=$lib/steamapps/$d
      mkdir -p "$dest/$d"
      if [[ -L $src ]]; then continue; fi
      if [[ -d $src ]]; then cp -a "$src/." "$dest/$d/" 2>/dev/null || true; rm -rf "$src"; fi
      ln -s "$dest/$d" "$src"
    done
    ok "$lib → prefixes in ~/.local/share/deckos/steam-ntfs/$key"; n=$((n + 1))
  done < <(grep -oP '"path"\s+"\K[^"]+' "$vdf")
  [[ $n -gt 0 ]] || sub "no NTFS libraries found"
}

# --------------------------------------------------------------------- update

update_cmd() {
  if [[ ${1:-} == --system ]]; then
    # DeckOS Hub runs this through pkexec: no prompts, and no progress bars, so it can read
    # pacman's "(n/N)" lines for its own. AUR apps need the interactive form below.
    need_root update --system
    pacman -Syu --noconfirm --noprogressbar
    if command -v flatpak >/dev/null; then flatpak update -y --noninteractive || true; fi
    ok "done"
    return
  fi
  local before after
  before=$(pacman -Q deckos-settings 2>/dev/null || true)
  section "Updating DeckOS"
  sub "snap-pac takes a btrfs snapshot before and after; roll back from the GRUB 'snapshots' menu."
  if command -v paru >/dev/null; then paru -Syu; else sudo pacman -Syu; fi
  command -v flatpak >/dev/null && flatpak update -y || true
  ok "done"
  after=$(pacman -Q deckos-settings 2>/dev/null || true)
  if [[ $after != "$before" ]]; then
    # The panel, Menu and Quick Settings keep the old version until plasmashell restarts.
    ok "DeckOS ${after#deckos-settings } installed"
    sub "Restart the desktop to load it (open windows stay open): systemctl --user restart plasma-plasmashell"
  fi
}

# How many updates are waiting (DeckOS Quick Settings shows it in the panel). Checking needs the
# network, so the answer is cached and reused while it's younger than --max-age seconds and pacman
# hasn't installed anything since.
UPDATES_CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/deckos/updates

updates_stale() {  # updates_stale MAX_AGE
  [[ -s $UPDATES_CACHE ]] || return 0
  [[ /var/lib/pacman/local -nt $UPDATES_CACHE ]] && return 0
  (( $(date +%s) - $(stat -c %Y "$UPDATES_CACHE") >= $1 ))
}

updates_check() {
  local repo=0 aur=0 out rc=0 error="" old
  if ! command -v checkupdates >/dev/null; then
    error="checkupdates isn't installed (pacman-contrib)"
  else
    out=$(checkupdates 2>/dev/null) || rc=$?
    case $rc in
      0) repo=$(grep -c . <<<"$out" || true) ;;
      2) ;;  # nothing to update
      *) error="No connection to the package mirrors" ;;
    esac
  fi
  if [[ -z $error ]] && command -v paru >/dev/null; then
    aur=$( (paru -Qua 2>/dev/null || true) | grep -v '\[ignored\]' | grep -c . || true)
  fi
  if [[ -n $error && -r $UPDATES_CACHE ]]; then  # keep the last known counts
    old=$(cat "$UPDATES_CACHE")
    repo=$(sed -n 's/^repo=//p' <<<"$old"); aur=$(sed -n 's/^aur=//p' <<<"$old")
  fi
  {
    printf 'repo=%s\naur=%s\nchecked=%s\n' "${repo:-0}" "${aur:-0}" "$(date +%s)"
    if [[ -n $error ]]; then printf 'error=%s\n' "$error"; fi
  } > "$UPDATES_CACHE.new"
  mv "$UPDATES_CACHE.new" "$UPDATES_CACHE"
}

updates_cmd() {
  local max_age=3600
  case ${1:-} in
    "") ;;
    --cached) [[ -r $UPDATES_CACHE ]] && cat "$UPDATES_CACHE"; return 0 ;;
    --max-age) max_age=${2:-}; [[ $max_age =~ ^[0-9]+$ ]] || { err "--max-age takes seconds"; exit 2; } ;;
    *) err "usage: deckos updates [--cached|--max-age SECONDS]"; exit 2 ;;
  esac
  mkdir -p "${UPDATES_CACHE%/*}"
  exec 9>"$UPDATES_CACHE.lock"
  flock 9  # the panel and a terminal checking at once: the second one waits, then reuses the answer
  if updates_stale "$max_age"; then updates_check; fi
  cat "$UPDATES_CACHE"
}

# Everything DeckOS Quick Settings shows from the deckos side, in one quick call: no network, no root.
quick_status() {
  printf 'display=%s\n' "$(display_level)"
  if command -v gamescope-session-plus >/dev/null; then echo gaming=1; else echo gaming=0; fi
  if command -v firewall-cmd >/dev/null; then echo firewall=1; else echo firewall=0; fi
  mode_status
  if [[ -r $UPDATES_CACHE ]]; then
    cat "$UPDATES_CACHE"
    if [[ /var/lib/pacman/local -nt $UPDATES_CACHE ]]; then echo stale=1; fi
  fi
}

# --------------------------------------------------------------------- software
#
# The installer's optional groups, added later (DeckOS Hub > System > Software). Same lists the
# installer used; services, user groups and firewall rules match what it sets up.

PACKAGES=/usr/share/deckos/packages
SOFTWARE_GROUPS=(gaming ai dev)

# A second column names the graphics vendor a package is for (amd, nvidia, intel).
pkg_list() {
  grep -vE '^\s*(#|$)' "$PACKAGES/$1.txt" | awk -v gpus=" $(gpu_vendors | tr '\n' ' ') " \
    'NF == 1 || index(gpus, " " $2 " ") {print $1}'
}
aur_list() { grep -vE '^\s*(#|$)' "$PACKAGES/aur.txt" | awk -v g="$1" '$2 == g {print $1}'; }

software_list() {
  local g pkgs missing
  for g in "${SOFTWARE_GROUPS[@]}"; do
    mapfile -t pkgs < <(pkg_list "$g")
    missing=$(pacman -T "${pkgs[@]}" | wc -l)
    if [[ $missing == 0 ]]; then ok "$g"; else sub "$g: $missing of ${#pkgs[@]} packages missing (deckos software add $g)"; fi
  done
}

software_add() {
  local g=${1:-} pkgs aur
  [[ " ${SOFTWARE_GROUPS[*]} " == *" $g "* ]] || { err "usage: deckos software add gaming|ai|dev"; exit 2; }
  [[ $EUID -ne 0 ]] || { err "run this as your user: it uses sudo itself, and AUR apps build as you"; exit 1; }
  section "Adding $g"
  mapfile -t pkgs < <(pkg_list "$g")
  mapfile -t aur < <(aur_list "$g")
  sudo pacman -S --needed "${pkgs[@]}"
  if [[ ${#aur[@]} -gt 0 ]]; then paru -S --needed "${aur[@]}" || warn "some AUR apps failed: ${aur[*]}"; fi
  case $g in
    gaming)
      sudo systemctl enable --now lactd || warn "could not start lactd"
      if getent group gamemode >/dev/null; then sudo usermod -aG gamemode "$USER"; fi
      if systemctl is-active --quiet firewalld; then
        sudo firewall-cmd --permanent --add-service=steam-streaming >/dev/null && sudo firewall-cmd --reload >/dev/null \
          || warn "could not open Steam Remote Play in the firewall"
      fi ;;
    ai)
      sudo systemctl enable --now ollama || warn "could not start ollama" ;;
    dev)
      sudo systemctl enable --now docker.socket || warn "could not start docker"
      sudo usermod -aG docker "$USER"
      curl -fsSL https://claude.ai/install.sh | bash || warn "Claude Code install failed (DeckOS Hub can retry)" ;;
  esac
  ok "$g added"
  sub "Log out and back in so new group memberships apply."
}

software_cmd() {
  case ${1:-list} in
    list) software_list ;;
    add) shift; software_add "$@" ;;
    *) err "usage: deckos software [list|add gaming|ai|dev]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ spotify
#
# The DeckOS look for the official Spotify app, through Spicetify. Works with Arch's
# spotify-launcher, the AUR package and the Flathub app. Spotify updates undo it: run it again.

SPOTIFY_APPS=("$HOME/.local/share/spotify-launcher/install/usr/share/spotify" /opt/spotify /usr/share/spotify
              /var/lib/flatpak/app/com.spotify.Client/x86_64/stable/active/files/extra/share/spotify
              "$HOME/.local/share/flatpak/app/com.spotify.Client/x86_64/stable/active/files/extra/share/spotify")
SPOTIFY_PREFS=("$HOME/.config/spotify/prefs" "$HOME/.var/app/com.spotify.Client/config/spotify/prefs")

spotify_theme() {
  [[ $EUID -ne 0 ]] || { err "run this as your user: Spicetify's settings live in your home folder"; exit 1; }
  local app="" prefs="" c themes
  for c in "${SPOTIFY_APPS[@]}"; do [[ -d $c/Apps ]] && { app=$c; break; }; done
  [[ -n $app ]] || { err "Spotify isn't installed (get it from the DeckOS Store), or hasn't been opened yet"; exit 1; }
  for c in "${SPOTIFY_PREFS[@]}"; do [[ -f $c ]] && { prefs=$c; break; }; done
  [[ -n $prefs ]] || { err "open Spotify once and log in, close it, then run this again"; exit 1; }
  section "DeckOS theme for Spotify"
  sub "Spotify: $app"
  if ! command -v spicetify >/dev/null; then
    paru -S --needed spicetify-cli || { err "couldn't install Spicetify (spicetify-cli)"; exit 1; }
  fi
  # Spicetify patches Spotify's own files; the system-wide installs need to be writable for that.
  if [[ ! -w $app || ! -w $app/Apps ]]; then
    sudo chmod a+wr "$app" && sudo chmod -R a+wr "$app/Apps"
  fi
  themes=${XDG_CONFIG_HOME:-$HOME/.config}/spicetify/Themes/DeckOS
  mkdir -p "$themes"
  cp /usr/share/deckos/spicetify/DeckOS/* "$themes/"
  spicetify config spotify_path "$app" prefs_path "$prefs" current_theme DeckOS color_scheme deckos \
    inject_css 1 replace_colors 1 >/dev/null
  if pgrep -x spotify >/dev/null; then warn "Spotify is open: it restarts to load the theme"; fi
  # First time: back up the stock files. After a Spotify update: refresh that backup first.
  spicetify backup apply >/dev/null 2>&1 || spicetify restore backup apply >/dev/null 2>&1 || spicetify apply \
    || { err "Spicetify couldn't apply the theme (see above)"; exit 1; }
  ok "Spotify now has the DeckOS look"
  sub "After Spotify updates itself, run this again (or DeckOS Hub > Appearance > Spotify)."
}

spotify_restore() {
  command -v spicetify >/dev/null || { ok "Spicetify isn't installed: Spotify is already stock"; return; }
  spicetify restore && ok "Spotify is back to its own look"
}

spotify_cmd() {
  case ${1:-theme} in
    theme) spotify_theme ;;
    restore) spotify_restore ;;
    *) err "usage: deckos spotify [theme|restore]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ dev-install
#
# Builds the DeckOS packages from a checkout of the repo and installs them: the loop for working
# on DeckOS from DeckOS. A later release with a higher version replaces them as a normal update.

dev_install() {
  [[ $EUID -ne 0 ]] || { err "run this as your user (makepkg won't build as root)"; exit 1; }
  local root=${1:-} c p
  if [[ -z $root ]]; then
    root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    for c in "$root" "$HOME/deckos" "$HOME/DeckOS" "$HOME/src/deckos" "$HOME/Projects/deckos"; do
      [[ -n $c && -f $c/VERSION && -d $c/pkg/deckos-settings ]] && { root=$c; break; }
    done
  fi
  [[ -f $root/VERSION && -d $root/pkg/deckos-settings ]] || { err "no DeckOS checkout found: deckos dev-install PATH"; exit 2; }
  section "Installing DeckOS $(tr -d '[:space:]' < "$root/VERSION") from $root"
  for p in deckos-files deckos-terminal deckos-settings deckos-theme-tmpikes; do
    [[ -d $root/pkg/$p ]] || continue
    (cd "$root/pkg/$p" && makepkg -sif --noconfirm --clean) || { err "$p didn't build"; exit 1; }
    ok "$p"
  done
  sub "Restart DeckOS Hub to see Hub changes."
}

# ------------------------------------------------------------------ home
#
# /home gets its own hourly snapshots (the system's only cover /). Caches and Steam games change
# all the time, so they become their own subvolumes, which snapshots skip.

HOME_SKIP=(.cache .local/share/Steam)

as_subvolume() {  # as_subvolume PATH OWNER - make a folder a nested subvolume, keeping its files
  local path=$1 owner=$2 parent
  parent=$(dirname "$path")
  runuser -u "$owner" -- mkdir -p "$parent"
  [[ $(stat -f -c %T "$parent") == btrfs ]] || return 0
  btrfs subvolume show "$path" >/dev/null 2>&1 && return 0
  if [[ -e $path ]]; then mv "$path" "$path.deckos-old"; fi
  btrfs subvolume create "$path" >/dev/null
  if [[ -e $path.deckos-old ]]; then
    cp -a --reflink=auto "$path.deckos-old/." "$path/" && rm -rf "$path.deckos-old"
  fi
  chown "$owner:$(id -gn "$owner")" "$path"
}

home_enable() {
  need_root home enable
  [[ $(findmnt -no FSTYPE /home) == btrfs ]] || { err "/home isn't on btrfs, so it can't have snapshots"; exit 1; }
  local cfg=/etc/snapper/configs/home d u home
  [[ -f $cfg ]] || snapper --no-dbus -c home create-config /home
  sed -i -E 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="yes"/; s/^TIMELINE_CLEANUP=.*/TIMELINE_CLEANUP="yes"/;
             s/^TIMELINE_LIMIT_HOURLY=.*/TIMELINE_LIMIT_HOURLY="12"/; s/^TIMELINE_LIMIT_DAILY=.*/TIMELINE_LIMIT_DAILY="7"/;
             s/^TIMELINE_LIMIT_WEEKLY=.*/TIMELINE_LIMIT_WEEKLY="2"/; s/^TIMELINE_LIMIT_MONTHLY=.*/TIMELINE_LIMIT_MONTHLY="0"/;
             s/^TIMELINE_LIMIT_YEARLY=.*/TIMELINE_LIMIT_YEARLY="0"/; s/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/;
             s/^ALLOW_GROUPS=.*/ALLOW_GROUPS="wheel"/; s/^SYNC_ACL=.*/SYNC_ACL="yes"/' "$cfg"
  for home in /home/*/; do
    home=${home%/}
    u=$(stat -c %U "$home")
    [[ $(id -u "$u" 2>/dev/null || echo 0) -ge 1000 ]] || continue
    for d in "${HOME_SKIP[@]}"; do
      if [[ $d == .local/share/Steam ]] && pgrep -u "$u" -x steam >/dev/null; then
        warn "$u: close Steam, then run this again to move ~/$d out of snapshots"; continue
      fi
      as_subvolume "$home/$d" "$u"
    done
    ok "$u: ~/.cache and Steam games are left out of snapshots"
  done
  systemctl enable snapper-timeline.timer snapper-cleanup.timer >/dev/null 2>&1 || true
  if [[ -d /run/systemd/system ]]; then systemctl start snapper-timeline.timer snapper-cleanup.timer || true; fi
  snapper --no-dbus -c home create -d "Home snapshots turned on" || true
  ok "/home snapshots: hourly, keeping 12 hourly, 7 daily and 2 weekly"
  sub "Browse them in /home/.snapshots/<number>/snapshot (DeckOS Hub > System > Snapshots)."
}

# Snapshots saved in a snapper config, or nothing if snapper can't read it. wheel may list without
# sudo (ALLOW_GROUPS); #0 is snapper's "current" row, not a snapshot.
snapshot_count() {
  local nums
  nums=$(snapper --csvout --no-headers -c "$1" list --columns number 2>/dev/null) || return 1
  grep -cvx '0' <<<"$nums" || true
}

home_status() {
  section "Home"
  if [[ -f /etc/snapper/configs/home ]]; then
    local n
    if ! n=$(snapshot_count home); then warn "couldn't read /home snapshots (snapper -c home list)"
    elif (( n == 0 )); then warn "/home snapshots on, but none saved yet (systemctl status snapper-timeline.timer)"
    else ok "snapshots on: $n saved"; fi
  else
    warn "no /home snapshots (sudo deckos home enable)"
  fi
  local conf=$HOME/.config/deckos/backup.conf
  if [[ -r $conf ]]; then
    ok "backup: $(sed -n 's/^DEST=//p' "$conf"), last $(sed -n 's/^LAST=//p' "$conf")"
  else
    sub "no backup yet (deckos backup /mnt/YOURDRIVE)"
  fi
}

home_cmd() {
  case ${1:-status} in
    status) home_status ;;
    enable) home_enable ;;
    *) err "usage: deckos home [status|enable]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ backup
#
# Snapshots live on the same disk; a backup doesn't. Copies your home folder to another drive
# (an NTFS one is fine) without caches, Steam games or build output. Remembers the drive.

backup_cmd() {
  [[ $EUID -ne 0 ]] || { err "run this as your user: it backs up your own home folder"; exit 1; }
  local conf=$HOME/.config/deckos/backup.conf dest=${1:-} target rc=0
  [[ -z $dest && -r $conf ]] && dest=$(sed -n 's/^DEST=//p' "$conf")
  [[ -n $dest ]] || { err "usage: deckos backup /mnt/BIG   (remembered for next time)"; exit 2; }
  [[ -d $dest && -w $dest ]] || { err "$dest isn't a writable folder (is the drive mounted?)"; exit 1; }
  target="$dest/DeckOS backup/$USER@$(uname -n)"
  mkdir -p "$target" "$(dirname "$conf")"
  section "Backing up $HOME"
  sub "to $target"
  rsync -rlt --delete --delete-excluded --info=progress2 --exclude-from=- "$HOME/" "$target/" <<'EOF' || rc=$?
.cache/
.local/share/Steam/
.local/share/Trash/
.local/share/deckos/steam-ntfs/
.snapshots/
node_modules/
.venv/
__pycache__/
*.iso
EOF
  case $rc in
    0) ok "backed up" ;;
    23|24) warn "backed up, but some files were skipped (names Windows doesn't allow, or files that changed while copying)" ;;
    *) err "backup stopped (rsync exit $rc)"; exit "$rc" ;;
  esac
  printf 'DEST=%s\nLAST=%s\n' "$dest" "$(date '+%Y-%m-%d %H:%M')" > "$conf"
}

# ------------------------------------------------------------------ scheduler
#
# sched_ext CPU schedulers (scx-tools) through scx_loader: lavd keeps frame times steady when the
# game shares the CPU with Discord, OBS or a browser. DeckOS starts on lavd in Gaming mode.

SCX_CONF=/etc/scx_loader.toml

scheduler_status() {  # key=value, no root: what's running now and what's configured
  local state ops sched mode
  state=$(cat /sys/kernel/sched_ext/state 2>/dev/null || echo unsupported)
  ops=$(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || true)
  sched=$(sed -n 's/^default_sched *= *"scx_\(.*\)"/\1/p' "$SCX_CONF" 2>/dev/null)
  mode=$(sed -n 's/^default_mode *= *"\(.*\)"/\1/p' "$SCX_CONF" 2>/dev/null)
  systemctl is-enabled --quiet scx_loader.service 2>/dev/null || sched=off
  printf 'state=%s\nrunning=%s\nsched=%s\nmode=%s\n' "$state" "${ops%%_*}" "${sched:-off}" "${mode:-Auto}"
}

scheduler_set() {  # scheduler_set lavd|bpfland|rusty|off [Gaming|PowerSave|LowLatency|Auto]
  need_root scheduler set
  local sched=$1 mode=${2:-Gaming}
  [[ $sched =~ ^(lavd|bpfland|rusty|off)$ ]] || { err "scheduler: lavd, bpfland, rusty or off"; exit 2; }
  [[ $mode =~ ^(Gaming|PowerSave|LowLatency|Auto)$ ]] || { err "mode: Gaming, PowerSave, LowLatency or Auto"; exit 2; }
  if [[ $sched == off ]]; then
    systemctl disable --now scx_loader.service >/dev/null 2>&1 || true
    ok "CPU scheduler: the kernel's own (BORE)"
    return
  fi
  systemctl cat scx_loader.service >/dev/null 2>&1 || { err "scx_loader isn't installed (pacman -S scx-tools)"; exit 1; }
  printf '# Written by deckos scheduler (DeckOS Hub > Gaming > Performance)\ndefault_sched = "scx_%s"\ndefault_mode = "%s"\n' \
    "$sched" "$mode" > "$SCX_CONF"
  systemctl enable scx_loader.service >/dev/null 2>&1
  systemctl restart scx_loader.service
  ok "CPU scheduler: $sched ($mode)"
}

scheduler_cmd() {
  case ${1:-status} in
    status) scheduler_status ;;
    set) shift; scheduler_set "${1:-lavd}" "${2:-Gaming}" ;;
    *) err "usage: deckos scheduler [status|set lavd|bpfland|rusty|off [MODE]]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ gpu
#
# Graphics card tuning from /etc/deckos/gpu.conf, applied at boot by deckos-gpu.service: power limit,
# undervolt (voltage offset) and fan curve, straight through amdgpu's sysfs. The undervolt and fan
# curve need amdgpu overdrive (ppfeaturemask). Boot with deckos.gpu=stock to skip all of it. When LACT's
# daemon runs, it owns the card and DeckOS stays out of its way.

GPU_CONF=$CONF_DIR/gpu.conf
OD_MASK=0xffffffff

gpu_conf() {
  POWER_PERCENT=100 VOLTAGE_OFFSET=0 FAN=stock
  # shellcheck source=/dev/null
  [[ -r $GPU_CONF ]] && . "$GPU_CONF"
}

gpu_hwmon() { local h; for h in "$1"/device/hwmon/hwmon*; do [[ -d $h ]] && { echo "$h"; return 0; }; done; return 1; }
gpu_od_on() { (( $(cat /sys/module/amdgpu/parameters/ppfeaturemask 2>/dev/null || echo 0) & 0x4000 )); }

gpu_status() {  # key=value, no root
  local card hw dev
  card=$(dgpu_card) || { echo "card="; return 0; }
  dev=$card/device; hw=$(gpu_hwmon "$card") || hw=""
  gpu_conf
  w() { local v; v=$(cat "$hw/$1" 2>/dev/null) && echo $((v / 1000000)) || echo 0; }
  printf 'card=%s\n' "$(basename "$card")"
  printf 'cap=%s\ncap_default=%s\ncap_min=%s\ncap_max=%s\n' "$(w power1_cap)" "$(w power1_cap_default)" "$(w power1_cap_min)" "$(w power1_cap_max)"
  printf 'od=%s\nfan_curve=%s\n' "$(gpu_od_on && echo 1 || echo 0)" "$([[ -e $dev/gpu_od/fan_ctrl/fan_curve ]] && echo 1 || echo 0)"
  printf 'power_percent=%s\nvoltage_offset=%s\nfan=%s\n' "$POWER_PERCENT" "$VOLTAGE_OFFSET" "$FAN"
  printf 'lact=%s\n' "$(systemctl is-active --quiet lactd 2>/dev/null && echo 1 || echo 0)"
}

gpu_fan_curve() {  # gpu_fan_curve DEV stock|quiet|cool
  local f=$1/gpu_od/fan_ctrl/fan_curve preset=$2 tmin=25 tmax=100 smin=15 smax=100 i t s
  [[ -w $f ]] || return 0
  if [[ $preset == stock ]]; then echo r > "$f" 2>/dev/null; echo c > "$f" 2>/dev/null || true; return 0; fi
  # Clamp to the card's own limits ("FAN_CURVE(hotspot temp): 25C 100C", "FAN_CURVE(fan speed): 15% 100%").
  read -r tmin tmax < <(sed -n 's/.*FAN_CURVE(hotspot temp): *\([0-9]*\)C *\([0-9]*\)C.*/\1 \2/p' "$f") || true
  read -r smin smax < <(sed -n 's/.*FAN_CURVE(fan speed): *\([0-9]*\)% *\([0-9]*\)%.*/\1 \2/p' "$f") || true
  local -a temps=(45 60 70 80 90) speeds
  case $preset in
    quiet) speeds=(15 25 40 60 85) ;;
    cool)  speeds=(30 45 60 80 100) ;;
    *) warn "unknown fan preset $preset"; return 0 ;;
  esac
  for i in 0 1 2 3 4; do
    t=$(( temps[i] < ${tmin:-25} ? ${tmin:-25} : temps[i] > ${tmax:-100} ? ${tmax:-100} : temps[i] ))
    s=$(( speeds[i] < ${smin:-15} ? ${smin:-15} : speeds[i] > ${smax:-100} ? ${smax:-100} : speeds[i] ))
    echo "$i $t $s" > "$f" 2>/dev/null || { warn "the card refused fan point $i ($t°C, $s%)"; return 0; }
  done
  echo c > "$f" 2>/dev/null || warn "the card refused the fan curve"
}

gpu_apply() {
  need_root gpu apply
  grep -qw 'deckos.gpu=stock' /proc/cmdline && { warn "deckos.gpu=stock: leaving the card at stock"; return 0; }
  systemctl is-active --quiet lactd 2>/dev/null && { sub "LACT manages the graphics card; DeckOS tuning skipped"; return 0; }
  local card dev hw def min max cap
  card=$(dgpu_card) || { sub "no AMD graphics card: DeckOS tuning is for Radeon cards (LACT handles others)"; return 0; }
  dev=$card/device
  gpu_conf
  if hw=$(gpu_hwmon "$card") && [[ -w $hw/power1_cap ]]; then
    def=$(cat "$hw/power1_cap_default"); min=$(cat "$hw/power1_cap_min" 2>/dev/null || echo 0); max=$(cat "$hw/power1_cap_max")
    cap=$(( def / 100 * POWER_PERCENT ))
    (( cap < min )) && cap=$min; (( cap > max )) && cap=$max
    echo "$cap" > "$hw/power1_cap" && ok "power limit $((cap / 1000000)) W"
  fi
  if [[ $VOLTAGE_OFFSET != 0 ]] || [[ -w $dev/pp_od_clk_voltage ]]; then
    if gpu_od_on && [[ -w $dev/pp_od_clk_voltage ]]; then
      { echo "vo $VOLTAGE_OFFSET" > "$dev/pp_od_clk_voltage" && echo c > "$dev/pp_od_clk_voltage"; } 2>/dev/null \
        && ok "voltage offset ${VOLTAGE_OFFSET} mV" || warn "the card refused a ${VOLTAGE_OFFSET} mV offset"
    elif [[ $VOLTAGE_OFFSET != 0 ]]; then
      warn "undervolting needs overdrive: deckos gpu overdrive on, then restart"
    fi
  fi
  gpu_od_on && gpu_fan_curve "$dev" "$FAN"
  [[ $FAN != stock ]] && ! gpu_od_on && warn "fan curves need overdrive: deckos gpu overdrive on, then restart"
  return 0
}

gpu_set() {  # gpu_set KEY=VALUE... (POWER_PERCENT, VOLTAGE_OFFSET, FAN)
  need_root gpu set
  gpu_conf
  local kv
  for kv in "$@"; do
    case $kv in
      POWER_PERCENT=*) POWER_PERCENT=${kv#*=}; [[ $POWER_PERCENT =~ ^[0-9]+$ ]] && (( POWER_PERCENT >= 50 && POWER_PERCENT <= 130 )) \
                         || { err "POWER_PERCENT is 50-130"; exit 2; } ;;
      VOLTAGE_OFFSET=*) VOLTAGE_OFFSET=${kv#*=}; [[ $VOLTAGE_OFFSET =~ ^-?[0-9]+$ ]] && (( VOLTAGE_OFFSET >= -150 && VOLTAGE_OFFSET <= 0 )) \
                         || { err "VOLTAGE_OFFSET is -150 to 0 (mV)"; exit 2; } ;;
      FAN=*) FAN=${kv#*=}; [[ $FAN =~ ^(stock|quiet|cool)$ ]] || { err "FAN is stock, quiet or cool"; exit 2; } ;;
      *) err "unknown setting $kv"; exit 2 ;;
    esac
  done
  mkdir -p "$CONF_DIR"
  cat > "$GPU_CONF" <<EOF
# DeckOS graphics card tuning (DeckOS Hub > Gaming > Graphics card). Applied at boot by
# deckos-gpu.service. Boot with deckos.gpu=stock (press e in GRUB) to skip it once.
POWER_PERCENT=$POWER_PERCENT
VOLTAGE_OFFSET=$VOLTAGE_OFFSET
FAN=$FAN
EOF
  gpu_apply
}

gpu_overdrive() {  # on|off: amdgpu.ppfeaturemask on the kernel command line (needs a restart)
  need_root gpu overdrive
  [[ $1 == off ]] || dgpu_card >/dev/null || { err "overdrive is an AMD setting; this PC has no AMD graphics card"; exit 1; }
  [[ -f $GRUB_DEFAULT ]] || { err "$GRUB_DEFAULT not found"; exit 1; }
  local cur kept=() tok
  cur=$(sed -n 's/^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"$/\1/p' "$GRUB_DEFAULT")
  for tok in $cur; do [[ $tok == amdgpu.ppfeaturemask=* ]] || kept+=("$tok"); done
  [[ $1 == on ]] && kept+=("amdgpu.ppfeaturemask=$OD_MASK")
  sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"${kept[*]}\"|" "$GRUB_DEFAULT"
  grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1
  ok "overdrive $1 from the next start"
}

gpu_cmd() {
  case ${1:-status} in
    status) gpu_status ;;
    apply) gpu_apply ;;
    set) shift; gpu_set "$@" ;;
    reset) gpu_set POWER_PERCENT=100 VOLTAGE_OFFSET=0 FAN=stock ;;
    overdrive) [[ ${2:-} =~ ^(on|off)$ ]] || { err "usage: deckos gpu overdrive on|off"; exit 2; }; gpu_overdrive "$2" ;;
    *) err "usage: deckos gpu [status|apply|set KEY=VALUE...|reset|overdrive on|off]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ controllers

controllers_pair() {  # put every Xbox wireless dongle (xone) into pairing mode for 30 seconds
  need_root controllers pair
  local p n=0
  for p in /sys/bus/usb/drivers/xone-dongle/*/pairing; do
    [[ -w $p ]] || continue
    echo 1 > "$p" && n=$((n + 1))
  done
  (( n )) && ok "pairing: press the pair button on the controller now" || { err "no Xbox wireless dongle found"; exit 1; }
}

# ------------------------------------------------------------------ auto-update
#
# Overnight updates (deckos-auto-update.timer, 04:00): skipped while a game runs. Snapshots before and
# after, like any update. The result goes to /var/lib/deckos/auto-update for DeckOS Hub.

AUTO_STATE=/var/lib/deckos/auto-update

auto_update_run() {
  need_root auto-update run
  mkdir -p "${AUTO_STATE%/*}"
  if pgrep -f '/steamapps/common/|SteamLaunch|gamescope-session' >/dev/null; then
    printf 'when=%s\nresult=skipped\nwhy=a game or Gaming Mode was running\n' "$(date +%s)" > "$AUTO_STATE"
    return 0
  fi
  local n rc=0
  n=$( (checkupdates 2>/dev/null || true) | grep -c . || true)
  pacman -Syu --noconfirm --noprogressbar >> /var/log/deckos-auto-update.log 2>&1 || rc=$?
  if command -v flatpak >/dev/null; then flatpak update -y --noninteractive >> /var/log/deckos-auto-update.log 2>&1 || true; fi
  printf 'when=%s\nresult=%s\ncount=%s\nwhy=%s\n' "$(date +%s)" "$([[ $rc == 0 ]] && echo ok || echo failed)" "$n" \
    "$([[ $rc == 0 ]] || echo "pacman stopped (see /var/log/deckos-auto-update.log)")" > "$AUTO_STATE"
  return "$rc"
}

auto_update_cmd() {
  case ${1:-status} in
    status)
      printf 'enabled=%s\n' "$(systemctl is-enabled --quiet deckos-auto-update.timer 2>/dev/null && echo 1 || echo 0)"
      cat "$AUTO_STATE" 2>/dev/null || true ;;
    on) need_root auto-update on; systemctl enable --now deckos-auto-update.timer >/dev/null 2>&1; ok "overnight updates on (04:00)" ;;
    off) need_root auto-update off; systemctl disable --now deckos-auto-update.timer >/dev/null 2>&1; ok "overnight updates off" ;;
    run) auto_update_run ;;
    *) err "usage: deckos auto-update [status|on|off|run]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ workload modes
#
# A PC that games, builds and runs local AI has them fight over the same graphics memory and CPU.
# deckos-modes.service (a user service) watches for a game and, while one runs, unloads Ollama's
# models from graphics memory, pauses Docker containers and suspends file indexing; it puts back what
# it paused when the game ends. Settings in ~/.config/deckos/modes.conf; the state in
# $XDG_RUNTIME_DIR/deckos-mode is what Quick Settings shows.

MODES_CONF=$HOME/.config/deckos/modes.conf
MODE_STATE=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/deckos-mode

mode_conf() {  # mode_conf KEY DEFAULT
  local v
  v=$(sed -n "s/^$1=//p" "$MODES_CONF" 2>/dev/null | tail -n1)
  echo "${v:-$2}"
}

mode_conf_set() {  # mode_conf_set KEY VALUE
  mkdir -p "${MODES_CONF%/*}"
  touch "$MODES_CONF"
  sed -i "/^$1=/d" "$MODES_CONF"
  echo "$1=$2" >> "$MODES_CONF"
}

steam_game_name() {  # steam_game_name APPID: the name from its app manifest, in any Steam library
  local steam=$HOME/.local/share/Steam lib m
  while IFS= read -r lib; do
    m=$lib/steamapps/appmanifest_$1.acf
    [[ -r $m ]] && { sed -n 's/^\s*"name"\s*"\(.*\)"/\1/p' "$m" | head -n1; return; }
  done < <(sed -n 's/^\s*"path"\s*"\(.*\)"/\1/p' "$steam/steamapps/libraryfolders.vdf" 2>/dev/null || true; echo "$steam")
}

mode_game() {  # the game running now, or nothing: Steam games (reaper), Lutris, Gaming Mode
  local line id name
  # Anchored on the program itself, so a shell or editor whose command line mentions one doesn't count
  line=$(pgrep -a -u "$(id -u)" -f \
    '^[^ ]*reaper SteamLaunch AppId=[0-9]+|^[^ ]*lutris-wrapper |^([^ ]*sh )?[^ ]*gamescope-session' | head -n1 || true)
  [[ -n $line ]] || return 0
  case $line in
    *"SteamLaunch AppId="*)
      id=${line#*AppId=}; id=${id%% *}
      name=$(steam_game_name "$id")
      [[ -n $name ]] || { [[ $line == */steamapps/common/* ]] && name=${line#*/steamapps/common/} && name=${name%%/*}; }
      echo "${name:-a Steam game}" ;;
    *lutris-wrapper*) name=${line#*lutris-wrapper }; echo "${name%% /*}" ;;
    *) echo "Gaming Mode" ;;
  esac
}

# Tells DeckOS apps the mode changed (DeckOS Terminal, ...): org.deckos.Mode.Changed(mode, game) on the
# session bus. The details stay in $MODE_STATE; a signal needs no service, so nobody has to be listening.
mode_announce() {
  busctl --user emit /org/deckos/Mode org.deckos.Mode Changed ss "$1" "${2:-}" >/dev/null 2>&1 || true
}

ollama_url() {
  local h=${OLLAMA_HOST:-127.0.0.1:11434}
  [[ $h == http* ]] || h=http://$h
  echo "$h"
}

mode_enter() {  # mode_enter GAME: free what the game needs, remember what to put back
  local game=$1 url ps names="" vram=0 ids="" keep did=()
  url=$(ollama_url)
  if [[ $(mode_conf OLLAMA unload) == unload ]] && ps=$(curl -fsS -m 3 "$url/api/ps" 2>/dev/null); then
    local name size
    while IFS=$'\t' read -r name size; do
      [[ -n $name ]] || continue
      curl -fsS -m 15 "$url/api/generate" -d "$(jq -cn --arg m "$name" '{model: $m, keep_alive: 0}')" >/dev/null 2>&1 \
        && { names+="${names:+ }$name"; vram=$((vram + size)); }
    done < <(jq -r '.models[]? | [.name, (.size_vram // 0)] | @tsv' <<<"$ps" 2>/dev/null || true)
    [[ -n $names ]] && did+=("unloaded $names from graphics memory ($(awk -v b="$vram" 'BEGIN { printf "%.1f GB", b / 1e9 }'))")
  fi
  # Containers labelled deckos.keep=true (a game server, say) keep running.
  if [[ $(mode_conf DOCKER pause) == pause ]] && command -v docker >/dev/null \
     && ids=$(timeout 5 docker ps -q --filter status=running 2>/dev/null); then
    keep=$(timeout 5 docker ps -q --filter label=deckos.keep=true 2>/dev/null || true)
    ids=$(grep -vxF -f <(echo "$keep") <<<"$ids" | grep . | tr '\n' ' ' || true)
    ids=${ids% }
    if [[ -n $ids ]]; then
      # shellcheck disable=SC2086  # one id per word
      if timeout 20 docker pause $ids >/dev/null 2>&1; then did+=("paused $(wc -w <<<"$ids") Docker container(s)"); else ids=""; fi
    fi
  fi
  local baloo=0
  if [[ $(mode_conf BALOO suspend) == suspend ]] && command -v balooctl6 >/dev/null \
     && balooctl6 status 2>/dev/null | grep -qi 'is running'; then
    balooctl6 suspend >/dev/null 2>&1 && baloo=1 && did+=("paused file indexing")
  fi
  printf 'mode=gaming\ngame=%s\nsince=%s\nollama=%s\nvram=%s\ndocker=%s\nbaloo=%s\n' \
    "$game" "$(date +%s)" "$names" "$vram" "$ids" "$baloo" > "$MODE_STATE.tmp"
  mv "$MODE_STATE.tmp" "$MODE_STATE"
  mode_announce gaming "$game"
  if (( ${#did[@]} )) && command -v notify-send >/dev/null; then
    timeout 5 notify-send -a "DeckOS" -i deckos-hub "Ready for $game" "$(printf '%s\n' "${did[@]^}")" >/dev/null 2>&1 || true
  fi
}

mode_leave() {  # put back what mode_enter paused (Ollama loads models again on its own, when asked)
  [[ $(sed -n 's/^mode=//p' "$MODE_STATE" 2>/dev/null) == gaming ]] || return 0
  local ids baloo
  ids=$(sed -n 's/^docker=//p' "$MODE_STATE")
  baloo=$(sed -n 's/^baloo=//p' "$MODE_STATE")
  # shellcheck disable=SC2086
  [[ -n $ids ]] && { timeout 20 docker unpause $ids >/dev/null 2>&1 || true; }
  [[ $baloo == 1 ]] && { balooctl6 resume >/dev/null 2>&1 || true; }
  printf 'mode=normal\n' > "$MODE_STATE"
  mode_announce normal
}

mode_watch() {  # deckos-modes.service: a game check every few seconds (pgrep, no polling of anything else)
  [[ $(mode_conf AUTO 1) == 1 ]] || exit 0
  local game misses=0 gaming=0
  [[ $(sed -n 's/^mode=//p' "$MODE_STATE" 2>/dev/null) == gaming ]] && gaming=1  # a watcher that didn't get to finish
  trap 'mode_leave; exit 0' TERM INT
  while :; do
    game=$(mode_game)
    if [[ -n $game ]]; then
      misses=0
      (( gaming )) || { mode_enter "$game"; gaming=1; }
    elif (( gaming )) && (( ++misses >= 2 )); then  # a launcher that restarts the game isn't the end of it
      mode_leave; gaming=0; misses=0
    fi
    sleep 5 & wait $!
  done
}

mode_status() {  # key=value, no root: for Quick Settings and the Hub
  printf 'auto=%s\n' "$(mode_conf AUTO 1)"
  if [[ -r $MODE_STATE ]]; then cat "$MODE_STATE"; else echo mode=normal; fi
}

mode_cmd() {
  case ${1:-} in
    "")
      section "Workload modes"
      local s; s=$(mode_status)
      if [[ $(sed -n 's/^auto=//p' <<<"$s") != 1 ]]; then warn "off (deckos mode on)"
      elif [[ $(sed -n 's/^mode=//p' <<<"$s") == gaming ]]; then ok "gaming: $(sed -n 's/^game=//p' <<<"$s")"
      else ok "on: waiting for a game"; fi
      sub "Settings: $MODES_CONF (OLLAMA=unload|keep, DOCKER=pause|leave, BALOO=suspend|leave)" ;;
    status) mode_status ;;
    on) mode_conf_set AUTO 1; systemctl --user start deckos-modes.service 2>/dev/null || true; ok "workload modes on" ;;
    off) mode_conf_set AUTO 0; systemctl --user stop deckos-modes.service 2>/dev/null || true; ok "workload modes off" ;;
    watch) mode_watch ;;
    *) err "usage: deckos mode [status|on|off]"; exit 2 ;;
  esac
}

# ------------------------------------------------------------------ streaming and Decky

streaming_setup() {  # Sunshine: stream games to a TV, phone or Steam Deck with Moonlight
  [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
  section "Game streaming (Sunshine)"
  if ! command -v sunshine >/dev/null; then
    if command -v paru >/dev/null; then paru -S --needed --noconfirm sunshine; else sudo pacman -S --needed sunshine; fi
  fi
  # Capturing the screen on Wayland/KMS needs this capability on the binary.
  sudo setcap cap_sys_admin+p "$(readlink -f "$(command -v sunshine)")"
  if command -v firewall-cmd >/dev/null && sudo firewall-cmd --state >/dev/null 2>&1; then
    sudo firewall-cmd --permanent --add-port=47984-47990/tcp --add-port=48010/tcp --add-port=47998-48000/udp >/dev/null
    sudo firewall-cmd --reload >/dev/null && ok "firewall: Sunshine's ports open"
  fi
  systemctl --user enable --now sunshine >/dev/null 2>&1 || systemctl --user enable --now app-dev.lizardbyte.app.Sunshine >/dev/null 2>&1 || true
  ok "Sunshine running"
  sub "Pair a device: open https://localhost:47990, then add this PC in Moonlight."
}

decky_install() {  # Decky Loader: Steam Deck plugins inside Gaming Mode
  [[ $EUID -ne 0 ]] || { err "run this as your user"; exit 1; }
  section "Decky Loader"
  sub "The official installer from github.com/SteamDeckHomebrew; it asks for your password."
  curl -fsSL https://github.com/SteamDeckHomebrew/decky-installer/releases/latest/download/install_release.sh | sh
  ok "done: open Gaming Mode and press the ... button for the Decky menu"
}

doctor_cmd() {
  section "DeckOS $VERSION"
  say "  Kernel  $(uname -r)"
  say "  Mesa    $(pacman -Q mesa 2>/dev/null | cut -d' ' -f2)"
  say "  GPUs    $(gpu_vendors | tr '\n' ' ')"
  say "  Boot    $(tr ' ' '\n' < /proc/cmdline | grep -E 'amdgpu|nvidia|zswap|splash' | tr '\n' ' ')"
  if [[ -d /sys/firmware/efi ]]; then
    local sb; sb=$(od -An -t u1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | tr -d ' ')
    [[ $sb == 1 ]] && warn "Secure Boot is ON" || ok "Secure Boot off"
  fi
  display_status
  drives_list
  drives_doctor
  section "Snapshots"
  local snaps
  if [[ ! -f /etc/snapper/configs/root ]]; then warn "system snapshots aren't set up: a bad update can't be rolled back"
  elif ! snaps=$(snapshot_count root); then warn "couldn't read system snapshots (snapper -c root list)"
  elif (( snaps == 0 )); then warn "no system snapshots yet: the next update takes the first ones (snap-pac)"
  else ok "$snaps system snapshots ${C_SUB}(snapper -c root list)${C_0}"; fi
  home_status
  section "Updates"
  if grep -q '^Include = /etc/pacman.d/deckos-repo' /etc/pacman.conf; then ok "DeckOS update channel on"
  else warn "DeckOS update channel not set up (reinstall deckos-settings, or deckos dev-install)"; fi
  section "Gaming"
  local sch; sch=$(scheduler_status)
  [[ $sch == *state=enabled* ]] && ok "CPU scheduler: $(sed -n 's/^running=//p' <<<"$sch")" || sub "CPU scheduler: the kernel's own (deckos scheduler set lavd)"
  [[ -e /dev/ntsync ]] && ok "NTSYNC available" || warn "NTSYNC missing (/dev/ntsync): Proton falls back to fsync"
  if dgpu_card >/dev/null; then
    gpu_od_on && ok "GPU overdrive on" || sub "GPU overdrive off (deckos gpu overdrive on, for undervolting)"
  fi
  if [[ $(mode_conf AUTO 1) != 1 ]]; then sub "workload modes off (deckos mode on)"
  elif systemctl --user is-active --quiet deckos-modes.service 2>/dev/null; then ok "workload modes on: games get the GPU to themselves"
  else warn "workload modes on, but its service isn't running (systemctl --user start deckos-modes)"; fi
  section "AI"
  systemctl is-active --quiet ollama && ok "ollama running" || sub "ollama stopped (systemctl start ollama)"
  command -v claude >/dev/null || [[ -x $HOME/.local/bin/claude ]] && ok "Claude Code installed" || sub "Claude Code not installed (curl -fsSL https://claude.ai/install.sh | bash)"
}

usage() {
  cat <<EOF
${C_ACC}${C_B}deckos${C_0} $VERSION — DeckOS system tool

  deckos display [status|levels|set N|watch|monitors|recommend]
                                                        display blackout fix ladder
  deckos drives  [list|rescan|doctor]                   your NTFS drives (no reformatting)
  deckos session gaming|desktop                         switch Gaming Mode <-> Desktop
  deckos gaming detect                                  which output Gaming Mode uses
  deckos steam-ntfs                                     make Steam libraries on NTFS work with Proton
  deckos update [--system]                              update everything (with snapshots)
  deckos updates [--cached|--max-age S]                 how many updates are waiting (cached)
  deckos software [list|add GROUP]                      add gaming, ai or dev after install
  deckos home    [status|enable]                        /home snapshots (hourly) and backup status
  deckos backup  [FOLDER]                               copy your home folder to another drive
  deckos dev-install [CHECKOUT]                         build and install DeckOS from a repo checkout
  deckos spotify [theme|restore]                        the DeckOS look for Spotify (Spicetify)
  deckos scheduler [status|set lavd|bpfland|off [MODE]] gaming CPU scheduler (sched_ext)
  deckos gpu     [status|set K=V..|reset|overdrive on|off]  power limit, undervolt, fan curve
  deckos controllers pair                               Xbox wireless dongle pairing mode
  deckos auto-update [status|on|off]                    overnight updates (04:00, not mid-game)
  deckos mode    [status|on|off]                        workload modes: free the GPU and CPU while a game runs
  deckos streaming setup                                Sunshine game streaming (Moonlight)
  deckos decky install                                  Decky Loader for Gaming Mode
  deckos doctor                                         health check
  deckos hub                                            open DeckOS Hub
EOF
}

case ${1:-} in
  display) shift; display_cmd "$@" ;;
  drives) shift; drives_cmd "$@" ;;
  session) shift; session_cmd "$@" ;;
  gaming) shift; [[ ${1:-detect} == detect ]] && gaming_detect ;;
  steam-ntfs) steam_ntfs ;;
  update) shift; update_cmd "$@" ;;
  updates) shift; updates_cmd "$@" ;;
  quick-status) quick_status ;;  # for DeckOS Quick Settings
  software) shift; software_cmd "$@" ;;
  home) shift; home_cmd "$@" ;;
  backup) shift; backup_cmd "$@" ;;
  dev-install) shift; dev_install "$@" ;;
  spotify) shift; spotify_cmd "$@" ;;
  scheduler) shift; scheduler_cmd "$@" ;;
  gpu) shift; gpu_cmd "$@" ;;
  controllers) shift; if [[ ${1:-} == pair ]]; then controllers_pair; else err "usage: deckos controllers pair"; exit 2; fi ;;
  auto-update) shift; auto_update_cmd "$@" ;;
  mode) shift; mode_cmd "$@" ;;
  streaming) shift; [[ ${1:-setup} == setup ]] && streaming_setup ;;
  decky) shift; [[ ${1:-install} == install ]] && decky_install ;;
  doctor) doctor_cmd ;;
  hub) exec /usr/bin/deckos-hub ;;
  version|--version) echo "$VERSION" ;;
  ""|help|-h|--help) usage ;;
  *) err "unknown command: $1"; usage; exit 2 ;;
esac
