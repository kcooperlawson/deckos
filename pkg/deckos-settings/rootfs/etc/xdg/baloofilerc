# DeckOS: keep the file indexer out of game libraries, Wine prefixes and build output. Indexing
# their many thousands of files caused minutes-long CPU spikes. Users can still change this in
# System Settings > File Search.
[General]
exclude folders[$e]=$HOME/.local/share/Steam/,$HOME/.steam/,$HOME/Games/,$HOME/.wine/,$HOME/.cache/,/mnt/,$HOME/deckos/out/,$HOME/deckos/work/
