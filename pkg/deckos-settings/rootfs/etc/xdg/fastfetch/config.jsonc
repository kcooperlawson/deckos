{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/deckos/branding/fastfetch.txt",
    "color": { "1": "38;2;76;141;255", "2": "38;2;232;234;240" },
    "padding": { "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;76;141;255", "title": "38;2;232;234;240" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[38;2;90;97;114m// DECKO CLAN SYSTEMS" },
    "os", "kernel", "uptime", "packages", "de", "wm",
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    "memory", "swap",
    { "type": "disk", "key": "Disk" },
    "display",
    "break", "colors"
  ]
}
