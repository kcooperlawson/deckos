{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // The DeckOS controller tile as an image in terminals that support it (Konsole does).
  "logo": {
    "type": "auto",
    "source": "/usr/share/deckos/branding/logo-256.png",
    "width": 22,
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;76;141;255", "title": "38;2;232;234;240" }
  },
  "modules": [
    "title",
    "separator",
    "os", "kernel", "uptime", "packages", "de", "wm",
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    "memory", "swap",
    { "type": "disk", "key": "Disk" },
    "display",
    "break", "colors"
  ]
}
