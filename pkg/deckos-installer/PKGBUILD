# Maintainer: kcooperlawson
# Live-USB only: the DecKoOS installer window (it drives deckos-install). Removed from the installed system.
pkgname=deckos-installer
pkgver=0.3.0
pkgrel=1
pkgdesc="DecKoOS graphical installer (PySide6 front end for deckos-install)"
arch=(any)
license=(MIT)
depends=(deckos-settings python pyside6 qt6-svg gum jq curl arch-install-scripts reflector btrfs-progs
         gptfdisk util-linux kdialog konsole snapper grub-btrfs)

package() {
  cp -a "$startdir/rootfs/." "$pkgdir/"
  find "$pkgdir" -type d -exec chmod 755 {} +
  find "$pkgdir" -type f -exec chmod 644 {} +
  chmod 755 "$pkgdir"/usr/bin/deckos-installer
}
