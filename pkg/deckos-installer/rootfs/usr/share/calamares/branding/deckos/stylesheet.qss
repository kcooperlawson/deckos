/* DeckOS installer. Same language as Steady Downloader and DeckOS Hub: slate surfaces,
   1px #262B36 borders, 7-10px radii, Inter, and the blue-violet gradient on primary actions. */

QWidget {
    font-family: "Inter", "Inter Display", "Noto Sans";
    font-size: 13px;
    color: #E8EAF0;
}

#mainApp, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #0F1115;
}

#sidebarApp { background: #0B0D11; }
#logoApp { padding: 18px 0 10px 0; }

QLabel { background: transparent; }
QLabel:disabled { color: #5A6172; }

/* Buttons */
QPushButton {
    background: #171A21;
    border: 1px solid #262B36;
    border-radius: 7px;
    padding: 7px 16px;
    min-height: 20px;
}
QPushButton:hover   { background: #2A2F3B; }
QPushButton:pressed { background: #353B49; }
QPushButton:disabled { color: #5A6172; background: #13161C; }

/* Next / Install / Done: the brand gradient, like the DeckOS app tile. */
#view-button-next, #view-button-done {
    color: #FFFFFF;
    font-weight: 600;
    border: none;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #4C8DFF, stop:1 #7A5CFF);
}
#view-button-next:hover, #view-button-done:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #6AA2FF, stop:1 #8E75FF);
}
#view-button-next:disabled { background: #262B36; color: #5A6172; }

/* Inputs */
QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QTextEdit {
    background: #171A21;
    border: 1px solid #262B36;
    border-radius: 7px;
    padding: 6px 10px;
    selection-background-color: #4C8DFF;
}
QLineEdit:focus, QComboBox:focus { border-color: #4C8DFF; }
QComboBox QAbstractItemView {
    background: #22262F;
    border: 1px solid #262B36;
    selection-background-color: #4C8DFF;
}

/* Lists, trees (Software page, locales, partitions) */
QListView, QTreeView, QTableView {
    background: #171A21;
    alternate-background-color: #1B1E26;
    border: 1px solid #262B36;
    border-radius: 10px;
    padding: 4px;
    selection-background-color: #24314D;
    selection-color: #FFFFFF;
}
QHeaderView::section {
    background: #13161C;
    color: #8C94A6;
    border: none;
    border-bottom: 1px solid #262B36;
    padding: 6px;
}
QCheckBox::indicator, QTreeView::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid #353B49;
    background: #171A21;
    border-radius: 4px;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QTreeView::indicator:checked, QRadioButton::indicator:checked {
    background: #4C8DFF;
    border-color: #4C8DFF;
}

QGroupBox {
    border: 1px solid #262B36;
    border-radius: 10px;
    margin-top: 14px;
    padding: 12px;
}
QGroupBox::title { subcontrol-origin: margin; left: 12px; color: #8C94A6; }

/* Progress during install */
QProgressBar {
    background: #262B36;
    border: none;
    border-radius: 3px;
    max-height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    border-radius: 3px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4C8DFF, stop:1 #7A5CFF);
}

QScrollBar:vertical { width: 10px; background: transparent; }
QScrollBar::handle:vertical { background: #2A2F3B; border-radius: 4px; margin: 2px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #5A6172; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }

QToolTip { background: #22262F; color: #E8EAF0; border: 1px solid #262B36; }
