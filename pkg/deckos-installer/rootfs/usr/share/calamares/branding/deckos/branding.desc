---
componentName:        deckos
welcomeStyleCalamares: false
welcomeExpandingLogo: true
windowExpanding:      normal
windowSize:           1180px,780px
windowPlacement:      center
sidebar:              widget
navigation:           widget

strings:
    productName:         DeckOS
    shortProductName:    DeckOS
    version:             2026.10
    shortVersion:        2026.10
    versionedName:       DeckOS
    shortVersionedName:  DeckOS
    bootloaderEntryName: DeckOS
    productUrl:          https://github.com/kcooperlawson/deckos
    supportUrl:          https://github.com/kcooperlawson/deckos/issues
    knownIssuesUrl:      https://github.com/kcooperlawson/deckos/issues
    releaseNotesUrl:     https://github.com/kcooperlawson/deckos/commits/main

# Art is shared with the system (generated by assets/generate.py, rasterised by deckos-settings).
images:
    productLogo:    "/usr/share/deckos/branding/logo-256.png"
    productIcon:    "/usr/share/deckos/branding/logo-256.png"
    productWelcome: "/usr/share/deckos/branding/installer-welcome.png"

# Steady Downloader palette: deep slate sidebar, current step in the brand blue.
style:
    SidebarBackground:        "#0B0D11"
    SidebarText:              "#8C94A6"
    SidebarTextCurrent:       "#FFFFFF"
    SidebarBackgroundCurrent: "#4C8DFF"

slideshow:    "show.qml"
slideshowAPI: 2
