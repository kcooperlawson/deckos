#!/usr/bin/env bash
# Starts the DeckOS installer (Calamares) as root inside the live Plasma session.
# Its full log ends up in /root/.cache/calamares/session.log (copied to the desktop on exit).
if command -v xhost >/dev/null; then xhost +si:localuser:root >/dev/null 2>&1; fi
sudo --preserve-env=WAYLAND_DISPLAY,XDG_RUNTIME_DIR,DISPLAY,XAUTHORITY,XDG_SESSION_TYPE,XDG_CURRENT_DESKTOP,KDE_FULL_SESSION,KDE_SESSION_VERSION,QT_QPA_PLATFORM,DBUS_SESSION_BUS_ADDRESS \
  calamares -D 6 "$@"
status=$?
sudo cp /root/.cache/calamares/session.log "$HOME/Desktop/installer-log.txt" 2>/dev/null &&
  sudo chown "$USER:" "$HOME/Desktop/installer-log.txt"
exit $status
