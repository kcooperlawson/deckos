[Desktop Entry]
Type=Application
Name=DecKoOS Terminal
GenericName=Terminal
Comment=Command line, with your projects and DecKoOS built in
Keywords=terminal;shell;console;command line;prompt;bash;
Icon=deckos-terminal
Exec=deckos-terminal
Categories=Qt;KDE;System;TerminalEmulator;
StartupNotify=true
StartupWMClass=deckos-terminal
X-KDE-AuthorizeAction=shell_access
Actions=new-window;

[Desktop Action new-window]
Name=New window
Exec=deckos-terminal
