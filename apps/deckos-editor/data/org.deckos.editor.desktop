[Desktop Entry]
Type=Application
Name=DecKoOS Editor
GenericName=Text editor
Comment=Edit text, code and config files, with colours for 300+ languages
Keywords=text;editor;code;notepad;config;txt;markdown;
Icon=deckos-editor
Exec=deckos-editor %F
Categories=Qt;KDE;Utility;TextEditor;Development;
MimeType=text/plain;text/markdown;text/x-csrc;text/x-chdr;text/x-c++src;text/x-c++hdr;text/x-python;text/x-shellscript;application/x-shellscript;application/json;application/xml;text/xml;text/html;text/css;application/javascript;text/x-cmake;text/x-makefile;application/toml;application/x-yaml;text/x-log;application/x-desktop;text/x-ini;text/x-qml;
StartupNotify=true
StartupWMClass=deckos-editor
Actions=new-window;

[Desktop Action new-window]
Name=New window
Exec=deckos-editor --new-window
