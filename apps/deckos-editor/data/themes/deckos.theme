{
    "metadata": {
        "name": "DeckOS",
        "revision": 1,
        "license": "MIT"
    },
    "text-styles": {
        "Normal": { "text-color": "#E8EAF0", "selected-text-color": "#FFFFFF" },
        "Keyword": { "text-color": "#B79CFF" },
        "ControlFlow": { "text-color": "#B79CFF", "bold": true },
        "Function": { "text-color": "#6FA8FF" },
        "Variable": { "text-color": "#E8EAF0" },
        "Operator": { "text-color": "#A3ABBD" },
        "BuiltIn": { "text-color": "#5FD0C0" },
        "Extension": { "text-color": "#6FA8FF" },
        "Preprocessor": { "text-color": "#F07C9E" },
        "Import": { "text-color": "#F07C9E" },
        "Attribute": { "text-color": "#6FA8FF" },
        "DataType": { "text-color": "#F0B86E" },
        "DecVal": { "text-color": "#F59E7C" },
        "BaseN": { "text-color": "#F59E7C" },
        "Float": { "text-color": "#F59E7C" },
        "Constant": { "text-color": "#F59E7C" },
        "Char": { "text-color": "#8BD49C" },
        "SpecialChar": { "text-color": "#5FD0C0" },
        "String": { "text-color": "#8BD49C" },
        "VerbatimString": { "text-color": "#8BD49C" },
        "SpecialString": { "text-color": "#5FD0C0" },
        "Comment": { "text-color": "#6B7385", "italic": true },
        "Documentation": { "text-color": "#7D8699", "italic": true },
        "Annotation": { "text-color": "#F0B86E" },
        "CommentVar": { "text-color": "#9AA3B5", "italic": true },
        "RegionMarker": { "text-color": "#6B7385" },
        "Information": { "text-color": "#8BD49C" },
        "Warning": { "text-color": "#F5B84B" },
        "Alert": { "text-color": "#F5B84B", "bold": true },
        "Error": { "text-color": "#FF6B6B", "underline": true },
        "Others": { "text-color": "#5FD0C0" }
    },
    "editor-colors": {
        "BackgroundColor": "#0F1115",
        "TextSelection": "#26385E",
        "CurrentLine": "#151820",
        "LineNumbers": "#4A5162",
        "CurrentLineNumber": "#E8EAF0",
        "IconBorder": "#0F1115",
        "Separator": "#262B36",
        "BracketMatching": "#2A3550",
        "SearchHighlight": "#4A3A12",
        "ReplaceHighlight": "#1F4A33",
        "IndentationLine": "#1D212A",
        "TabMarker": "#262B36",
        "SpellChecking": "#FF6B6B",
        "WordWrapMarker": "#1D212A",
        "CodeFolding": "#1D212A",
        "MarkBookmark": "#4C8DFF",
        "MarkBreakpointActive": "#FF6B6B",
        "MarkBreakpointReached": "#F5B84B",
        "MarkBreakpointDisabled": "#5A6172",
        "MarkExecution": "#8BD49C",
        "MarkWarning": "#F5B84B",
        "MarkError": "#FF6B6B",
        "ModifiedLines": "#F5B84B",
        "SavedLines": "#8BD49C",
        "TemplateBackground": "#171A21",
        "TemplatePlaceholder": "#1D212A",
        "TemplateFocusedPlaceholder": "#26385E",
        "TemplateReadOnlyPlaceholder": "#171A21"
    }
}
