#!/usr/bin/env bash
# deckos-install - installs DecKoOS from the live USB onto one partition, into free space or onto an
# empty disk, next to Windows.
#
# Formats ONLY the partition you pick, or the one it makes in free space. An existing EFI partition is
# reused (never formatted); an empty disk gets its own. Every other partition and drive is left
# exactly as it is (never moved or resized); NTFS drives get mounted, not converted.
set -Eeuo pipefail

SRC=${DECKOS_SRC:-/opt/deckos}
export LOG=/var/log/deckos-install.log
MNT=/mnt
ESP_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
MSR_GUID=e3c9e316-0b5c-4db8-817d-f92df00215ae
RECOVERY_GUID=de94bba4-06d1-4d40-a16a-bfd50179d6ac
LINUX_FS_GUID=0fc63daf-8483-4772-8e79-3d69d8477de4
BTRFS_OPTS=noatime,compress=zstd:1
# Defaults detected from the Windows install this was built for.
DEFAULT_TZ=America/New_York
DEFAULT_LOCALE=en_US.UTF-8
DEFAULT_KEYMAP=us
CMDLINE="quiet splash loglevel=3 nowatchdog zswap.enabled=0"
DECKOS_TOOL=$SRC/pkg/deckos-settings/rootfs/usr/bin/deckos
# What gets installed: shipped in deckos-settings too, so the Hub can add groups later.
PACKAGES=$SRC/pkg/deckos-settings/rootfs/usr/share/deckos/packages
USB_REPO=$SRC/repo  # prebuilt DecKoOS + AUR packages on the live USB (build.sh)

export GUM_CHOOSE_CURSOR_FOREGROUND="#4C8DFF" GUM_CHOOSE_SELECTED_FOREGROUND="#4C8DFF"
export GUM_CHOOSE_HEADER_FOREGROUND="#8C94A6" GUM_INPUT_CURSOR_FOREGROUND="#4C8DFF"
export GUM_INPUT_PROMPT_FOREGROUND="#4C8DFF" GUM_CONFIRM_SELECTED_BACKGROUND="#4C8DFF"
export GUM_SPIN_SPINNER_FOREGROUND="#4C8DFF" GUM_FILTER_INDICATOR_FOREGROUND="#4C8DFF"
export GUM_FILTER_MATCH_FOREGROUND="#4C8DFF"

FAILED=()
# Optional software groups (<group>.txt in PACKAGES); base and desktop always go in.
OPTIONAL_GROUPS=(gaming ai dev)
declare -A GROUP_DESC=(
  [gaming]="Gaming: Steam + Gaming Mode, Proton, Lutris, Heroic, MangoHud, Discord, OBS"
  [ai]="Local AI: Ollama on a Radeon RX 7000/9000 (ROCm) or an NVIDIA card (CUDA); a large download"
  [dev]="Development: Claude Code, VS Code, JetBrains Toolbox, Docker, Node, Python, .NET, Java"
)
# DECKOS_GUI=1: driven by the graphical installer. Nothing is asked; the answers come from
# DECKOS_TARGET, DECKOS_HOSTNAME, DECKOS_USER, DECKOS_PASSWORD_FILE, DECKOS_TZ, DECKOS_LOCALE,
# DECKOS_KEYMAP (an XKB layout from keyboards.tsv) and DECKOS_GROUPS (comma-separated optional
# groups, all of them if unset), and output is plain text that the window turns into its
# progress view.
GUI=${DECKOS_GUI:-}

# ------------------------------------------------------------------ helpers

# Everything here must render on the bare Linux text console: its font has no emoji, braille
# spinners or double-line borders, so status marks are plain [ OK ]-style tags.
style() {
  if [[ -z $GUI ]]; then gum style "$@"; return; fi
  while [[ $# -gt 0 ]]; do  # plain text: drop gum's styling flags
    case $1 in --bold) shift ;; --*) shift 2 ;; *) printf '%s\n' "$1"; shift ;; esac
  done
}
# busy "Title" cmd args... - gum's spinner on the console, a plain status line for the window.
busy() {
  local title=$1; shift
  if [[ -n $GUI ]]; then echo "  [ .. ] $title"; "$@"; return; fi
  gum spin --spinner line --title " $title" -- "$@"
}
section() { echo; style --foreground "#4C8DFF" --bold "// $*"; }
note()    { style --foreground "#8C94A6" "  $*"; }
good()    { style --foreground "#3DD68C" "  [ OK ] $*"; }
warn()    { style --foreground "#F5B84B" "  [ !! ] $*"; }
# What to do about a failure, in plain words, from the end of the log: the usual causes have a clear next step.
fail_hint() {
  local tail; tail=$(tail -n 60 "$LOG" 2>/dev/null || true)
  case $tail in
    *"Could not resolve host"*|*"failed retrieving file"*|*"Temporary failure in name resolution"*|*"Network is unreachable"*)
      echo "The internet connection dropped or is too slow. Check the connection (top right), then install again." ;;
    *"No space left on device"*)
      echo "The partition is too small for what you picked. Choose a bigger one, or leave out Local AI or Development." ;;
    *"invalid or corrupted package"*|*"signature from"*|*"unknown trust"*|*"keyring"*)
      echo "A download didn't match its signature, usually a mirror that's mid-update. Wait a few minutes and install again." ;;
    *"Input/output error"*|*"I/O error"*)  # "Buffer I/O error" too
      echo "The disk or the USB stick reported read/write errors. Try another USB port, or write the USB stick again." ;;
    *"could not satisfy dependencies"*|*"conflicting dependencies"*|*"target not found"*)
      echo "The package lists changed upstream. Install again later, or use the newest DecKoOS USB stick." ;;
  esac
}
die() {
  local hint
  { set +x; } 2>/dev/null
  style --foreground "#FF6B6B" --bold "  [FAIL] $*"
  hint=$(fail_hint)
  [[ -z $hint ]] || style --foreground "#F5B84B" "  [HINT] $hint"
  [[ -s $LOG ]] && { echo; note "Last lines of $LOG:"; tail -n 25 "$LOG"; }
  exit 1
}
# What a failure has touched so far, for the failure message: nothing, partition or boot.
CHANGED=nothing
changed_note() {
  case $CHANGED in
    nothing) echo "Nothing was changed." ;;
    partition) echo "Only $TARGET was changed, and it's unusable until you install again." ;;
    boot) echo "$TARGET and the boot menu on $ESP were changed. If the PC won't start, pick Windows Boot" \
               "Manager in your firmware's boot menu (often F11, F12 or F8 at power-on)." ;;
  esac
}
trap 'die "Something failed on line $LINENO. $(changed_note)"' ERR

# spin "Title" cmd args... - runs quietly into the log with a spinner.
spin() {
  local title=$1; shift
  echo "### $title :: $*" >> "$LOG"
  busy "$title" bash -c '"$@" >>"$LOG" 2>&1' _ "$@" \
    || die "$title failed. $(changed_note)"
  good "$title"
}
inchroot() { arch-chroot "$MNT" "$@"; }

# A second column names the graphics vendor a package is for (amd, nvidia, intel; GPU_VENDORS).
list_pkgs() {
  grep -vE '^\s*(#|$)' "$PACKAGES/$1.txt" | awk -v gpus=" ${GPU_VENDORS[*]} " \
    'NF == 1 || index(gpus, " " $2 " ") {print $1}'
}
gpu_has() { [[ " ${GPU_VENDORS[*]} " == *" $1 "* ]]; }
chosen() { [[ " ${CHOSEN[*]} " == *" $1 "* ]]; }
# AUR packages for the chosen groups (aur.txt's second column; none = always).
list_aur() {
  grep -vE '^\s*(#|$)' "$PACKAGES/aur.txt" | awk -v chosen=" ${CHOSEN[*]} " \
    'NF == 1 || index(chosen, " " $2 " ") {print $1}'
}

# Installs a package list in one transaction; if that fails, one by one, collecting failures.
install_group() {
  local name=$1 pkgs
  mapfile -t pkgs < <(list_pkgs "$name")
  echo "### pacman $name: ${pkgs[*]}" >> "$LOG"
  if busy "Installing $name (${#pkgs[@]} packages) - this can take a while" \
       bash -c 'arch-chroot "$0" pacman -S --needed --noconfirm "${@}" >>"$LOG" 2>&1' "$MNT" "${pkgs[@]}"; then
    good "$name packages"
    return
  fi
  warn "$name: retrying package by package"
  local p
  for p in "${pkgs[@]}"; do
    inchroot pacman -S --needed --noconfirm "$p" >>"$LOG" 2>&1 || FAILED+=("$p")
  done
  good "$name packages (with retries)"
}

# Mirrors in the time zone's country (COUNTRY), or worldwide if it has fewer than 3. reflector
# needs archlinux.org's mirror status, which is often slow or down. If it fails, use a short
# list of big, reliable mirrors instead of stopping the install.
rank_mirrors() {
  local ml=/etc/pacman.d/mirrorlist where title
  for where in "${COUNTRY:-}" worldwide; do
    [[ -n $where ]] || continue
    local args=(--latest 15 --protocol https --sort rate --connect-timeout 5 --download-timeout 8)
    if [[ $where == worldwide ]]; then title="Ranking mirrors worldwide"
    else title="Ranking mirrors in $where"; args+=(--country "$where"); fi
    echo "### $title" >> "$LOG"
    if busy "$title" bash -c 'reflector "$@" --save "$0.new" >>"$LOG" 2>&1' "$ml" "${args[@]}" \
       && [[ $(grep -c '^Server' "$ml.new" 2>/dev/null) -ge 3 ]]; then
      mv "$ml.new" "$ml"
      good "$title"
      return
    fi
    rm -f "$ml.new"
  done
  cat > "$ml" <<'EOF'
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirrors.mit.edu/archlinux/$repo/os/$arch
EOF
  warn "Mirror ranking failed - using a standard mirror list"
}

# pacstrap checks package signatures with the live USB's keyring (/etc/pacman.d/gnupg), which
# pacman-init.service fills at boot. That can fail or lag, for instance with the clock 4 hours off
# from Windows keeping local time in the hardware clock, and then CachyOS's signed database can't be
# read ("Public keyring not found", "keyring is not writable"). So check it, and rebuild it if needed.
CACHYOS_KEY=F3B607488DB35A47
live_keyring() {
  # Give NTP a moment first: keys and signatures dated "in the future" are refused.
  local i
  for i in $(seq 1 20); do
    [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) == yes ]] && break
    sleep 1
  done
  systemctl is-active --quiet pacman-init.service || timeout 120 systemctl start pacman-init.service 2>>"$LOG" || true
  if ! pacman-key --list-keys "$CACHYOS_KEY" >/dev/null 2>&1; then
    echo "### rebuilding the live keyring" >> "$LOG"
    { pacman-key --init && pacman-key --populate; } >>"$LOG" 2>&1 || true
  fi
  if ! pacman-key --list-keys "$CACHYOS_KEY" >/dev/null 2>&1; then
    { pacman-key --recv-keys "$CACHYOS_KEY" --keyserver keyserver.ubuntu.com \
        && pacman-key --lsign-key "$CACHYOS_KEY"; } >>"$LOG" 2>&1 || true
  fi
  pacman-key --list-keys "$CACHYOS_KEY" >/dev/null 2>&1
}

# fat32_clusters DEV - the data cluster count of a FAT32 file system, empty for anything else. UEFI
# firmware decides FAT12/16/32 from this count alone, so FAT32 under 65525 clusters (which Linux
# mounts fine) is unreadable to it.
fat32_clusters() {
  local -a b
  read -ra b < <(od -An -v -tu1 -N90 "$1" 2>/dev/null | tr -s ' \n' ' ') || true  # no newline at the end: read says 1
  [[ ${#b[@]} -eq 90 && ${b[*]:82:5} == "70 65 84 51 50" ]] || return 0  # "FAT32" at offset 82
  local spc=${b[13]} reserved=$((b[14] + b[15] * 256)) fats=${b[16]}
  local total=$((b[32] + b[33] * 256 + b[34] * 65536 + b[35] * 16777216))
  local fatsz=$((b[36] + b[37] * 256 + b[38] * 65536 + b[39] * 16777216))
  (( spc > 0 )) || return 0
  echo $(((total - reserved - fats * fatsz) / spc))
}

# table NAME - the rows of installer/NAME.tsv, without comments.
table() { grep -vE '^\s*(#|$)' "$SRC/installer/$1.tsv"; }

set_grub() {  # set_grub KEY VALUE - set or append in /etc/default/grub
  local f=$MNT/etc/default/grub
  if grep -qE "^#?$1=" "$f"; then sed -i -E "s|^#?$1=.*|$1=$2|" "$f"; else echo "$1=$2" >> "$f"; fi
}

# Partitions DecKoOS may go on: path, size, filesystem, label, disk model, 1 if the default, and
# why it can't be used (empty if it can). Skips the live USB / Ventoy stick, EFI, Microsoft
# reserved and recovery partitions. Encrypted, RAID/LVM members and anything mounted are listed
# but blocked: the Windows check below has to mount a partition to look inside, and can't.
# Runs as the live user for the window, so it only uses what lsblk can see without root.
# Mounted under /mnt is a previous failed install, which the installer unmounts itself: but only on the disk /mnt
# itself comes from. A drive someone mounted at /mnt/SSD is in use like any other mount.
mnt_disk() {
  local src
  src=$(findmnt -no SOURCE "$MNT" 2>/dev/null | sed 's/\[.*//') || true
  [[ -n $src ]] && lsblk -no PKNAME "$src" 2>/dev/null | head -n1 || true
}

list_targets() {
  local live_disk="" src
  if src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null); then live_disk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1); fi
  # The default is the empty 232 GB "NVME" partition on the Samsung 970 EVO Plus.
  lsblk -J -b -o PATH,NAME,TYPE,SIZE,FSTYPE,LABEL,PARTTYPE,MODEL,MOUNTPOINTS | jq -r \
    --arg esp "$ESP_GUID" --arg msr "$MSR_GUID" --arg rec "$RECOVERY_GUID" --arg live "$live_disk" --arg mnt "$MNT" --arg mntdisk "$(mnt_disk)" '
    .blockdevices[] | . as $d
    | select($d.name != $live)
    | select(([$d.children[]?.label] | index("Ventoy")) | not)
    | ($d.children // [])[] | select(.type == "part")
    | select(.parttype != $esp and .parttype != $msr and .parttype != $rec)
    | (.fstype // "") as $fs
    | [.mountpoints[]? | select(. != null and ($d.name != $mntdisk or (. != $mnt and (startswith($mnt + "/") | not))))] as $mp
    | (if $fs == "BitLocker" then "BitLocker-encrypted, so DecKoOS cannot check what is on it. Turn BitLocker off or delete this partition in Windows first."
       elif $fs == "crypto_LUKS" then "Encrypted (LUKS), so DecKoOS cannot check what is on it. Delete it in a partition manager first if you want to use it."
       elif ($fs | endswith("_member")) then "Part of a RAID, LVM or ZFS set. Erasing it would break the whole set."
       elif ($mp | index("[SWAP]")) then "In use as swap."
       elif ($mp | length) > 0 then "Mounted at " + ($mp | join(", ")) + ". Unmount it (eject it in Dolphin), then refresh."
       else "" end) as $why
    | [.path, ((.size / 1e9) | floor | tostring) + " GB", (if $fs == "" then "empty" else $fs end), (.label // "-"),
       ($d.model // "?"),
       (if $why == "" and (($d.model // "") | test("970 EVO")) and .label == "NVME" then "1" else "0" end), $why]
    | @tsv'
}

# Unused space DecKoOS can make its own partition in, in list_targets' columns. Nothing existing is
# deleted, moved or resized:
#   free:DISK:START:SECTORS  a gap of 1 GB or more on a GPT disk (512-byte sectors, 1 MiB aligned);
#                            DecKoOS adds one partition exactly there
#   free:DISK:disk           a disk with no partition table and no file system at all; it gets GPT,
#                            a 1 GB EFI partition of its own and DecKoOS
# Gaps under MIN_GB and space on MBR disks are listed, blocked, so people see why.
MIN_GB=64
list_free() {
  local live_disk="" src
  if src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null); then live_disk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1); fi
  lsblk -J -b -o PATH,NAME,TYPE,SIZE,PTTYPE,FSTYPE,LABEL,MODEL,START,MOUNTPOINTS | jq -r \
    --arg live "$live_disk" --argjson min "$MIN_GB" '
    def gb: (. / 1e9 | floor | tostring) + " GB";
    .blockdevices[] | . as $d
    | select($d.type == "disk" and $d.name != $live and ($d.name | test("^(zram|loop|sr|ram)") | not))
    | select(([$d.children[]?.label] | index("Ventoy")) | not)
    | [($d.children // [])[] | select(.type == "part")] as $parts
    | ($d.size / 512 | floor) as $total
    | if ($parts | length) == 0 then
        select(($d.pttype // "") == "" and ($d.fstype // "") == "" and ([$d.mountpoints[]? | select(. != null)] | length) == 0)
        | ["free:" + $d.path + ":disk", ($d.size | gb), "free", "Empty disk", ($d.model // "?"), "0",
           (if $d.size < $min * 1e9 then "Too small: DecKoOS needs \($min) GB." else "" end)]
      else
        [$parts[] | {s: .start, e: (.start + (.size / 512 | floor))}] | sort_by(.s) as $p
        | ([{e: 2048}] + $p + [{s: ($total - 34)}]) as $b
        | range(0; ($b | length) - 1) as $i
        | ((($b[$i].e + 2047) / 2048 | floor) * 2048) as $start
        | (((($b[$i + 1].s - $start) / 2048) | floor) * 2048) as $len
        | select($len * 512 >= 1e9)
        | ["free:" + $d.path + ":" + ($start | tostring) + ":" + ($len | tostring), ($len * 512 | gb), "free",
           "Free space", ($d.model // "?"), "0",
           (if ($d.pttype // "") != "gpt" then "This disk uses the older MBR layout; DecKoOS only adds partitions on GPT disks."
            elif $len * 512 < $min * 1e9 then "Only \($len * 512 | gb) free here: DecKoOS needs \($min) GB."
            else "" end)]
      end
    | @tsv'
}

# Whole disks DecKoOS may erase, in list_targets' columns: erase:DISK. Only when you pick one, and only after you
# type its name: everything on it goes (Windows too), nothing on any other disk. Never the live USB; blocked while
# anything on it is mounted, swap or part of a RAID/LVM/ZFS set, since erasing it would pull that from under the PC.
list_erase() {
  local live_disk="" src
  if src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null); then live_disk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1); fi
  lsblk -J -b -o PATH,NAME,TYPE,SIZE,FSTYPE,LABEL,MODEL,MOUNTPOINTS | jq -r \
    --arg live "$live_disk" --arg mnt "$MNT" --arg mntdisk "$(mnt_disk)" --argjson min "$MIN_GB" '
    def gb: (. / 1e9 | floor | tostring) + " GB";
    .blockdevices[] | . as $d
    | select($d.type == "disk" and $d.name != $live and ($d.name | test("^(zram|loop|sr|ram)") | not))
    | select(([$d.children[]?.label] | index("Ventoy")) | not)
    | [($d.children // [])[] | select(.type == "part")] as $parts
    | select(($parts | length) > 0)
    | [$d, $parts[] | .mountpoints[]? | select(. != null and ($d.name != $mntdisk or (. != $mnt and (startswith($mnt + "/") | not))))] as $mp
    | ["erase:" + $d.path, ($d.size | gb), "disk", "Whole disk", ($d.model // "?"), "0",
       (if ([$parts[].fstype // ""] | map(endswith("_member")) | any) then "Part of a RAID, LVM or ZFS set. Erasing it would break the whole set."
        elif ($mp | index("[SWAP]")) then "Used as swap right now."
        elif ($mp | length) > 0 then "In use: mounted at " + ($mp | join(", ")) + ". Unmount it (eject it in Dolphin), then refresh."
        elif $d.size < $min * 1e9 then "Too small: DecKoOS needs \($min) GB."
        else "" end)]
    | @tsv'
}

# What's on DISK, for the erase confirmation: PARTITION, SIZE, FS, LABEL, WHAT (Windows, encrypted, data, empty)
disk_contents() {
  local disk=$1 part size fs label what probe
  while IFS=$'\t' read -r part size fs label; do  # "-" for no file system or label: tab reads collapse empty fields
    what=data
    case $fs in
      BitLocker|crypto_LUKS) what=encrypted ;;
      -) what=empty ;;
      vfat) what=$( [[ $(lsblk -no PARTTYPE "$part") == "$ESP_GUID" ]] && echo boot || echo data) ;;
    esac
    probe=$(mktemp -d)
    if [[ $what == data || $what == boot ]] && mount -o ro "$part" "$probe" 2>/dev/null; then
      if [[ -d $probe/Windows/System32 ]]; then what=Windows
      elif [[ -d $probe/EFI/Microsoft ]]; then what="Windows boot"
      elif [[ -d $probe/Recovery/WindowsRE || -e $probe/hiberfil.sys ]]; then what="Windows recovery"; fi
      umount "$probe"
    fi
    rmdir "$probe"
    printf '%s\t%s GB\t%s\t%s\t%s\n' "$part" "$((size / 1000000000))" "$fs" "$label" "$what"
  done < <(lsblk -J -b -o NAME,PATH,SIZE,FSTYPE,LABEL,TYPE "$disk" | jq -r '.blockdevices[0].children[]?
             | select(.type == "part") | [.path, (.size | tostring), (.fstype // "-"), (.label // "-")] | @tsv')
}

# make_space SPEC WANT_ESP: makes the chosen space after the confirmation. SPEC is free:DISK:START:SECTORS (one
# partition in that gap), free:DISK:disk (an empty disk) or erase:DISK (a disk you chose to erase); the whole-disk
# kinds get GPT and, with WANT_ESP=yes, a 1 GB EFI partition first. Checks again first that the space is still
# what was listed. Sets MADE_PART, MADE_ESP (or "") and MADE_PARTNO.
make_space() {
  local spec=$1 want_esp=$2 kind disk start sectors parts layout
  MADE_PART="" MADE_ESP="" MADE_PARTNO=""
  IFS=: read -r kind disk start sectors <<<"$spec"
  section "Making room on $disk"
  if [[ $kind == erase ]]; then
    # $MNT was unmounted before this: nothing at all on the disk may be mounted now
    [[ -z $(lsblk -lnpo MOUNTPOINTS "$disk" | grep -v '^$' || true) ]] \
      || die "Something on $disk is mounted. Nothing was changed."
    CHANGED=partition
    local p
    while read -r p; do wipefs -aq "$p" >>"$LOG" 2>&1 || true; done < <(lsblk -lnpo PATH,TYPE "$disk" | awk '$2 == "part" {print $1}')
    wipefs -aq "$disk" >>"$LOG" 2>&1 || die "Couldn't clear $disk. $(changed_note)"
    start=disk
  fi
  if [[ $start == disk ]]; then
    if [[ $kind == free ]]; then
      [[ -z $(lsblk -dno PTTYPE "$disk") && -z $(lsblk -dno FSTYPE "$disk") && $(lsblk -lno NAME "$disk" | wc -l) == 1 ]] \
        || die "$disk isn't empty any more. Nothing was changed."
    fi
    CHANGED=partition
    layout='label: gpt\n'
    [[ $want_esp == yes ]] && layout+='size=1GiB, type=U, name="EFI system partition"\n'
    layout+='type=L, name="DeckOS"\n'
    # shellcheck disable=SC2059  # the layout is ours, with \n meant as newlines
    printf "$layout" | sfdisk -q "$disk" >>"$LOG" 2>&1 || die "Couldn't partition $disk. $(changed_note)"
    udevadm settle
    mapfile -t parts < <(lsblk -lnpo PATH,TYPE "$disk" | awk '$2 == "part" {print $1}')
    if [[ $want_esp == yes ]]; then
      MADE_ESP=${parts[0]:-} MADE_PART=${parts[1]:-}
      [[ -b $MADE_ESP && -b $MADE_PART ]] || die "The new partitions on $disk didn't show up. $(changed_note)"
      spin "Formatting the EFI partition $MADE_ESP" mkfs.fat -F 32 -n EFI "$MADE_ESP"
    else
      MADE_PART=${parts[0]:-}
      [[ -b $MADE_PART ]] || die "The new partition on $disk didn't show up. $(changed_note)"
    fi
  else
    # sfdisk -F: the unused ranges now (start end sectors size); the gap has to be one of them still
    sfdisk -F "$disk" 2>>"$LOG" | awk -v s="$start" -v n="$sectors" \
        '$1 ~ /^[0-9]+$/ && $1 <= s && $2 >= s + n - 1 {ok = 1} END {exit !ok}' \
      || die "The free space on $disk changed since it was listed. Nothing was changed."
    CHANGED=partition
    # --no-reread + partx: the disk's other partitions may be in use; only the new one is announced
    echo "start=$start, size=$sectors, type=L, name=\"DeckOS\"" | sfdisk -q --append --no-reread "$disk" >>"$LOG" 2>&1 \
      || die "Couldn't add a partition on $disk. Nothing else was changed."
    partx -a "$disk" >>"$LOG" 2>&1 || true
    udevadm settle
    MADE_PART=$(lsblk -lnpo PATH,TYPE,START "$disk" | awk -v s="$start" '$2 == "part" && $3 == s {print $1}')
    [[ -b $MADE_PART ]] || die "The new partition on $disk didn't show up. $(changed_note)"
  fi
  MADE_PARTNO=$(cat "/sys/class/block/$(basename "$MADE_PART")/partition")
  good "New partition $MADE_PART"
}

# check_partition PART: refuses Windows and anything DecKoOS can't look inside, and shows anything that would be
# lost. Only a partition that mounts can be checked for Windows, so one with a file system that won't mount (a
# hibernated Windows drive, a damaged or unknown one) is refused rather than trusted.
check_partition() {
  local part=$1 fstype probe used contents
  [[ -b $part ]] || die "No partition $part."
  fstype=$(lsblk -no FSTYPE "$part" | head -n1)
  probe=$(mktemp -d)
  if mount -o ro "$part" "$probe" 2>/dev/null; then
    if [[ -d $probe/Windows/System32 || -e $probe/bootmgr || -e $probe/hiberfil.sys || -d $probe/Recovery/WindowsRE ]]; then
      umount "$probe"; rmdir "$probe"
      die "$part holds Windows or its boot or recovery files. Pick a different partition, or erase its whole disk."
    fi
    mapfile -t contents < <(find "$probe" -mindepth 1 -maxdepth 1 ! -name 'System Volume Information' ! -name '$RECYCLE.BIN' -printf '%f\n' | head -n 15)
    used=$(df -h --output=used "$probe" | tail -1 | tr -d ' ')
    umount "$probe"
    if [[ ${#contents[@]} -gt 0 ]]; then
      warn "$part is NOT empty ($used used). These will be destroyed:"
      printf '      %s\n' "${contents[@]}"
    else
      good "$part is empty"
    fi
  elif [[ -n $fstype ]]; then
    rmdir "$probe"
    die "$part has a $fstype file system that DecKoOS can't open to check what's on it, so it won't erase it. If it's a Windows drive, start Windows and run 'powercfg /h off' as administrator (hibernation keeps it locked), or delete the partition in Disk Management to leave it empty."
  fi
  rmdir "$probe" 2>/dev/null || true
}

# The disk a choice is on: free:DISK:..., erase:DISK or a partition
choice_disk() {
  case $1 in
    free:*|erase:*) local _k d; IFS=: read -r _k d _ <<<"$1"; echo "$d" ;;
    *) echo "/dev/$(lsblk -no PKNAME "$1" | head -n1)" ;;
  esac
}

if [[ ${1:-} == --list-targets ]]; then list_targets; list_free; list_erase; exit 0; fi
if [[ ${1:-} == --disk-contents ]]; then disk_contents "${2:?}"; exit 0; fi

banner() {
  [[ -n $GUI ]] && return
  clear
  local word
  word="$(style --foreground '#E8EAF0' --bold 'D E C K ')$(style --foreground '#4C8DFF' --bold 'O')$(style --foreground '#E8EAF0' --bold ' S')"
  style --border normal --border-foreground "#4C8DFF" --padding "1 4" --margin "1 2" \
    "$word" "" "$(style --foreground '#8C94A6' 'INSTALLER')"
}

# Up to ~90 s for Ethernet/DHCP to come up, with a live countdown (no gum: plain printf).
# Any one of several sites will do: archlinux.org alone is sometimes slow or down.
NET_URLS=(https://geo.mirror.pkgbuild.com https://mirror.cachyos.org https://archlinux.org https://www.google.com)
NET_ERR=/tmp/deckos-net-check.txt
internet_ok() {
  local u
  : > "$NET_ERR"
  for u in "${NET_URLS[@]}"; do
    curl -sS -o /dev/null --connect-timeout 5 --max-time 10 "$u" 2>>"$NET_ERR" && return 0
  done
  return 1
}
wait_for_internet() {
  local i
  for i in $(seq 1 30); do
    if internet_ok; then printf '\r%60s\r' ''; return 0; fi
    printf '\r  Waiting for internet... %ds (Ethernet cable plugged in?)   ' "$((i * 3))"
    sleep 1
  done
  printf '\n'
  return 1
}

# ------------------------------------------------------------------ checks

banner
: > "$LOG"
# Trace every step into the log (not the screen) so a stall can be pinpointed afterwards.
exec 19>>"$LOG"
BASH_XTRACEFD=19
set -x
[[ $EUID -eq 0 ]] || die "Run as root (you are root by default on the live USB)."
[[ -d /sys/firmware/efi/efivars ]] || die "The USB was booted in legacy mode. Reboot and pick the UEFI entry for the USB."
[[ -d $SRC/pkg/deckos-settings ]] || die "DecKoOS files not found in $SRC."

section "Pre-flight"
note "Checking internet..."
until wait_for_internet; do
  warn "No internet yet. What failed:"
  sed 's/^/      /' "$NET_ERR" || true
  note "Network interfaces:"
  ip -br addr | grep -v '^lo ' | sed 's/^/      /' || true
  note "Ethernet: check the cable is in the motherboard's port (not the Xbox adapter)."
  note "Wi-Fi: connect from the network icon on the desktop panel, or run  nmtui  in another terminal"
  [[ -n $GUI ]] && die "No internet connection."
  read -rp "  Press Enter to try again... " _
done
good "internet"
# CachyOS picks the package build for the CPU itself (znver4, x86-64-v3/v4...): nothing to warn about
cpu=$(sed -n 's/^model name[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo | head -n1)
good "CPU: ${cpu:-unknown} (CachyOS picks the packages optimised for it)"
sb=$(od -An -t u1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | tr -d ' ' || true)
if [[ $sb == 1 ]]; then warn "Secure Boot is ON - turn it off in the BIOS (Security > Secure Boot) before rebooting into DecKoOS"
else good "Secure Boot off"; fi
timedatectl set-ntp true >/dev/null 2>&1 || true

# Graphics: amd, nvidia and/or intel. Picks the drivers below and the vendor lines in the package lists.
mapfile -t GPU_VENDORS < <(bash "$DECKOS_TOOL" display vendors 2>>"$LOG" || true)
if [[ ${#GPU_VENDORS[@]} -gt 0 ]]; then good "Graphics: ${GPU_VENDORS[*]}"
else warn "No AMD, NVIDIA or Intel graphics found - DecKoOS installs the basic Mesa drivers"; fi
gpu_has nvidia && note "NVIDIA drivers come from CachyOS's hardware detection (chwd) later on"
if gpu_has nvidia && [[ $sb == 1 ]]; then
  warn "With Secure Boot on, NVIDIA's driver won't load and the screen stays black: turn it off before restarting"
fi
if grep -qw GenuineIntel /proc/cpuinfo; then UCODE=intel-ucode; else UCODE=amd-ucode; fi

# Display blackout fix: DECKOS_DISPLAY_LEVEL if given, else what deckos recommends for this GPU
# and these monitors (the live session runs on the same hardware DecKoOS is going on).
if [[ ${DECKOS_DISPLAY_LEVEL:-} =~ ^[0-4]$ ]]; then
  DISPLAY_LEVEL=$DECKOS_DISPLAY_LEVEL display_why="chosen"
else
  rec=$(bash "$DECKOS_TOOL" display recommend 2>>"$LOG" || true)
  DISPLAY_LEVEL=${rec%%$'\t'*} display_why=${rec#*$'\t'}
  [[ $DISPLAY_LEVEL =~ ^[0-4]$ ]] || { DISPLAY_LEVEL=0; display_why="couldn't check the GPU"; }
fi
# The levels are amdgpu flags; they'd do nothing on other cards.
gpu_has amd || { DISPLAY_LEVEL=0 display_why="no AMD graphics card"; }
if [[ $DISPLAY_LEVEL == 0 ]]; then good "Display: stock settings ($display_why)"
else good "Display: blackout fix level $DISPLAY_LEVEL ($display_why)"; fi

# ------------------------------------------------------------------ target partition

section "Where should DecKoOS go?"
note "Only what you pick is erased: a partition, or a whole disk you choose to erase (you type its name to confirm). Free space and empty disks get a new partition. Everything else stays untouched."

# A failed earlier run leaves the target mounted under /mnt; free it before checking it.
umount -R "$MNT" 2>/dev/null || true
mapfile -t rows < <(list_targets; list_free; list_erase)
mapfile -t usable < <(printf '%s\n' "${rows[@]}" | awk -F'\t' 'NF && $7 == ""')
[[ ${#usable[@]} -gt 0 ]] || die "No suitable partitions found."

# choose_space HEADER [SKIP_DISK]: the text installer's list of usable places (none on SKIP_DISK)
choose_space() {
  local header=$1 skip=${2:-} r p s f l m d choices=() default="" line args
  for r in "${usable[@]}"; do
    IFS=$'\t' read -r p s f l m d _ <<<"$r"
    [[ -n $skip && $(choice_disk "$p") == "$skip" ]] && continue
    line=$(printf '%-24s %8s  %-6s %-10s %s' "$p" "$s" "$f" "$l" "$m")
    choices+=("$line")
    [[ -z $default && $d == 1 ]] && default=$line
  done
  [[ ${#choices[@]} -gt 0 ]] || return 1
  args=(--header "$header")
  [[ -n $default ]] && args+=(--selected "$default")
  line=$(gum choose "${args[@]}" "${choices[@]}")
  echo "${line%% *}"
}

# kind_of CHOICE: partition, gap (free space), disk (an empty disk) or erase (a disk to erase)
kind_of() {
  case $1 in
    free:*:disk) echo disk ;;
    free:*) echo gap ;;
    erase:*) echo erase ;;
    *) echo partition ;;
  esac
}

if [[ -n $GUI ]]; then
  TARGET=${DECKOS_TARGET:-} EXTRA=${DECKOS_EXTRA:-}
  printf '%s\n' "${usable[@]}" | cut -f1 | grep -qxF "$TARGET" || die "$TARGET is not a place DecKoOS can use."
  if [[ -n $EXTRA ]]; then
    printf '%s\n' "${usable[@]}" | cut -f1 | grep -qxF "$EXTRA" || die "$EXTRA is not a place DecKoOS can use."
  fi
else
  for r in "${rows[@]}"; do
    IFS=$'\t' read -r p _ _ _ _ _ why <<<"$r"
    [[ -n $why ]] && note "Not offered: $p - $why"
  done
  TARGET=$(choose_space "  Place                     Size     FS     Label      Disk") || die "No suitable place found."
  EXTRA=""
  if gum confirm "Add a second drive, so DecKoOS spans both as one bigger system? (If either drive fails, both are lost.)" --default=false; then
    EXTRA=$(choose_space "  The second drive: on a different disk" "$(choice_disk "$TARGET")") || { warn "No usable place on another disk"; EXTRA=""; }
  fi
fi

MAIN_KIND=$(kind_of "$TARGET")
TARGET_DISK=$(choice_disk "$TARGET")
[[ -b $TARGET_DISK ]] || die "No disk $TARGET_DISK."
EXTRA_KIND="" EXTRA_DISK=""
if [[ -n $EXTRA ]]; then
  EXTRA_KIND=$(kind_of "$EXTRA")
  EXTRA_DISK=$(choice_disk "$EXTRA")
  [[ -b $EXTRA_DISK ]] || die "No disk $EXTRA_DISK."
  [[ $EXTRA_DISK != "$TARGET_DISK" ]] || die "The second drive has to be a different disk."
fi

# describe_choice CHOICE: what happens to it, checked (partitions are looked inside; nothing is changed yet)
describe_choice() {
  local c=$1 disk
  disk=$(choice_disk "$c")
  case $(kind_of "$c") in
    disk) good "$disk is empty: DecKoOS gets the whole disk" ;;
    gap) good "Free space on $disk: DecKoOS adds a partition there; nothing on the disk is erased" ;;
    erase)
      warn "$disk will be ERASED completely. On it now:"
      disk_contents "$disk" | while IFS=$'\t' read -r part size fs label what; do
        note "    $part  $size  $fs  $label  ($what)"
      done ;;
    partition) check_partition "$c" ;;
  esac
}
describe_choice "$TARGET"
[[ -z $EXTRA ]] || describe_choice "$EXTRA"
[[ $MAIN_KIND == partition ]] && TARGET_PARTNO=$(cat "/sys/class/block/$(basename "$TARGET")/partition")
# Disks that get erased whole: their EFI partitions and Windows go with them
ERASED=()
[[ $MAIN_KIND == erase ]] && ERASED+=("$TARGET_DISK")
[[ $EXTRA_KIND == erase ]] && ERASED+=("$EXTRA_DISK")
erased() { [[ " ${ERASED[*]} " == *" $1 "* ]]; }

# ------------------------------------------------------------------ EFI partition

mapfile -t esps < <(lsblk -rpno PATH,PARTTYPE,PKNAME | awk -v g="$ESP_GUID" '$2==g {print $1" "$3}')
if [[ $MAIN_KIND == disk || $MAIN_KIND == erase ]]; then
  ESP="" WIN_BOOT=no  # made with the disk's partitions, after you confirm
  good "EFI partition: a new one on $TARGET_DISK, so it starts without any other disk"
else
  # An EFI partition on a disk being erased goes with it
  kept=()
  for e in "${esps[@]}"; do erased "/dev/${e#* }" || erased "${e#* }" || kept+=("$e"); done
  [[ ${#kept[@]} -gt 0 ]] || die "No EFI system partition left to use. (Windows normally has one; a disk you erase or an empty disk gets its own.)"
  ESP=""
  for e in "${kept[@]}"; do [[ /dev/${e#* } == "$TARGET_DISK" || ${e#* } == "$TARGET_DISK" ]] && ESP=${e%% *}; done
  if [[ -z $ESP && -n $GUI ]]; then
    ESP=${DECKOS_ESP:-${kept[0]%% *}}
  elif [[ -z $ESP ]]; then
    ESP=$(printf '%s\n' "${kept[@]%% *}" | gum choose --header "  Which EFI partition should hold the boot menu?")
  fi
  espprobe=$(mktemp -d)
  mount -o ro "$ESP" "$espprobe"
  [[ -d $espprobe/EFI/Microsoft ]] && WIN_BOOT=yes || WIN_BOOT=no
  esp_free=$(df -BM --output=avail "$espprobe" | tail -1 | tr -dc '0-9')
  umount "$espprobe"; rmdir "$espprobe"
  [[ $esp_free -ge 20 ]] || die "EFI partition $ESP has only ${esp_free} MB free (need 20 MB)."
  esp_clusters=$(fat32_clusters "$ESP")
  [[ -z $esp_clusters || $esp_clusters -ge 65525 ]] \
    || die "EFI partition $ESP is formatted in a way the PC's firmware can't read (FAT32 with only $esp_clusters clusters), so DecKoOS wouldn't start from it. Nothing was changed."
  good "EFI partition $ESP (shared, not formatted)$( [[ $WIN_BOOT == yes ]] && echo ' - Windows Boot Manager found' || true)"
fi
# Windows may boot from its own EFI partition on another disk; any Windows left decides the clock below.
WINDOWS=$WIN_BOOT
for e in "${esps[@]}"; do
  [[ $WINDOWS == no && ${e%% *} != "$ESP" ]] || continue
  erased "/dev/${e#* }" || erased "${e#* }" && continue
  espprobe=$(mktemp -d)
  if mount -o ro "${e%% *}" "$espprobe" 2>/dev/null; then
    [[ -d $espprobe/EFI/Microsoft ]] && WINDOWS=yes
    umount "$espprobe"
  fi
  rmdir "$espprobe"
done

# ------------------------------------------------------------------ you

section "You"
# Language and keyboard first, so the password is typed on the layout DecKoOS will use.
if [[ -n $GUI ]]; then
  LOCALE_=${DECKOS_LOCALE:-$DEFAULT_LOCALE} KEYMAP_=${DECKOS_KEYMAP:-$DEFAULT_KEYMAP}
else
  pick=$(table locales | awk -F'\t' '{printf "%-12s %s\n", $1, $2}' \
    | gum filter --placeholder "Language: type to search, Enter for English (US)" || true)
  LOCALE_=${pick%% *}
  pick=$(table keyboards | awk -F'\t' '{printf "%-6s %s\n", $1, $3}' \
    | gum filter --placeholder "Keyboard layout: type to search, Enter for English (US)" || true)
  KEYMAP_=${pick%% *}
fi
table locales | cut -f1 | grep -qxF "$LOCALE_" || die "Unknown language: $LOCALE_"
CONSOLE_KEYMAP=$(table keyboards | awk -F'\t' -v k="$KEYMAP_" '$1 == k {print $2}')
[[ -n $CONSOLE_KEYMAP ]] || die "Unknown keyboard layout: $KEYMAP_"
[[ -z $GUI ]] && { loadkeys "$CONSOLE_KEYMAP" >/dev/null 2>&1 || true; }

# No tracing while the password is in variables.
{ set +x; } 2>/dev/null
if [[ -n $GUI ]]; then
  HOSTNAME_=${DECKOS_HOSTNAME:-deckos} USERNAME_=${DECKOS_USER:-}
  [[ $USERNAME_ =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "Invalid username."
  [[ -r ${DECKOS_PASSWORD_FILE:-} ]] || die "No password given."
  PASS1=$(<"$DECKOS_PASSWORD_FILE"); PASS2=$PASS1
  rm -f "$DECKOS_PASSWORD_FILE"
  [[ -n $PASS1 ]] || die "Empty password."
else
HOSTNAME_=$(gum input --prompt "Computer name > " --value "deckos")
while :; do
  USERNAME_=$(gum input --prompt "Username > " --placeholder "lowercase, e.g. keagan")
  [[ $USERNAME_ =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && break
  warn "lowercase letters, digits, - and _ only"
done
while :; do
  PASS1=$(gum input --password --prompt "Password > ")
  PASS2=$(gum input --password --prompt "Again > ")
  [[ -n $PASS1 && $PASS1 == "$PASS2" ]] && break
  warn "passwords empty or different - try again"
done
fi
set -x
TZ_=${DECKOS_TZ:-$DEFAULT_TZ}
[[ -e /usr/share/zoneinfo/$TZ_ ]] || TZ_=$DEFAULT_TZ
if [[ -z $GUI ]]; then
  gum confirm "Timezone $DEFAULT_TZ (US Eastern)?" || TZ_=$(timedatectl list-timezones | gum filter --placeholder "type a city")
fi
# The time zone's country, for picking nearby mirrors.
COUNTRY=$(awk -v tz="$TZ_" '$3 == tz {print $1; exit}' /usr/share/zoneinfo/zone.tab 2>/dev/null || true)

# Software groups. Unset DECKOS_GROUPS means all of them; set but empty means none.
CHOSEN=()
if [[ -n $GUI ]]; then
  IFS=, read -ra CHOSEN <<<"${DECKOS_GROUPS-$(IFS=,; echo "${OPTIONAL_GROUPS[*]}")}"
  for g in "${CHOSEN[@]}"; do [[ -v GROUP_DESC[$g] ]] || die "Unknown software group: $g"; done
else
  for g in "${OPTIONAL_GROUPS[@]}"; do gum confirm "Install ${GROUP_DESC[$g]}?" && CHOSEN+=("$g"); done
fi
software="CachyOS kernel, KDE Plasma"
for g in "${CHOSEN[@]}"; do software+=", ${GROUP_DESC[$g]%%:*}"; done

# ------------------------------------------------------------------ confirm

section "Ready"
# what_line CHOICE: one line of the summary for a place
what_line() {
  local c=$1 disk
  disk=$(choice_disk "$c")
  case $(kind_of "$c") in
    partition) echo "ERASE      $(style --foreground '#FF6B6B' --bold "$c") -> DecKoOS" ;;
    erase) echo "ERASE      $(style --foreground '#FF6B6B' --bold "ALL of $disk") ($(lsblk -dno MODEL "$disk" | xargs)) -> DecKoOS" ;;
    disk) echo "NEW        $disk (empty) -> DecKoOS" ;;
    gap) echo "NEW        a partition in the free space on $disk -> DecKoOS (nothing erased)" ;;
  esac
}
lines=("$(what_line "$TARGET")")
[[ -z $EXTRA ]] || lines+=("$(what_line "$EXTRA")" "Spanning  both as one btrfs file system (if either drive fails, both are lost)")
if [[ $MAIN_KIND == disk || $MAIN_KIND == erase ]]; then lines+=("Boot menu  a new EFI partition on $TARGET_DISK")
else lines+=("Boot menu  $ESP (kept$( [[ $WIN_BOOT == yes ]] && echo '; DecKoOS + Windows' || true))"); fi
style --border rounded --border-foreground "#262B36" --padding "1 2" --margin "0 2" \
  "${lines[@]}" \
  "Keep       every other partition and drive" \
  "Display    blackout fix level $DISPLAY_LEVEL ($display_why)" \
  "User       $USERNAME_ @ $HOSTNAME_   |   $TZ_" \
  "Language   $LOCALE_   |   keyboard $KEYMAP_" \
  "Software   $software"
echo
# The window asks for this itself before it starts.
if [[ -n $GUI ]]; then confirm=${DECKOS_CONFIRM:-}
else confirm=$(gum input --prompt "Type ERASE to install > " --placeholder "ERASE"); fi
[[ $confirm == ERASE ]] || die "Cancelled - nothing was changed."
# A whole disk is only erased once its own name is typed too (the window asks for each, and passes them on)
for d in "${ERASED[@]}"; do
  if [[ -n $GUI ]]; then typed=$( [[ " ${DECKOS_ERASE_DISKS:-} " == *" ${d#/dev/} "* ]] && echo "${d#/dev/}" || true)
  else typed=$(gum input --prompt "Type ${d#/dev/} to erase that whole disk > " --placeholder "${d#/dev/}"); fi
  [[ $typed == "${d#/dev/}" ]] || die "Cancelled - $d wasn't confirmed, so nothing was changed."
done

# ------------------------------------------------------------------ disk

umount -R "$MNT" 2>/dev/null || true
if [[ $MAIN_KIND != partition ]]; then
  make_space "$TARGET" "$( [[ $MAIN_KIND == disk || $MAIN_KIND == erase ]] && echo yes || echo no)"
  TARGET=$MADE_PART TARGET_PARTNO=$MADE_PARTNO
  [[ -z $MADE_ESP ]] || ESP=$MADE_ESP
fi
DEVICES=("$TARGET")
if [[ -n $EXTRA ]]; then
  if [[ $EXTRA_KIND == partition ]]; then
    EXTRA_PART=$EXTRA EXTRA_PARTNO=$(cat "/sys/class/block/$(basename "$EXTRA")/partition")
  else
    make_space "$EXTRA" no
    EXTRA_PART=$MADE_PART EXTRA_PARTNO=$MADE_PARTNO
  fi
  DEVICES+=("$EXTRA_PART")
fi
section "Preparing ${DEVICES[*]}"
CHANGED=partition
for dev in "${DEVICES[@]}"; do
  spin "Wiping $dev" wipefs -af "$dev"
done
# Mark them as Linux partitions so Windows stops offering to "format" them.
spin "Setting partition type" sfdisk --part-type "$TARGET_DISK" "$TARGET_PARTNO" "$LINUX_FS_GUID"
[[ -z $EXTRA ]] || spin "Setting partition type" sfdisk --part-type "$EXTRA_DISK" "$EXTRA_PARTNO" "$LINUX_FS_GUID"
if [[ -z $EXTRA ]]; then
  spin "Creating btrfs" mkfs.btrfs -f -L DecKoOS "$TARGET"
else
  # One file system over both: data spread over them (single, so their sizes add up), the file system's own
  # records (metadata) kept twice, once on each
  spin "Creating btrfs over both drives" mkfs.btrfs -f -L DecKoOS -d single -m raid1 "${DEVICES[@]}"
fi
# The new file system's /dev/disk/by-uuid link only appears once udev re-reads the partition; grub-btrfs
# mounts by that link when the boot menu is written (a fresh empty disk failed there without this)
for dev in "${DEVICES[@]}"; do udevadm trigger --action=change "$dev" 2>/dev/null || true; done
udevadm settle || true
[[ -z $EXTRA ]] || btrfs device scan >>"$LOG" 2>&1 || true
mount "$TARGET" "$MNT"
for sv in @ @home @snapshots @log @pkg; do btrfs -q subvolume create "$MNT/$sv"; done
umount "$MNT"
mount -o "$BTRFS_OPTS,subvol=@" "$TARGET" "$MNT"
mkdir -p "$MNT"/{home,.snapshots,var/log,var/cache/pacman/pkg,boot/efi}
mount -o "$BTRFS_OPTS,subvol=@home" "$TARGET" "$MNT/home"
mount -o "$BTRFS_OPTS,subvol=@snapshots" "$TARGET" "$MNT/.snapshots"
mount -o "$BTRFS_OPTS,subvol=@log" "$TARGET" "$MNT/var/log"
mount -o "$BTRFS_OPTS,subvol=@pkg" "$TARGET" "$MNT/var/cache/pacman/pkg"
mount "$ESP" "$MNT/boot/efi"
[[ -z $EXTRA ]] || good "btrfs over ${DEVICES[*]}: $(btrfs filesystem usage -b "$MNT" 2>/dev/null | awk '/Device size:/ {printf "%d GB", $3 / 1e9}')"
good "btrfs subvolumes: @ @home @snapshots @log @pkg"

# ------------------------------------------------------------------ base system

section "Base system"
rank_mirrors
note "Checking package signing keys..."
if live_keyring; then good "package signing keys"
else die "The package signing keys couldn't be set up (CachyOS key $CACHYOS_KEY). $(changed_note)"; fi

spin "Installing Arch base" pacstrap -K "$MNT" base base-devel linux-firmware "$UCODE" btrfs-progs \
  gawk git sudo nano networkmanager grub efibootmgr os-prober curl jq
genfstab -U "$MNT" | sed -E 's/,subvolid=[0-9]+//; s/subvolid=[0-9]+,//' > "$MNT/etc/fstab"

ln -sf "/usr/share/zoneinfo/$TZ_" "$MNT/etc/localtime"
if [[ $WINDOWS == yes ]]; then
  # Windows keeps the hardware clock in local time; match it so the clock is right in both.
  inchroot hwclock --systohc --localtime >>"$LOG" 2>&1 || true
else
  inchroot hwclock --systohc --utc >>"$LOG" 2>&1 || true
fi
# English (US) is always generated too, as the fallback many tools expect.
sed -i "s/^#\($LOCALE_ \)/\1/; s/^#\($DEFAULT_LOCALE \)/\1/" "$MNT/etc/locale.gen"
inchroot locale-gen >>"$LOG" 2>&1
echo "LANG=$LOCALE_" > "$MNT/etc/locale.conf"
if [[ -z $(find "$MNT/usr/share/kbd/keymaps" -name "$CONSOLE_KEYMAP.map.gz" -print -quit) ]]; then
  warn "No console keymap '$CONSOLE_KEYMAP' - the text console uses US, the desktop still uses $KEYMAP_"
  CONSOLE_KEYMAP=us
fi
echo "KEYMAP=$CONSOLE_KEYMAP" > "$MNT/etc/vconsole.conf"
# The desktop's layout: xorg.conf.d for the login screen (and what localectl reports), and
# Plasma's system-wide default.
mkdir -p "$MNT/etc/X11/xorg.conf.d" "$MNT/etc/xdg"
printf 'Section "InputClass"\n  Identifier "system-keyboard"\n  MatchIsKeyboard "on"\n  Option "XkbLayout" "%s"\nEndSection\n' \
  "$KEYMAP_" > "$MNT/etc/X11/xorg.conf.d/00-keyboard.conf"
printf '[Layout]\nLayoutList=%s\nUse=true\n' "$KEYMAP_" > "$MNT/etc/xdg/kxkbrc"
echo "$HOSTNAME_" > "$MNT/etc/hostname"
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s.localdomain %s\n' "$HOSTNAME_" "$HOSTNAME_" > "$MNT/etc/hosts"
sed -i '/^#\[multilib\]/{N;s/#//g}' "$MNT/etc/pacman.conf"
sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 10/; s/^#Color/Color/' "$MNT/etc/pacman.conf"
good "language $LOCALE_, keyboard $KEYMAP_, time, hostname, multilib"

section "CachyOS optimised repos (Zen 4)"
mkdir -p "$MNT/root/cachyos-repo"
spin "Downloading CachyOS repo setup" curl -fsSL https://mirror.cachyos.org/cachyos-repo.tar.xz -o "$MNT/root/cachyos-repo/repo.tar.xz"
tar -xf "$MNT/root/cachyos-repo/repo.tar.xz" -C "$MNT/root/cachyos-repo"
spin "Adding CachyOS repos" arch-chroot "$MNT" bash -c 'cd /root/cachyos-repo/cachyos-repo && yes | ./cachyos-repo.sh'
rm -rf "$MNT/root/cachyos-repo"
grep -q '^\[cachyos-znver4\]' "$MNT/etc/pacman.conf" && good "znver4 repos enabled" || warn "znver4 repos not detected; using CachyOS generic repos"

# ------------------------------------------------------------------ software

section "Software"
for g in base desktop; do install_group "$g"; done

# NVIDIA and Intel drivers come from CachyOS's chwd: it picks the branch for the card (nvidia-open
# with its prebuilt CachyOS kernel modules, the legacy 580xx/470xx drivers, Intel's media driver)
# and sets up laptops with two GPUs. AMD-only PCs skip it: desktop.txt is the tested Radeon path.
if gpu_has nvidia || gpu_has intel; then
  if inchroot pacman -S --needed --noconfirm chwd >>"$LOG" 2>&1 \
     && busy "Picking graphics drivers (chwd)" bash -c 'arch-chroot "$0" chwd -a >>"$LOG" 2>&1' "$MNT"; then
    good "graphics drivers (chwd)"
  elif gpu_has nvidia; then
    # What chwd's nvidia-open profile installs on a modern card; older cards are left on nouveau.
    warn "chwd didn't finish - installing NVIDIA's open driver directly"
    nv=(nvidia-utils lib32-nvidia-utils egl-wayland libva-nvidia-driver opencl-nvidia lib32-opencl-nvidia)
    for k in linux-cachyos linux-cachyos-lts; do inchroot pacman -Q "$k" >/dev/null 2>&1 && nv+=("$k-nvidia-open"); done
    if inchroot pacman -S --needed --noconfirm "${nv[@]}" >>"$LOG" 2>&1; then
      # As chwd does: no kms hook, so nouveau isn't loaded before the NVIDIA driver.
      mkdir -p "$MNT/etc/mkinitcpio.conf.d"
      printf '%s\n' "# Written by deckos-install (chwd's nvidia setting)" 'HOOKS=(${HOOKS[@]/kms/})' \
        > "$MNT/etc/mkinitcpio.conf.d/10-chwd-kms.conf"
      good "NVIDIA open driver"
    else
      warn "NVIDIA driver didn't install - DecKoOS starts on nouveau; run 'sudo chwd -a' after first boot"
    fi
  else
    warn "chwd didn't finish - Intel graphics use the Mesa drivers from desktop.txt"
  fi
fi
for g in "${CHOSEN[@]}"; do install_group "$g"; done
# Flathub for the DecKoOS Store (apps that aren't in the Arch repos, like Spotify and Bottles).
if inchroot flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo >>"$LOG" 2>&1; then
  good "Flathub"
else
  warn "Flathub not added - the DecKoOS Store can set it up later"
fi

section "Your account"
groups=wheel
for g in video render input audio docker gamemode lp; do
  inchroot getent group "$g" >/dev/null && groups+=",$g"
done
inchroot useradd -m -G "$groups" -s /bin/bash "$USERNAME_"
{ set +x; } 2>/dev/null
printf '%s:%s\n' "$USERNAME_" "$PASS1" | inchroot chpasswd
inchroot passwd -l root >>"$LOG" 2>&1
unset PASS1 PASS2
set -x
echo '%wheel ALL=(ALL:ALL) ALL' > "$MNT/etc/sudoers.d/10-wheel"
chmod 440 "$MNT/etc/sudoers.d/10-wheel"
good "$USERNAME_ (groups: $groups) - root login disabled, use sudo"

# Temporary passwordless sudo so makepkg/paru can install as the new user. Removed below.
echo "$USERNAME_ ALL=(ALL) NOPASSWD: ALL" > "$MNT/etc/sudoers.d/00-deckos-install"
chmod 440 "$MNT/etc/sudoers.d/00-deckos-install"

# deckos-settings and the AUR apps are prebuilt in the USB's repo (build.sh), the same builds the
# ISO was tested with. Installing those copies skips building from source mid-install; anything
# the USB doesn't have (or a USB without the repo) is built as before.
USB_PKGS=/var/cache/deckos-usb
# usb_pkg NAME - copies NAME's package from the USB into the new system; prints its path there.
usb_pkg() {
  local f
  for f in "$USB_REPO"/*.pkg.tar.zst; do
    [[ -f $f && $(bsdtar -xOf "$f" .PKGINFO 2>/dev/null | sed -n 's/^pkgname = //p') == "$1" ]] || continue
    mkdir -p "$MNT$USB_PKGS"
    cp "$f" "$MNT$USB_PKGS/"
    echo "$USB_PKGS/${f##*/}"
    return 0
  done
  return 1
}

section "DecKoOS layer"
# deckos-settings depends on DecKoOS's own apps (Files, Terminal, Editor), so they go in together.
if pkgfile=$(usb_pkg deckos-settings) && filesfile=$(usb_pkg deckos-files) && termfile=$(usb_pkg deckos-terminal) \
   && editfile=$(usb_pkg deckos-editor); then
  spin "Installing deckos-settings, DecKoOS Files, Terminal and Editor" arch-chroot "$MNT" pacman -U --needed --noconfirm \
    "$filesfile" "$termfile" "$editfile" "$pkgfile"
else
  build=/home/$USERNAME_/.cache/deckos
  mkdir -p "$MNT$build"
  cp -a "$SRC/pkg" "$SRC/apps" "$SRC/VERSION" "$MNT$build/"
  inchroot chown -R "$USERNAME_:$USERNAME_" "/home/$USERNAME_/.cache"
  spin "Building DecKoOS Files" arch-chroot "$MNT" sudo -u "$USERNAME_" -H     bash -c "cd $build/pkg/deckos-files && makepkg -si --noconfirm"
  spin "Building DecKoOS Terminal" arch-chroot "$MNT" sudo -u "$USERNAME_" -H \
    bash -c "cd $build/pkg/deckos-terminal && makepkg -si --noconfirm"
  spin "Building DecKoOS Editor" arch-chroot "$MNT" sudo -u "$USERNAME_" -H \
    bash -c "cd $build/pkg/deckos-editor && makepkg -si --noconfirm"
  spin "Building deckos-settings (theme, tools, fixes)" arch-chroot "$MNT" sudo -u "$USERNAME_" -H \
    bash -c "cd $build/pkg/deckos-settings && makepkg -si --noconfirm"
fi
# deckos-settings added its [deckos] update repo. Until pacman has downloaded and verified that repo's
# database (the first `deckos update`), it refuses every other transaction, so the TMpikes theme and the
# AUR apps (pacman -U from the USB, paru) would all fail. The rest of the install leaves the repo out;
# it's put back before the end.
inchroot sed -i -e 's|^\[deckos\]$|#DECKOS-INSTALL# [deckos]|' \
  -e 's|^Include = /etc/pacman.d/deckos-repo$|#DECKOS-INSTALL# &|' /etc/pacman.conf
# Extra themes, to pick in DecKoOS Hub > Appearance. Optional: a USB without them is fine.
if pkgfile=$(usb_pkg deckos-theme-tmpikes); then
  if inchroot pacman -U --needed --noconfirm "$pkgfile" >>"$LOG" 2>&1; then good "TMpikes theme"
  else warn "TMpikes theme didn't install (see log)"; fi
fi

section "AUR"
mapfile -t aur < <(list_aur)
from_usb=() usb_names=() to_build=()
for p in "${aur[@]}"; do
  if f=$(usb_pkg "$p"); then from_usb+=("$f"); usb_names+=("$p"); else to_build+=("$p"); fi
done
if [[ ${#from_usb[@]} -gt 0 ]]; then
  echo "### pacman -U ${from_usb[*]}" >> "$LOG"
  if busy "Installing ${usb_names[*]} from the USB" \
       bash -c 'arch-chroot "$0" pacman -U --needed --noconfirm "${@}" >>"$LOG" 2>&1' "$MNT" "${from_usb[@]}"; then
    good "${usb_names[*]} (prebuilt on the USB)"
  else
    warn "Installing from the USB failed - building them instead"
    to_build=("${aur[@]}")
  fi
fi
for p in "${to_build[@]}"; do
  if busy "Building $p" bash -c \
       'arch-chroot "$0" sudo -u "$1" -H paru -S --needed --noconfirm --skipreview "$2" >>"$LOG" 2>&1' "$MNT" "$USERNAME_" "$p"; then
    good "$p"
  else
    warn "$p failed (see log)"; FAILED+=("$p")
  fi
done
rm -rf "${MNT:?}$USB_PKGS"

if ! chosen dev; then
  :
elif busy "Installing Claude Code" bash -c \
     'arch-chroot "$0" sudo -u "$1" -H bash -c "curl -fsSL https://claude.ai/install.sh | bash" >>"$LOG" 2>&1' "$MNT" "$USERNAME_"; then
  good "Claude Code (run: claude)"
else
  warn "Claude Code install failed - DecKoOS Hub has a button to retry"; FAILED+=("claude-code")
fi
rm -f "$MNT/etc/sudoers.d/00-deckos-install"
# The [deckos] update repo back on (left out while the AUR apps went in, above)
inchroot sed -i 's|^#DECKOS-INSTALL# ||' /etc/pacman.conf \
  || warn "Turn DecKoOS updates on in /etc/pacman.conf (remove the #DECKOS-INSTALL# marks)"
# pacstrap copied the live USB's unsigned [deckos] database; with the signed repo back on, every pacman
# command would say "missing required signature" until the first update. Fetch the signed one now,
# [deckos] alone (a pacman.conf with only that repo), so no other repo is half-updated. In /root, not /tmp:
# arch-chroot mounts a fresh tmpfs on /tmp, which hides a file written there from outside.
printf '[options]\nArchitecture = auto\n\n[deckos]\nInclude = /etc/pacman.d/deckos-repo\n' > "$MNT/root/deckos-only.conf"
if inchroot pacman -Sy --config /root/deckos-only.conf >>"$LOG" 2>&1; then good "DecKoOS updates on"
else
  rm -f "$MNT"/var/lib/pacman/sync/deckos.{db,files}{,.sig}
  warn "DecKoOS updates are on but couldn't be checked yet (no connection?); the first 'deckos update' does it"
fi
rm -f "$MNT/root/deckos-only.conf"

# ------------------------------------------------------------------ drives

section "Your drives (kept as NTFS)"
uid=$(inchroot id -u "$USERNAME_"); gid=$(inchroot id -g "$USERNAME_")
block=$(bash "$DECKOS_TOOL" drives fstab --uid "$uid" --gid "$gid")
printf '\n%s\n' "$block" >> "$MNT/etc/fstab"
# No NTFS drives is fine (a Linux-only PC, or BitLocker); grep finding nothing mustn't stop the install.
while read -r m; do mkdir -p "$MNT/mnt/$m"; good "/mnt/$m"; done < <(grep -oP '(?<=  /mnt/)\S+' <<<"$block" || true)
if ! grep -q '  /mnt/' <<<"$block"; then
  warn "No Windows (NTFS) drives found to mount - if you have some, run 'sudo deckos drives rescan' after first boot"
fi

# ------------------------------------------------------------------ boot

section "Boot"
# amdgpu early so the boot splash and display flags apply from the start; NVIDIA's open modules
# load from the root file system (chwd's mkinitcpio.conf.d drop-in drops kms for them).
if gpu_has amd; then modules=amdgpu; else modules=""; fi
sed -i -E "s/^MODULES=.*/MODULES=($modules)/" "$MNT/etc/mkinitcpio.conf"
# btrfs: a file system over two drives needs both found before it mounts (the hook scans for them)
hooks="base udev plymouth autodetect microcode modconf kms keyboard keymap consolefont block$( [[ -n $EXTRA ]] && echo ' btrfs' || true) filesystems grub-btrfs-overlayfs"
sed -i -E "s/^HOOKS=.*/HOOKS=($hooks)/" "$MNT/etc/mkinitcpio.conf"
inchroot plymouth-set-default-theme deckos >>"$LOG" 2>&1 || warn "plymouth theme not set"
spin "Building initramfs" arch-chroot "$MNT" mkinitcpio -P

set_grub GRUB_DISTRIBUTOR '"DecKoOS"'
set_grub GRUB_TIMEOUT 5
# The main kernel first: GRUB sorts by name, which put linux-cachyos-lts (the fallback) at the top
set_grub GRUB_TOP_LEVEL '"/boot/vmlinuz-linux-cachyos"'
display_flags=$(bash "$DECKOS_TOOL" display flags "$DISPLAY_LEVEL")
set_grub GRUB_CMDLINE_LINUX_DEFAULT "\"$CMDLINE${display_flags:+ $display_flags}\""
set_grub GRUB_DISABLE_OS_PROBER false
set_grub GRUB_THEME '"/usr/share/grub/themes/deckos/theme.txt"'
set_grub GRUB_GFXMODE 1920x1080,auto
mkdir -p "$MNT/etc/deckos" && printf '# Managed by deckos display set\nLEVEL=%s\n' "$DISPLAY_LEVEL" > "$MNT/etc/deckos/display.conf"

# snapper wants to create /.snapshots itself; swap it for our @snapshots subvolume after.
umount "$MNT/.snapshots"; rmdir "$MNT/.snapshots"
spin "Configuring snapshots" arch-chroot "$MNT" snapper --no-dbus -c root create-config /
btrfs -q subvolume delete "$MNT/.snapshots"
mkdir "$MNT/.snapshots"
mount -o "$BTRFS_OPTS,subvol=@snapshots" "$TARGET" "$MNT/.snapshots"
chmod 750 "$MNT/.snapshots"
sed -i -E 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/; s/^NUMBER_LIMIT=.*/NUMBER_LIMIT="12"/; s/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="6"/; s/^ALLOW_GROUPS=.*/ALLOW_GROUPS="wheel"/' \
  "$MNT/etc/snapper/configs/root"

spin "Snapshot: fresh install" arch-chroot "$MNT" snapper --no-dbus -c root create -d "Fresh DecKoOS install" -u important=yes
# /home gets hourly snapshots of its own (caches and Steam games left out).
if inchroot deckos home enable >>"$LOG" 2>&1; then good "/home snapshots (hourly)"
else warn "/home snapshots not set up - run 'sudo deckos home enable' after first boot"; fi
CHANGED=boot
spin "Installing GRUB to $ESP" arch-chroot "$MNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=DeckOS
udevadm settle || true  # the snapshot step below mounts by UUID
spin "Writing boot menu (DecKoOS, Windows, snapshots)" arch-chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg
grep -q 'Windows Boot Manager' "$MNT/boot/grub/grub.cfg" && good "Windows found for the boot menu" || warn "Windows not in the menu yet - run 'sudo grub-mkconfig -o /boot/grub/grub.cfg' after first boot"

section "Services"
services=(NetworkManager bluetooth sddm power-profiles-daemon fstrim.timer grub-btrfsd snapper-cleanup.timer
          deckos-display ananicy-cpp systemd-timesyncd)
chosen gaming && services+=(lactd)
chosen ai && services+=(ollama)
chosen dev && services+=(docker.socket)
for s in "${services[@]}"; do
  inchroot systemctl enable "$s" >>"$LOG" 2>&1 || warn "could not enable $s"
done
good "services enabled"

# Firewall: firewalld's default zone blocks incoming connections. Open only what DecKoOS's own
# apps need (firewall-offline-cmd edits the config without touching the live USB's firewall).
allow=(kdeconnect)
chosen gaming && allow+=(steam-streaming)
for svc in "${allow[@]}"; do
  inchroot firewall-offline-cmd --add-service="$svc" >>"$LOG" 2>&1 || warn "firewall: couldn't open $svc"
done
if inchroot systemctl enable firewalld >>"$LOG" 2>&1; then good "firewall on (open: ${allow[*]})"
else warn "could not enable the firewall"; fi

# ------------------------------------------------------------------ done

cp "$LOG" "$MNT/var/log/deckos-install.log"
trap - ERR  # DecKoOS is installed; nothing below may turn that into a failure
# pacman-key and AUR builds can leave gpg-agent and friends running inside the new system, which
# keeps /mnt busy. End whatever still runs there, then unmount (lazily if something still holds on).
for p in /proc/[0-9]*; do
  [[ $(readlink "$p/root" 2>/dev/null) == "$MNT" ]] && kill "${p#/proc/}" 2>/dev/null
done
sleep 1
sync
if ! umount -R "$MNT" 2>>"$LOG"; then
  umount -R -l "$MNT" 2>>"$LOG" || true
  warn "The new system was still busy, so it was detached lazily; restarting finishes that"
fi

section "DecKoOS is installed"
if [[ ${#FAILED[@]} -gt 0 ]]; then
  warn "These didn't install (DecKoOS still works; retry later with paru -S): ${FAILED[*]}"
fi
style --margin "1 2" --foreground "#8C94A6" \
  "Before you boot DecKoOS:" \
  "  1. BIOS: Secure Boot off. DecKoOS is now first in the boot order (Windows is in its menu)." \
  "  2. Windows: run 'powercfg /h off' as admin once, or your NTFS drives mount read-only." \
  "After first login:" \
  "  - DecKoOS Hub (bottom panel) - display fix level, Gaming Mode, drives." \
  "  - If a screen blinks black: Hub > Display > 'Watch for blackouts', then step up a level."
[[ -z $GUI ]] && gum confirm "Reboot now?" && reboot
exit 0
