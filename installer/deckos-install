#!/usr/bin/env bash
# deckos-install - installs DeckOS from the live USB onto one partition, next to Windows.
#
# Formats ONLY the partition you pick. The EFI partition is reused (never formatted) and
# every other drive is left exactly as it is; NTFS drives get mounted, not converted.
set -Eeuo pipefail

SRC=${DECKOS_SRC:-/opt/deckos}
export LOG=/var/log/deckos-install.log
MNT=/mnt
ESP_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
MSR_GUID=e3c9e316-0b5c-4db8-817d-f92df00215ae
RECOVERY_GUID=de94bba4-06d1-4d40-a16a-bfd50179d6ac
LINUX_FS_GUID=0fc63daf-8483-4772-8e79-3d69d8477de4
BTRFS_OPTS=noatime,compress=zstd:1
# Defaults detected from the Windows install this was built for.
DEFAULT_TZ=America/New_York
DEFAULT_LOCALE=en_US.UTF-8
DEFAULT_KEYMAP=us
CMDLINE="quiet splash loglevel=3 nowatchdog zswap.enabled=0"
DECKOS_TOOL=$SRC/pkg/deckos-settings/rootfs/usr/bin/deckos
# What gets installed: shipped in deckos-settings too, so the Hub can add groups later.
PACKAGES=$SRC/pkg/deckos-settings/rootfs/usr/share/deckos/packages
USB_REPO=$SRC/repo  # prebuilt DeckOS + AUR packages on the live USB (build.sh)

export GUM_CHOOSE_CURSOR_FOREGROUND="#4C8DFF" GUM_CHOOSE_SELECTED_FOREGROUND="#4C8DFF"
export GUM_CHOOSE_HEADER_FOREGROUND="#8C94A6" GUM_INPUT_CURSOR_FOREGROUND="#4C8DFF"
export GUM_INPUT_PROMPT_FOREGROUND="#4C8DFF" GUM_CONFIRM_SELECTED_BACKGROUND="#4C8DFF"
export GUM_SPIN_SPINNER_FOREGROUND="#4C8DFF" GUM_FILTER_INDICATOR_FOREGROUND="#4C8DFF"
export GUM_FILTER_MATCH_FOREGROUND="#4C8DFF"

FAILED=()
# Optional software groups (<group>.txt in PACKAGES); base and desktop always go in.
OPTIONAL_GROUPS=(gaming ai dev)
declare -A GROUP_DESC=(
  [gaming]="Gaming: Steam + Gaming Mode, Proton, Lutris, Heroic, MangoHud, Discord, OBS"
  [ai]="Local AI: Ollama + ROCm on a Radeon RX 7000/9000 (a large download)"
  [dev]="Development: Claude Code, VS Code, JetBrains Toolbox, Docker, Node, Python, .NET, Java"
)
# DECKOS_GUI=1: driven by the graphical installer. Nothing is asked; the answers come from
# DECKOS_TARGET, DECKOS_HOSTNAME, DECKOS_USER, DECKOS_PASSWORD_FILE, DECKOS_TZ, DECKOS_LOCALE,
# DECKOS_KEYMAP (an XKB layout from keyboards.tsv) and DECKOS_GROUPS (comma-separated optional
# groups, all of them if unset), and output is plain text that the window turns into its
# progress view.
GUI=${DECKOS_GUI:-}

# ------------------------------------------------------------------ helpers

# Everything here must render on the bare Linux text console: its font has no emoji, braille
# spinners or double-line borders, so status marks are plain [ OK ]-style tags.
style() {
  if [[ -z $GUI ]]; then gum style "$@"; return; fi
  while [[ $# -gt 0 ]]; do  # plain text: drop gum's styling flags
    case $1 in --bold) shift ;; --*) shift 2 ;; *) printf '%s\n' "$1"; shift ;; esac
  done
}
# busy "Title" cmd args... - gum's spinner on the console, a plain status line for the window.
busy() {
  local title=$1; shift
  if [[ -n $GUI ]]; then echo "  [ .. ] $title"; "$@"; return; fi
  gum spin --spinner line --title " $title" -- "$@"
}
section() { echo; style --foreground "#4C8DFF" --bold "// $*"; }
note()    { style --foreground "#8C94A6" "  $*"; }
good()    { style --foreground "#3DD68C" "  [ OK ] $*"; }
warn()    { style --foreground "#F5B84B" "  [ !! ] $*"; }
die() {
  { set +x; } 2>/dev/null
  style --foreground "#FF6B6B" --bold "  [FAIL] $*"
  [[ -s $LOG ]] && { echo; note "Last lines of $LOG:"; tail -n 25 "$LOG"; }
  exit 1
}
# What a failure has touched so far, for the failure message: nothing, partition or boot.
CHANGED=nothing
changed_note() {
  case $CHANGED in
    nothing) echo "Nothing was changed." ;;
    partition) echo "Only $TARGET was changed, and it's unusable until you install again." ;;
    boot) echo "$TARGET and the boot menu on $ESP were changed. If the PC won't start, pick Windows Boot" \
               "Manager in your firmware's boot menu (often F11, F12 or F8 at power-on)." ;;
  esac
}
trap 'die "Something failed on line $LINENO. $(changed_note)"' ERR

# spin "Title" cmd args... - runs quietly into the log with a spinner.
spin() {
  local title=$1; shift
  echo "### $title :: $*" >> "$LOG"
  busy "$title" bash -c '"$@" >>"$LOG" 2>&1' _ "$@" \
    || die "$title failed. $(changed_note)"
  good "$title"
}
inchroot() { arch-chroot "$MNT" "$@"; }

list_pkgs() { grep -vE '^\s*(#|$)' "$PACKAGES/$1.txt" | awk '{print $1}'; }
chosen() { [[ " ${CHOSEN[*]} " == *" $1 "* ]]; }
# AUR packages for the chosen groups (aur.txt's second column; none = always).
list_aur() {
  grep -vE '^\s*(#|$)' "$PACKAGES/aur.txt" | awk -v chosen=" ${CHOSEN[*]} " \
    'NF == 1 || index(chosen, " " $2 " ") {print $1}'
}

# Installs a package list in one transaction; if that fails, one by one, collecting failures.
install_group() {
  local name=$1 pkgs
  mapfile -t pkgs < <(list_pkgs "$name")
  echo "### pacman $name: ${pkgs[*]}" >> "$LOG"
  if busy "Installing $name (${#pkgs[@]} packages) - this can take a while" \
       bash -c 'arch-chroot "$0" pacman -S --needed --noconfirm "${@}" >>"$LOG" 2>&1' "$MNT" "${pkgs[@]}"; then
    good "$name packages"
    return
  fi
  warn "$name: retrying package by package"
  local p
  for p in "${pkgs[@]}"; do
    inchroot pacman -S --needed --noconfirm "$p" >>"$LOG" 2>&1 || FAILED+=("$p")
  done
  good "$name packages (with retries)"
}

# Mirrors in the time zone's country (COUNTRY), or worldwide if it has fewer than 3. reflector
# needs archlinux.org's mirror status, which is often slow or down. If it fails, use a short
# list of big, reliable mirrors instead of stopping the install.
rank_mirrors() {
  local ml=/etc/pacman.d/mirrorlist where title
  for where in "${COUNTRY:-}" worldwide; do
    [[ -n $where ]] || continue
    local args=(--latest 15 --protocol https --sort rate --connect-timeout 5 --download-timeout 8)
    if [[ $where == worldwide ]]; then title="Ranking mirrors worldwide"
    else title="Ranking mirrors in $where"; args+=(--country "$where"); fi
    echo "### $title" >> "$LOG"
    if busy "$title" bash -c 'reflector "$@" --save "$0.new" >>"$LOG" 2>&1' "$ml" "${args[@]}" \
       && [[ $(grep -c '^Server' "$ml.new" 2>/dev/null) -ge 3 ]]; then
      mv "$ml.new" "$ml"
      good "$title"
      return
    fi
    rm -f "$ml.new"
  done
  cat > "$ml" <<'EOF'
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirrors.mit.edu/archlinux/$repo/os/$arch
EOF
  warn "Mirror ranking failed - using a standard mirror list"
}

# table NAME - the rows of installer/NAME.tsv, without comments.
table() { grep -vE '^\s*(#|$)' "$SRC/installer/$1.tsv"; }

set_grub() {  # set_grub KEY VALUE - set or append in /etc/default/grub
  local f=$MNT/etc/default/grub
  if grep -qE "^#?$1=" "$f"; then sed -i -E "s|^#?$1=.*|$1=$2|" "$f"; else echo "$1=$2" >> "$f"; fi
}

# Partitions DeckOS may go on: path, size, filesystem, label, disk model, 1 if the default, and
# why it can't be used (empty if it can). Skips the live USB / Ventoy stick, EFI, Microsoft
# reserved and recovery partitions. Encrypted, RAID/LVM members and anything mounted are listed
# but blocked: the Windows check below has to mount a partition to look inside, and can't.
# Runs as the live user for the window, so it only uses what lsblk can see without root.
# Mounted under /mnt is a previous failed install, which the installer unmounts itself.
list_targets() {
  local live_disk="" src
  if src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null); then live_disk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -n1); fi
  # The default is the empty 232 GB "NVME" partition on the Samsung 970 EVO Plus.
  lsblk -J -b -o PATH,NAME,TYPE,SIZE,FSTYPE,LABEL,PARTTYPE,MODEL,MOUNTPOINTS | jq -r \
    --arg esp "$ESP_GUID" --arg msr "$MSR_GUID" --arg rec "$RECOVERY_GUID" --arg live "$live_disk" --arg mnt "$MNT" '
    .blockdevices[] | . as $d
    | select($d.name != $live)
    | select(([$d.children[]?.label] | index("Ventoy")) | not)
    | ($d.children // [])[] | select(.type == "part")
    | select(.parttype != $esp and .parttype != $msr and .parttype != $rec)
    | (.fstype // "") as $fs
    | [.mountpoints[]? | select(. != null and . != $mnt and (startswith($mnt + "/") | not))] as $mp
    | (if $fs == "BitLocker" then "BitLocker-encrypted, so DeckOS cannot check what is on it. Turn BitLocker off or delete this partition in Windows first."
       elif $fs == "crypto_LUKS" then "Encrypted (LUKS), so DeckOS cannot check what is on it. Delete it in a partition manager first if you want to use it."
       elif ($fs | endswith("_member")) then "Part of a RAID, LVM or ZFS set. Erasing it would break the whole set."
       elif ($mp | index("[SWAP]")) then "In use as swap."
       elif ($mp | length) > 0 then "Mounted at " + ($mp | join(", ")) + ". Unmount it (eject it in Dolphin), then refresh."
       else "" end) as $why
    | [.path, ((.size / 1e9) | floor | tostring) + " GB", (if $fs == "" then "empty" else $fs end), (.label // "-"),
       ($d.model // "?"),
       (if $why == "" and (($d.model // "") | test("970 EVO")) and .label == "NVME" then "1" else "0" end), $why]
    | @tsv'
}

if [[ ${1:-} == --list-targets ]]; then list_targets; exit 0; fi

banner() {
  [[ -n $GUI ]] && return
  clear
  local word
  word="$(style --foreground '#E8EAF0' --bold 'D E C K ')$(style --foreground '#4C8DFF' --bold 'O')$(style --foreground '#E8EAF0' --bold ' S')"
  style --border normal --border-foreground "#4C8DFF" --padding "1 4" --margin "1 2" \
    "$word" "" "$(style --foreground '#8C94A6' 'INSTALLER')"
}

# Up to ~90 s for Ethernet/DHCP to come up, with a live countdown (no gum: plain printf).
# Any one of several sites will do: archlinux.org alone is sometimes slow or down.
NET_URLS=(https://geo.mirror.pkgbuild.com https://mirror.cachyos.org https://archlinux.org https://www.google.com)
NET_ERR=/tmp/deckos-net-check.txt
internet_ok() {
  local u
  : > "$NET_ERR"
  for u in "${NET_URLS[@]}"; do
    curl -sS -o /dev/null --connect-timeout 5 --max-time 10 "$u" 2>>"$NET_ERR" && return 0
  done
  return 1
}
wait_for_internet() {
  local i
  for i in $(seq 1 30); do
    if internet_ok; then printf '\r%60s\r' ''; return 0; fi
    printf '\r  Waiting for internet... %ds (Ethernet cable plugged in?)   ' "$((i * 3))"
    sleep 1
  done
  printf '\n'
  return 1
}

# ------------------------------------------------------------------ checks

banner
: > "$LOG"
# Trace every step into the log (not the screen) so a stall can be pinpointed afterwards.
exec 19>>"$LOG"
BASH_XTRACEFD=19
set -x
[[ $EUID -eq 0 ]] || die "Run as root (you are root by default on the live USB)."
[[ -d /sys/firmware/efi/efivars ]] || die "The USB was booted in legacy mode. Reboot and pick the UEFI entry for the USB."
[[ -d $SRC/pkg/deckos-settings ]] || die "DeckOS files not found in $SRC."

section "Pre-flight"
note "Checking internet..."
until wait_for_internet; do
  warn "No internet yet. What failed:"
  sed 's/^/      /' "$NET_ERR" || true
  note "Network interfaces:"
  ip -br addr | grep -v '^lo ' | sed 's/^/      /' || true
  note "Ethernet: check the cable is in the motherboard's port (not the Xbox adapter)."
  note "Wi-Fi: connect from the network icon on the desktop panel, or run  nmtui  in another terminal"
  [[ -n $GUI ]] && die "No internet connection."
  read -rp "  Press Enter to try again... " _
done
good "internet"
grep -qw avx512f /proc/cpuinfo && good "Zen 4 CPU (znver4-optimised packages)" || warn "CPU lacks AVX-512 - CachyOS will pick a compatible repo"
sb=$(od -An -t u1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | tr -d ' ' || true)
if [[ $sb == 1 ]]; then warn "Secure Boot is ON - turn it off in the BIOS (Security > Secure Boot) before rebooting into DeckOS"
else good "Secure Boot off"; fi
timedatectl set-ntp true >/dev/null 2>&1 || true

# Display blackout fix: DECKOS_DISPLAY_LEVEL if given, else what deckos recommends for this GPU
# and these monitors (the live session runs on the same hardware DeckOS is going on).
if [[ ${DECKOS_DISPLAY_LEVEL:-} =~ ^[0-4]$ ]]; then
  DISPLAY_LEVEL=$DECKOS_DISPLAY_LEVEL display_why="chosen"
else
  rec=$(bash "$DECKOS_TOOL" display recommend 2>>"$LOG" || true)
  DISPLAY_LEVEL=${rec%%$'\t'*} display_why=${rec#*$'\t'}
  [[ $DISPLAY_LEVEL =~ ^[0-4]$ ]] || { DISPLAY_LEVEL=0; display_why="couldn't check the GPU"; }
fi
if [[ $DISPLAY_LEVEL == 0 ]]; then good "Display: stock AMD settings ($display_why)"
else good "Display: blackout fix level $DISPLAY_LEVEL ($display_why)"; fi

# ------------------------------------------------------------------ target partition

section "Where should DeckOS go?"
note "Only the partition you pick is erased. Windows, its EFI partition and your other drives stay untouched."

# A failed earlier run leaves the target mounted under /mnt; free it before checking it.
umount -R "$MNT" 2>/dev/null || true
mapfile -t rows < <(list_targets)
mapfile -t usable < <(printf '%s\n' "${rows[@]}" | awk -F'\t' 'NF && $7 == ""')
[[ ${#usable[@]} -gt 0 ]] || die "No suitable partitions found."

if [[ -n $GUI ]]; then
  TARGET=${DECKOS_TARGET:-}
  printf '%s\n' "${usable[@]}" | cut -f1 | grep -qxF "$TARGET" || die "$TARGET is not a partition DeckOS can use."
else
  for r in "${rows[@]}"; do
    IFS=$'\t' read -r p _ _ _ _ _ why <<<"$r"
    [[ -n $why ]] && note "Not offered: $p - $why"
  done
  choices=() default=""
  for r in "${usable[@]}"; do
    IFS=$'\t' read -r p s f l m d _ <<<"$r"
    line=$(printf '%-16s %8s  %-6s %-10s %s' "$p" "$s" "$f" "$l" "$m")
    choices+=("$line")
    [[ -z $default && $d == 1 ]] && default=$line
  done
  choose_args=(--header "  Partition         Size     FS     Label      Disk")
  [[ -n $default ]] && choose_args+=(--selected "$default")
  pick=$(gum choose "${choose_args[@]}" "${choices[@]}")
  TARGET=${pick%% *}
fi
[[ -b $TARGET ]] || die "No partition selected."

# Refuse Windows and anything DeckOS can't look inside; show anything that would be lost.
# Only a partition that mounts can be checked for Windows, so one with a file system that won't
# mount (a hibernated Windows drive, a damaged or unknown one) is refused rather than trusted.
fstype=$(lsblk -no FSTYPE "$TARGET" | head -n1)
probe=$(mktemp -d)
if mount -o ro "$TARGET" "$probe" 2>/dev/null; then
  if [[ -d $probe/Windows/System32 || -e $probe/bootmgr || -e $probe/hiberfil.sys || -d $probe/Recovery/WindowsRE ]]; then
    umount "$probe"; rmdir "$probe"
    die "$TARGET holds Windows or its boot or recovery files. Pick a different partition."
  fi
  mapfile -t contents < <(find "$probe" -mindepth 1 -maxdepth 1 ! -name 'System Volume Information' ! -name '$RECYCLE.BIN' -printf '%f\n' | head -n 15)
  used=$(df -h --output=used "$probe" | tail -1 | tr -d ' ')
  umount "$probe"
  if [[ ${#contents[@]} -gt 0 ]]; then
    warn "$TARGET is NOT empty ($used used). These will be destroyed:"
    printf '      %s\n' "${contents[@]}"
  else
    good "$TARGET is empty"
  fi
elif [[ -n $fstype ]]; then
  rmdir "$probe"
  die "$TARGET has a $fstype file system that DeckOS can't open to check what's on it, so it won't erase it. If it's a Windows drive, start Windows and run 'powercfg /h off' as administrator (hibernation keeps it locked), or delete the partition in Disk Management to leave it empty."
fi
rmdir "$probe" 2>/dev/null || true

TARGET_DISK=/dev/$(lsblk -no PKNAME "$TARGET")
TARGET_PARTNO=$(cat "/sys/class/block/$(basename "$TARGET")/partition")

# ------------------------------------------------------------------ EFI partition

mapfile -t esps < <(lsblk -rpno PATH,PARTTYPE,PKNAME | awk -v g="$ESP_GUID" '$2==g {print $1" "$3}')
[[ ${#esps[@]} -gt 0 ]] || die "No EFI system partition found. (Windows normally has one.)"
ESP=""
for e in "${esps[@]}"; do [[ /dev/${e#* } == "$TARGET_DISK" || ${e#* } == "$TARGET_DISK" ]] && ESP=${e%% *}; done
if [[ -z $ESP && -n $GUI ]]; then
  ESP=${DECKOS_ESP:-${esps[0]%% *}}
elif [[ -z $ESP ]]; then
  ESP=$(printf '%s\n' "${esps[@]%% *}" | gum choose --header "  Which EFI partition should hold the boot menu?")
fi
espprobe=$(mktemp -d)
mount -o ro "$ESP" "$espprobe"
[[ -d $espprobe/EFI/Microsoft ]] && WIN_BOOT=yes || WIN_BOOT=no
esp_free=$(df -BM --output=avail "$espprobe" | tail -1 | tr -dc '0-9')
umount "$espprobe"; rmdir "$espprobe"
[[ $esp_free -ge 20 ]] || die "EFI partition $ESP has only ${esp_free} MB free (need 20 MB)."
good "EFI partition $ESP (shared, not formatted)$( [[ $WIN_BOOT == yes ]] && echo ' - Windows Boot Manager found')"
# Windows may boot from its own EFI partition on another disk; any Windows decides the clock below.
WINDOWS=$WIN_BOOT
for e in "${esps[@]%% *}"; do
  [[ $WINDOWS == no && $e != "$ESP" ]] || continue
  espprobe=$(mktemp -d)
  if mount -o ro "$e" "$espprobe" 2>/dev/null; then
    [[ -d $espprobe/EFI/Microsoft ]] && WINDOWS=yes
    umount "$espprobe"
  fi
  rmdir "$espprobe"
done

# ------------------------------------------------------------------ you

section "You"
# Language and keyboard first, so the password is typed on the layout DeckOS will use.
if [[ -n $GUI ]]; then
  LOCALE_=${DECKOS_LOCALE:-$DEFAULT_LOCALE} KEYMAP_=${DECKOS_KEYMAP:-$DEFAULT_KEYMAP}
else
  pick=$(table locales | awk -F'\t' '{printf "%-12s %s\n", $1, $2}' \
    | gum filter --placeholder "Language: type to search, Enter for English (US)" || true)
  LOCALE_=${pick%% *}
  pick=$(table keyboards | awk -F'\t' '{printf "%-6s %s\n", $1, $3}' \
    | gum filter --placeholder "Keyboard layout: type to search, Enter for English (US)" || true)
  KEYMAP_=${pick%% *}
fi
table locales | cut -f1 | grep -qxF "$LOCALE_" || die "Unknown language: $LOCALE_"
CONSOLE_KEYMAP=$(table keyboards | awk -F'\t' -v k="$KEYMAP_" '$1 == k {print $2}')
[[ -n $CONSOLE_KEYMAP ]] || die "Unknown keyboard layout: $KEYMAP_"
[[ -z $GUI ]] && { loadkeys "$CONSOLE_KEYMAP" >/dev/null 2>&1 || true; }

# No tracing while the password is in variables.
{ set +x; } 2>/dev/null
if [[ -n $GUI ]]; then
  HOSTNAME_=${DECKOS_HOSTNAME:-deckos} USERNAME_=${DECKOS_USER:-}
  [[ $USERNAME_ =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "Invalid username."
  [[ -r ${DECKOS_PASSWORD_FILE:-} ]] || die "No password given."
  PASS1=$(<"$DECKOS_PASSWORD_FILE"); PASS2=$PASS1
  rm -f "$DECKOS_PASSWORD_FILE"
  [[ -n $PASS1 ]] || die "Empty password."
else
HOSTNAME_=$(gum input --prompt "Computer name > " --value "deckos")
while :; do
  USERNAME_=$(gum input --prompt "Username > " --placeholder "lowercase, e.g. keagan")
  [[ $USERNAME_ =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && break
  warn "lowercase letters, digits, - and _ only"
done
while :; do
  PASS1=$(gum input --password --prompt "Password > ")
  PASS2=$(gum input --password --prompt "Again > ")
  [[ -n $PASS1 && $PASS1 == "$PASS2" ]] && break
  warn "passwords empty or different - try again"
done
fi
set -x
TZ_=${DECKOS_TZ:-$DEFAULT_TZ}
[[ -e /usr/share/zoneinfo/$TZ_ ]] || TZ_=$DEFAULT_TZ
if [[ -z $GUI ]]; then
  gum confirm "Timezone $DEFAULT_TZ (US Eastern)?" || TZ_=$(timedatectl list-timezones | gum filter --placeholder "type a city")
fi
# The time zone's country, for picking nearby mirrors.
COUNTRY=$(awk -v tz="$TZ_" '$3 == tz {print $1; exit}' /usr/share/zoneinfo/zone.tab 2>/dev/null || true)

# Software groups. Unset DECKOS_GROUPS means all of them; set but empty means none.
CHOSEN=()
if [[ -n $GUI ]]; then
  IFS=, read -ra CHOSEN <<<"${DECKOS_GROUPS-$(IFS=,; echo "${OPTIONAL_GROUPS[*]}")}"
  for g in "${CHOSEN[@]}"; do [[ -v GROUP_DESC[$g] ]] || die "Unknown software group: $g"; done
else
  for g in "${OPTIONAL_GROUPS[@]}"; do gum confirm "Install ${GROUP_DESC[$g]}?" && CHOSEN+=("$g"); done
fi
software="CachyOS kernel, KDE Plasma"
for g in "${CHOSEN[@]}"; do software+=", ${GROUP_DESC[$g]%%:*}"; done

# ------------------------------------------------------------------ confirm

section "Ready"
style --border rounded --border-foreground "#262B36" --padding "1 2" --margin "0 2" \
  "ERASE      $(style --foreground '#FF6B6B' --bold "$TARGET") -> btrfs (snapshots on)" \
  "Boot menu  $ESP (kept; DeckOS + Windows)" \
  "Keep       every other partition and drive" \
  "Display    blackout fix level $DISPLAY_LEVEL ($display_why)" \
  "User       $USERNAME_ @ $HOSTNAME_   |   $TZ_" \
  "Language   $LOCALE_   |   keyboard $KEYMAP_" \
  "Software   $software"
echo
# The window asks for this itself before it starts.
if [[ -n $GUI ]]; then confirm=${DECKOS_CONFIRM:-}
else confirm=$(gum input --prompt "Type ERASE to install > " --placeholder "ERASE"); fi
[[ $confirm == ERASE ]] || die "Cancelled - nothing was changed."

# ------------------------------------------------------------------ disk

section "Preparing $TARGET"
umount -R "$MNT" 2>/dev/null || true
CHANGED=partition
spin "Wiping $TARGET" wipefs -af "$TARGET"
# Mark it as a Linux partition so Windows stops offering to "format" it.
spin "Setting partition type" sfdisk --part-type "$TARGET_DISK" "$TARGET_PARTNO" "$LINUX_FS_GUID"
spin "Creating btrfs" mkfs.btrfs -f -L DeckOS "$TARGET"
mount "$TARGET" "$MNT"
for sv in @ @home @snapshots @log @pkg; do btrfs -q subvolume create "$MNT/$sv"; done
umount "$MNT"
mount -o "$BTRFS_OPTS,subvol=@" "$TARGET" "$MNT"
mkdir -p "$MNT"/{home,.snapshots,var/log,var/cache/pacman/pkg,boot/efi}
mount -o "$BTRFS_OPTS,subvol=@home" "$TARGET" "$MNT/home"
mount -o "$BTRFS_OPTS,subvol=@snapshots" "$TARGET" "$MNT/.snapshots"
mount -o "$BTRFS_OPTS,subvol=@log" "$TARGET" "$MNT/var/log"
mount -o "$BTRFS_OPTS,subvol=@pkg" "$TARGET" "$MNT/var/cache/pacman/pkg"
mount "$ESP" "$MNT/boot/efi"
good "btrfs subvolumes: @ @home @snapshots @log @pkg"

# ------------------------------------------------------------------ base system

section "Base system"
rank_mirrors

spin "Installing Arch base" pacstrap -K "$MNT" base base-devel linux-firmware amd-ucode btrfs-progs \
  gawk git sudo nano networkmanager grub efibootmgr os-prober curl jq
genfstab -U "$MNT" | sed -E 's/,subvolid=[0-9]+//; s/subvolid=[0-9]+,//' > "$MNT/etc/fstab"

ln -sf "/usr/share/zoneinfo/$TZ_" "$MNT/etc/localtime"
if [[ $WINDOWS == yes ]]; then
  # Windows keeps the hardware clock in local time; match it so the clock is right in both.
  inchroot hwclock --systohc --localtime >>"$LOG" 2>&1 || true
else
  inchroot hwclock --systohc --utc >>"$LOG" 2>&1 || true
fi
# English (US) is always generated too, as the fallback many tools expect.
sed -i "s/^#\($LOCALE_ \)/\1/; s/^#\($DEFAULT_LOCALE \)/\1/" "$MNT/etc/locale.gen"
inchroot locale-gen >>"$LOG" 2>&1
echo "LANG=$LOCALE_" > "$MNT/etc/locale.conf"
if [[ -z $(find "$MNT/usr/share/kbd/keymaps" -name "$CONSOLE_KEYMAP.map.gz" -print -quit) ]]; then
  warn "No console keymap '$CONSOLE_KEYMAP' - the text console uses US, the desktop still uses $KEYMAP_"
  CONSOLE_KEYMAP=us
fi
echo "KEYMAP=$CONSOLE_KEYMAP" > "$MNT/etc/vconsole.conf"
# The desktop's layout: xorg.conf.d for the login screen (and what localectl reports), and
# Plasma's system-wide default.
mkdir -p "$MNT/etc/X11/xorg.conf.d" "$MNT/etc/xdg"
printf 'Section "InputClass"\n  Identifier "system-keyboard"\n  MatchIsKeyboard "on"\n  Option "XkbLayout" "%s"\nEndSection\n' \
  "$KEYMAP_" > "$MNT/etc/X11/xorg.conf.d/00-keyboard.conf"
printf '[Layout]\nLayoutList=%s\nUse=true\n' "$KEYMAP_" > "$MNT/etc/xdg/kxkbrc"
echo "$HOSTNAME_" > "$MNT/etc/hostname"
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s.localdomain %s\n' "$HOSTNAME_" "$HOSTNAME_" > "$MNT/etc/hosts"
sed -i '/^#\[multilib\]/{N;s/#//g}' "$MNT/etc/pacman.conf"
sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 10/; s/^#Color/Color/' "$MNT/etc/pacman.conf"
good "language $LOCALE_, keyboard $KEYMAP_, time, hostname, multilib"

section "CachyOS optimised repos (Zen 4)"
mkdir -p "$MNT/root/cachyos-repo"
spin "Downloading CachyOS repo setup" curl -fsSL https://mirror.cachyos.org/cachyos-repo.tar.xz -o "$MNT/root/cachyos-repo/repo.tar.xz"
tar -xf "$MNT/root/cachyos-repo/repo.tar.xz" -C "$MNT/root/cachyos-repo"
spin "Adding CachyOS repos" arch-chroot "$MNT" bash -c 'cd /root/cachyos-repo/cachyos-repo && yes | ./cachyos-repo.sh'
rm -rf "$MNT/root/cachyos-repo"
grep -q '^\[cachyos-znver4\]' "$MNT/etc/pacman.conf" && good "znver4 repos enabled" || warn "znver4 repos not detected; using CachyOS generic repos"

# ------------------------------------------------------------------ software

section "Software"
for g in base desktop "${CHOSEN[@]}"; do install_group "$g"; done

section "Your account"
groups=wheel
for g in video render input audio docker gamemode lp; do
  inchroot getent group "$g" >/dev/null && groups+=",$g"
done
inchroot useradd -m -G "$groups" -s /bin/bash "$USERNAME_"
{ set +x; } 2>/dev/null
printf '%s:%s\n' "$USERNAME_" "$PASS1" | inchroot chpasswd
inchroot passwd -l root >>"$LOG" 2>&1
unset PASS1 PASS2
set -x
echo '%wheel ALL=(ALL:ALL) ALL' > "$MNT/etc/sudoers.d/10-wheel"
chmod 440 "$MNT/etc/sudoers.d/10-wheel"
good "$USERNAME_ (groups: $groups) - root login disabled, use sudo"

# Temporary passwordless sudo so makepkg/paru can install as the new user. Removed below.
echo "$USERNAME_ ALL=(ALL) NOPASSWD: ALL" > "$MNT/etc/sudoers.d/00-deckos-install"
chmod 440 "$MNT/etc/sudoers.d/00-deckos-install"

# deckos-settings and the AUR apps are prebuilt in the USB's repo (build.sh), the same builds the
# ISO was tested with. Installing those copies skips building from source mid-install; anything
# the USB doesn't have (or a USB without the repo) is built as before.
USB_PKGS=/var/cache/deckos-usb
# usb_pkg NAME - copies NAME's package from the USB into the new system; prints its path there.
usb_pkg() {
  local f
  for f in "$USB_REPO"/*.pkg.tar.zst; do
    [[ -f $f && $(bsdtar -xOf "$f" .PKGINFO 2>/dev/null | sed -n 's/^pkgname = //p') == "$1" ]] || continue
    mkdir -p "$MNT$USB_PKGS"
    cp "$f" "$MNT$USB_PKGS/"
    echo "$USB_PKGS/${f##*/}"
    return 0
  done
  return 1
}

section "DeckOS layer"
if pkgfile=$(usb_pkg deckos-settings); then
  spin "Installing deckos-settings (theme, tools, fixes)" arch-chroot "$MNT" pacman -U --needed --noconfirm "$pkgfile"
else
  build=/home/$USERNAME_/.cache/deckos
  mkdir -p "$MNT$build"
  cp -a "$SRC/pkg" "$MNT$build/"
  inchroot chown -R "$USERNAME_:$USERNAME_" "/home/$USERNAME_/.cache"
  spin "Building deckos-settings (theme, tools, fixes)" arch-chroot "$MNT" sudo -u "$USERNAME_" -H \
    bash -c "cd $build/pkg/deckos-settings && makepkg -si --noconfirm"
fi
# Extra themes, to pick in DeckOS Hub > Appearance. Optional: a USB without them is fine.
if pkgfile=$(usb_pkg deckos-theme-tmpikes); then
  if inchroot pacman -U --needed --noconfirm "$pkgfile" >>"$LOG" 2>&1; then good "TMpikes theme"
  else warn "TMpikes theme didn't install (see log)"; fi
fi

section "AUR"
mapfile -t aur < <(list_aur)
from_usb=() usb_names=() to_build=()
for p in "${aur[@]}"; do
  if f=$(usb_pkg "$p"); then from_usb+=("$f"); usb_names+=("$p"); else to_build+=("$p"); fi
done
if [[ ${#from_usb[@]} -gt 0 ]]; then
  echo "### pacman -U ${from_usb[*]}" >> "$LOG"
  if busy "Installing ${usb_names[*]} from the USB" \
       bash -c 'arch-chroot "$0" pacman -U --needed --noconfirm "${@}" >>"$LOG" 2>&1' "$MNT" "${from_usb[@]}"; then
    good "${usb_names[*]} (prebuilt on the USB)"
  else
    warn "Installing from the USB failed - building them instead"
    to_build=("${aur[@]}")
  fi
fi
for p in "${to_build[@]}"; do
  if busy "Building $p" bash -c \
       'arch-chroot "$0" sudo -u "$1" -H paru -S --needed --noconfirm --skipreview "$2" >>"$LOG" 2>&1' "$MNT" "$USERNAME_" "$p"; then
    good "$p"
  else
    warn "$p failed (see log)"; FAILED+=("$p")
  fi
done
rm -rf "${MNT:?}$USB_PKGS"

if ! chosen dev; then
  :
elif busy "Installing Claude Code" bash -c \
     'arch-chroot "$0" sudo -u "$1" -H bash -c "curl -fsSL https://claude.ai/install.sh | bash" >>"$LOG" 2>&1' "$MNT" "$USERNAME_"; then
  good "Claude Code (run: claude)"
else
  warn "Claude Code install failed - DeckOS Hub has a button to retry"; FAILED+=("claude-code")
fi
rm -f "$MNT/etc/sudoers.d/00-deckos-install"

# ------------------------------------------------------------------ drives

section "Your drives (kept as NTFS)"
uid=$(inchroot id -u "$USERNAME_"); gid=$(inchroot id -g "$USERNAME_")
block=$(bash "$DECKOS_TOOL" drives fstab --uid "$uid" --gid "$gid")
printf '\n%s\n' "$block" >> "$MNT/etc/fstab"
grep -oP '(?<=  /mnt/)\S+' <<<"$block" | while read -r m; do mkdir -p "$MNT/mnt/$m"; good "/mnt/$m"; done

# ------------------------------------------------------------------ boot

section "Boot"
sed -i -E 's/^MODULES=.*/MODULES=(amdgpu)/' "$MNT/etc/mkinitcpio.conf"
sed -i -E 's/^HOOKS=.*/HOOKS=(base udev plymouth autodetect microcode modconf kms keyboard keymap consolefont block filesystems grub-btrfs-overlayfs)/' "$MNT/etc/mkinitcpio.conf"
inchroot plymouth-set-default-theme deckos >>"$LOG" 2>&1 || warn "plymouth theme not set"
spin "Building initramfs" arch-chroot "$MNT" mkinitcpio -P

set_grub GRUB_DISTRIBUTOR '"DeckOS"'
set_grub GRUB_TIMEOUT 5
display_flags=$(bash "$DECKOS_TOOL" display flags "$DISPLAY_LEVEL")
set_grub GRUB_CMDLINE_LINUX_DEFAULT "\"$CMDLINE${display_flags:+ $display_flags}\""
set_grub GRUB_DISABLE_OS_PROBER false
set_grub GRUB_THEME '"/usr/share/grub/themes/deckos/theme.txt"'
set_grub GRUB_GFXMODE 1920x1080,auto
mkdir -p "$MNT/etc/deckos" && printf '# Managed by deckos display set\nLEVEL=%s\n' "$DISPLAY_LEVEL" > "$MNT/etc/deckos/display.conf"

# snapper wants to create /.snapshots itself; swap it for our @snapshots subvolume after.
umount "$MNT/.snapshots"; rmdir "$MNT/.snapshots"
spin "Configuring snapshots" arch-chroot "$MNT" snapper --no-dbus -c root create-config /
btrfs -q subvolume delete "$MNT/.snapshots"
mkdir "$MNT/.snapshots"
mount -o "$BTRFS_OPTS,subvol=@snapshots" "$TARGET" "$MNT/.snapshots"
chmod 750 "$MNT/.snapshots"
sed -i -E 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/; s/^NUMBER_LIMIT=.*/NUMBER_LIMIT="12"/; s/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="6"/; s/^ALLOW_GROUPS=.*/ALLOW_GROUPS="wheel"/' \
  "$MNT/etc/snapper/configs/root"

spin "Snapshot: fresh install" arch-chroot "$MNT" snapper --no-dbus -c root create -d "Fresh DeckOS install" -u important=yes
CHANGED=boot
spin "Installing GRUB to $ESP" arch-chroot "$MNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=DeckOS
spin "Writing boot menu (DeckOS, Windows, snapshots)" arch-chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg
grep -q 'Windows Boot Manager' "$MNT/boot/grub/grub.cfg" && good "Windows found for the boot menu" || warn "Windows not in the menu yet - run 'sudo grub-mkconfig -o /boot/grub/grub.cfg' after first boot"

section "Services"
services=(NetworkManager bluetooth sddm power-profiles-daemon fstrim.timer grub-btrfsd snapper-cleanup.timer
          deckos-display ananicy-cpp systemd-timesyncd)
chosen gaming && services+=(lactd)
chosen ai && services+=(ollama)
chosen dev && services+=(docker.socket)
for s in "${services[@]}"; do
  inchroot systemctl enable "$s" >>"$LOG" 2>&1 || warn "could not enable $s"
done
good "services enabled"

# Firewall: firewalld's default zone blocks incoming connections. Open only what DeckOS's own
# apps need (firewall-offline-cmd edits the config without touching the live USB's firewall).
allow=(kdeconnect)
chosen gaming && allow+=(steam-streaming)
for svc in "${allow[@]}"; do
  inchroot firewall-offline-cmd --add-service="$svc" >>"$LOG" 2>&1 || warn "firewall: couldn't open $svc"
done
if inchroot systemctl enable firewalld >>"$LOG" 2>&1; then good "firewall on (open: ${allow[*]})"
else warn "could not enable the firewall"; fi

# ------------------------------------------------------------------ done

cp "$LOG" "$MNT/var/log/deckos-install.log"
sync
umount -R "$MNT"
trap - ERR

section "DeckOS is installed"
if [[ ${#FAILED[@]} -gt 0 ]]; then
  warn "These didn't install (DeckOS still works; retry later with paru -S): ${FAILED[*]}"
fi
style --margin "1 2" --foreground "#8C94A6" \
  "Before you boot DeckOS:" \
  "  1. BIOS: Secure Boot off. DeckOS is now first in the boot order (Windows is in its menu)." \
  "  2. Windows: run 'powercfg /h off' as admin once, or your NTFS drives mount read-only." \
  "After first login:" \
  "  - DeckOS Hub (bottom panel) - display fix level, Gaming Mode, drives." \
  "  - If a screen blinks black: Hub > Display > 'Watch for blackouts', then step up a level."
[[ -z $GUI ]] && gum confirm "Reboot now?" && reboot
exit 0
